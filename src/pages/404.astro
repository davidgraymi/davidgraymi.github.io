---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
---

<Base title="Not found" noindex>
  <section class="gridlines">
    <div class="wrap flex min-h-[60vh] flex-col items-start justify-center py-20">
      <p
        class="inline-block rounded-full px-3 py-1 font-mono text-[12px] uppercase tracking-[0.16em] font-semibold"
        style="background: var(--md-sys-color-surface-container-high); color: var(--md-sys-color-primary);"
      >
        Error 404
      </p>
      <h1 class="mt-5 font-semibold tracking-tight" style="font-size: var(--text-h1); color: var(--md-sys-color-on-surface);">
        Segmentation fault (metaphorically)
      </h1>
      <p class="mt-4 max-w-lg text-[17px] leading-relaxed" style="color: var(--md-sys-color-on-surface-variant)">
        This page doesn't exist. Either I moved it, or something linked to an address that never
        did. Both are my problem, not yours.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn btn-primary">
          Back home
          <Icon name="arrow" size={16} />
        </a>
        <a href="/work" class="btn btn-ghost">Browse the work</a>
      </div>
    </div>
  </section>
</Base>
