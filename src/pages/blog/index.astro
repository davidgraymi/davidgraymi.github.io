---
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import PostCard from '~/components/PostCard.astro';
import Icon from '~/components/Icon.astro';
import CallToAction from '~/components/CallToAction.astro';

import { publishedPosts, tagCounts, tagHref } from '~/lib/blog';

const posts = await publishedPosts();
// One-off tags still get a page (linked from each post); the index lists the recurring ones.
const tags = tagCounts(posts).filter((t) => t.count > 1);
---

<Base
  title="Writing"
  description="Notes on security, real-time systems, machine learning, and the parts of engineering nobody puts in the résumé."
>
  <PageHeader
    kicker="Writing"
    title="Notes from the workbench"
    lead="Mostly about security, low-level systems, machine learning that has to survive contact with reality, and the constraints that made a decision obvious in hindsight."
  >
    <a href="/rss.xml" class="btn btn-ghost mt-8">
      <Icon name="rss" size={16} />
      Subscribe via RSS
    </a>
  </PageHeader>

  <div class="wrap py-14 md:py-20">
    {
      posts.length === 0 ? (
        <p class="text-body-lg text-on-surface-variant">
          Nothing published yet. The first post is always the hardest.
        </p>
      ) : (
        <>
          <nav aria-label="Tags" class="mb-10 flex max-w-3xl flex-wrap gap-1.5 font-mono text-label">
            {tags.map(({ tag, count }) => (
              <a href={tagHref(tag)} class="chip transition-colors hover:border-primary hover:text-primary">
                #{tag} <span class="text-on-surface-variant">{count}</span>
              </a>
            ))}
          </nav>
          <div class="ruled-list max-w-3xl">
            {posts.map((entry) => (
              <PostCard entry={entry} />
            ))}
          </div>
        </>
      )
    }
  </div>

  <CallToAction
    title="Want to talk about any of this?"
    body="Most of these posts started as a conversation. Happy to have the next one with you."
  />
</Base>
