---
import type { GetStaticPaths } from 'astro';
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import FormattedDate from '~/components/FormattedDate.astro';
import BackLink from '~/components/BackLink.astro';
import CallToAction from '~/components/CallToAction.astro';
import TableOfContents from '~/components/TableOfContents.astro';
import { site } from '~/site.config';
import { readingStats } from '~/lib/reading';
import { publishedPosts, seriesOf, tagHref } from '~/lib/blog';
// Math only renders in posts and project write-ups, so KaTeX's CSS and fonts load only here.
import 'katex/dist/katex.min.css';

export const getStaticPaths = (async () => {
  const posts = await publishedPosts();
  return posts.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, newer: posts[i - 1], older: posts[i + 1], series: seriesOf(entry, posts) },
  }));
}) satisfies GetStaticPaths;

const { entry, newer, older, series } = Astro.props;
const { Content, headings } = await render(entry);
const { title, seoTitle, description, pubDate, updatedDate, tags, cover, coverAlt } = entry.data;

// A draft project has no page to link to.
const linked = entry.data.project && (await getEntry(entry.data.project));
const project = linked && !linked.data.draft ? linked : undefined;

const { words, minutes: readingMinutes } = readingStats(entry.body);

// Short posts read fine without a map; only show one past a few sections.
const showToc = headings.filter((h) => h.depth === 2).length >= 3;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  keywords: tags.join(', '),
  wordCount: words,
  url: new URL(`/blog/${entry.id}`, Astro.site).href,
  mainEntityOfPage: new URL(`/blog/${entry.id}`, Astro.site).href,
  image: new URL(`/og/blog/${entry.id}.png`, Astro.site).href,
  author: { '@type': 'Person', name: site.name, url: site.url },
};
---

<Base title={seoTitle ?? title} description={description} type="article" image={`/og/blog/${entry.id}.png`} jsonLd={jsonLd}>
  <article>
    <header class="dot-field border-b border-outline-variant">
      <div class="wrap max-w-4xl py-14 md:py-18">
        <BackLink href="/blog" label="Writing" />

        <h1 class="mt-6 font-semibold tracking-tight text-h1 text-on-surface">{title}</h1>
        <p class="mt-4 max-w-2xl text-title-sm leading-relaxed text-on-surface-variant">{description}</p>

        <div class="ruled-panel mt-10">
          <span class="tick tick-tl" /><span class="tick tick-tr" /><span class="tick tick-bl" /><span class="tick tick-br" />
          <dl class="ruled-grid sm:grid-cols-[auto_auto_1fr]">
            <div class="ruled-cell p-5 sm:pr-10">
              <dt class="kicker">Published</dt>
              <dd class="mt-2 font-mono text-body font-medium text-on-surface">
                <FormattedDate date={pubDate} />
                {updatedDate && (
                  <span class="block text-label font-normal text-on-surface-variant">
                    updated <FormattedDate date={updatedDate} />
                  </span>
                )}
              </dd>
            </div>
            <div class="ruled-cell p-5 sm:pr-10">
              <dt class="kicker">Read</dt>
              <dd class="mt-2 font-mono text-body font-medium text-on-surface">{readingMinutes} min</dd>
            </div>
            <div class="ruled-cell p-5">
              <dt class="kicker">Tags</dt>
              <dd class="mt-2.5 flex flex-wrap gap-1.5 font-mono text-label">
                {tags.length > 0 ? tags.map((t) => <a href={tagHref(t)} class="chip transition-colors hover:border-primary hover:text-primary">#{t}</a>) : <span class="text-on-surface-variant">—</span>}
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </header>

    <div
      class:list={[
        'wrap py-12 md:py-16',
        showToc && 'xl:grid xl:grid-cols-[minmax(0,48rem)_15rem] xl:justify-center xl:gap-16',
      ]}
    >
      <div class:list={['mx-auto max-w-3xl', showToc && 'xl:mx-0 xl:max-w-none']}>
        {showToc && <TableOfContents headings={headings} variant="inline" />}

        {
          cover && (
            <Image
              src={cover}
              alt={coverAlt}
              widths={[720, 1200]}
              sizes="(min-width: 768px) 48rem, 100vw"
              class="mb-12 w-full border border-outline-variant bg-surface-container-low"
            />
          )
        }

        {
          series && (
            <nav aria-label="Series" class="mb-12 border border-l-4 border-outline-variant border-l-primary bg-surface-container-low p-5">
              <p class="kicker">
                Series · part {series.index + 1} of {series.parts.length}
              </p>
              <p class="mt-2 font-semibold text-on-surface">{series.title}</p>
              <ol class="mt-3 space-y-1.5 text-body-sm">
                {series.parts.map((part, i) => (
                  <li class="flex gap-3">
                    <span class="font-mono text-label leading-6 text-on-surface-variant">{String(i + 1).padStart(2, '0')}</span>
                    {part.id === entry.id ? (
                      <span class="font-medium text-on-surface" aria-current="page">{part.data.title}</span>
                    ) : (
                      <a href={`/blog/${part.id}`} class="link-underline text-on-surface-variant hover:text-primary">{part.data.title}</a>
                    )}
                  </li>
                ))}
              </ol>
            </nav>
          )
        }

        <div class="prose">
          <Content />
        </div>

        {
          project && (
            <aside aria-label="Project" class="mt-16 border border-l-4 border-outline-variant border-l-primary bg-surface-container-low p-5">
              <p class="kicker">The project behind this post</p>
              <p class="mt-2 font-semibold text-on-surface">
                <a href={`/work/${project.id}`} class="link-underline hover:text-primary">{project.data.title}</a>
              </p>
              <p class="mt-1.5 text-body-sm leading-relaxed text-on-surface-variant">{project.data.blurb}</p>
            </aside>
          )
        }

        {
          (newer || older) && (
            <nav class="ruled-panel mt-16" aria-label="More posts">
              <span class="tick tick-tl" /><span class="tick tick-tr" /><span class="tick tick-bl" /><span class="tick tick-br" />
              <div class="ruled-grid sm:grid-cols-2">
                {newer ? (
                  <a href={`/blog/${newer.id}`} class="ruled-cell is-interactive block p-5.5">
                    <p class="kicker">Newer</p>
                    <p class="mt-2.5 text-base font-semibold text-on-surface">{newer.data.title}</p>
                  </a>
                ) : (
                  <span class="ruled-cell hidden sm:block" />
                )}
                {older && (
                  <a href={`/blog/${older.id}`} class="ruled-cell is-interactive block p-5.5 sm:text-right">
                    <p class="kicker sm:flex-row-reverse">Older</p>
                    <p class="mt-2.5 text-base font-semibold text-on-surface">{older.data.title}</p>
                  </a>
                )}
              </div>
            </nav>
          )
        }
      </div>

      {showToc && (
        <aside class="hidden xl:block">
          <TableOfContents headings={headings} variant="rail" />
        </aside>
      )}
    </div>
  </article>

  <CallToAction
    title="Spot something I got wrong?"
    body="Corrections, follow-up questions, or a war story of your own. I read every message and reply to the ones that aren't a template."
  />
</Base>
