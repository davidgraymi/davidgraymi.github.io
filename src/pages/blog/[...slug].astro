---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import FormattedDate from '~/components/FormattedDate.astro';
import Icon from '~/components/Icon.astro';
import { site } from '~/site.config';

export const getStaticPaths = (async () => {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  return posts.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, newer: posts[i - 1], older: posts[i + 1] },
  }));
}) satisfies GetStaticPaths;

const { entry, newer, older } = Astro.props;
const { Content } = await render(entry);
const { title, description, pubDate, updatedDate, tags, cover, coverAlt } = entry.data;
---

<Base title={title} description={description} type="article">
  <article>
    <header class="border-b" style="border-color: var(--md-sys-color-outline-variant);">
      <div class="wrap max-w-3xl py-14 md:py-18">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 rounded-full border px-3 py-1 font-mono text-[11.5px] uppercase tracking-[0.12em] transition-all duration-200 hover:border-[var(--md-sys-color-primary)] hover:text-[var(--md-sys-color-primary)]"
          style="color: var(--md-sys-color-on-surface-variant); border-color: var(--md-sys-color-outline-variant); background: var(--md-sys-color-surface-container);"
        >
          <span class="rotate-180 leading-none"><Icon name="arrow" size={13} /></span>
          Writing
        </a>

        <h1 class="mt-6 font-semibold tracking-tight" style="font-size: var(--text-h1); color: var(--md-sys-color-on-surface);">{title}</h1>

        <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-[12.5px]" style="color: var(--md-sys-color-on-surface-variant)">
          <span class="rounded-full px-2.5 py-0.5 font-semibold" style="background: var(--md-sys-color-surface-container-high); color: var(--md-sys-color-primary);">
            <FormattedDate date={pubDate} />
          </span>
          {updatedDate && <span>· updated <FormattedDate date={updatedDate} /></span>}
          {
            tags.length > 0 && (
              <span class="flex flex-wrap gap-1.5 pl-2">
                {tags.map((t) => (
                  <span class="rounded-full border px-2 py-0.5 text-[11px]" style="border-color: var(--md-sys-color-outline-variant); background: var(--md-sys-color-surface-container);">
                    #{t}
                  </span>
                ))}
              </span>
            )
          }
        </div>
      </div>
    </header>

    <div class="wrap max-w-3xl py-12 md:py-16">
      {
        cover && (
          <Image
            src={cover}
            alt={coverAlt}
            widths={[720, 1200]}
            sizes="(min-width: 768px) 48rem, 100vw"
            class="mb-12 w-full overflow-hidden rounded-xl border shadow-[var(--md-sys-elevation-2)]"
            style="border-color: var(--md-sys-color-outline-variant); background: var(--md-sys-color-surface-container-low);"
          />
        )
      }

      <div class="prose">
        <Content />
      </div>

      <div class="mt-16 border-t pt-8" style="border-color: var(--md-sys-color-outline-variant);">
        <p class="text-[15px] leading-relaxed" style="color: var(--md-sys-color-on-surface-variant)">
          Thoughts, corrections, or something I got wrong? I actually want to hear it —
          <a href={`mailto:${site.email}`} class="link-underline" style="color: var(--md-sys-color-primary)">
            {site.email}
          </a>.
        </p>
      </div>

      {
        (newer || older) && (
          <nav class="mt-10 grid gap-4 border-t pt-8 sm:grid-cols-2" style="border-color: var(--md-sys-color-outline-variant);" aria-label="More posts">
            {newer ? (
              <a
                href={`/blog/${newer.id}`}
                class="spotlight-card rounded-xl p-5.5 transition-all duration-200 hover:border-[var(--md-sys-color-primary)]"
                style="background: var(--md-sys-color-surface-container-low); border-color: var(--md-sys-color-outline-variant);"
              >
                <p class="kicker">Newer</p>
                <p class="mt-2.5 text-[16px] font-semibold" style="color: var(--md-sys-color-on-surface);">{newer.data.title}</p>
              </a>
            ) : (
              <span />
            )}
            {older && (
              <a
                href={`/blog/${older.id}`}
                class="spotlight-card rounded-xl p-5.5 text-right transition-all duration-200 hover:border-[var(--md-sys-color-primary)] sm:text-right"
                style="background: var(--md-sys-color-surface-container-low); border-color: var(--md-sys-color-outline-variant);"
              >
                <p class="kicker justify-end">Older</p>
                <p class="mt-2.5 text-[16px] font-semibold" style="color: var(--md-sys-color-on-surface);">{older.data.title}</p>
              </a>
            )}
          </nav>
        )
      }
    </div>
  </article>
</Base>
