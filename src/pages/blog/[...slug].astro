---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import FormattedDate from '~/components/FormattedDate.astro';
import Icon from '~/components/Icon.astro';
import { site } from '~/site.config';

export const getStaticPaths = (async () => {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  return posts.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, newer: posts[i - 1], older: posts[i + 1] },
  }));
}) satisfies GetStaticPaths;

const { entry, newer, older } = Astro.props;
const { Content } = await render(entry);
const { title, description, pubDate, updatedDate, tags, cover, coverAlt } = entry.data;
---

<Base title={title} description={description} type="article">
  <article>
    <header class="border-b">
      <div class="wrap max-w-3xl py-14 md:py-18">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 font-mono text-[12px] uppercase tracking-[0.14em] transition-colors hover:text-[var(--signal)]"
          style="color: var(--fg-muted)"
        >
          <span class="rotate-180 leading-none"><Icon name="arrow" size={14} /></span>
          Writing
        </a>

        <h1 class="mt-6 font-semibold" style="font-size: var(--text-h1)">{title}</h1>

        <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-[12.5px]" style="color: var(--fg-muted)">
          <FormattedDate date={pubDate} />
          {updatedDate && <span>· updated <FormattedDate date={updatedDate} /></span>}
          {tags.length > 0 && <span>· {tags.map((t) => `#${t}`).join(' ')}</span>}
        </div>
      </div>
    </header>

    <div class="wrap max-w-3xl py-12 md:py-16">
      {
        cover && (
          <Image
            src={cover}
            alt={coverAlt}
            widths={[720, 1200]}
            sizes="(min-width: 768px) 48rem, 100vw"
            class="surface mb-12 w-full"
          />
        )
      }

      <div class="prose">
        <Content />
      </div>

      <div class="mt-16 border-t pt-8">
        <p class="text-[15px]" style="color: var(--fg-muted)">
          Thoughts, corrections, or something I got wrong? I actually want to hear it —
          <a href={`mailto:${site.email}`} class="link-underline" style="color: var(--fg)">
            {site.email}
          </a>.
        </p>
      </div>

      {
        (newer || older) && (
          <nav class="mt-10 grid gap-4 border-t pt-8 sm:grid-cols-2" aria-label="More posts">
            {newer ? (
              <a href={`/blog/${newer.id}`} class="surface p-5 transition-colors hover:border-[var(--signal)]">
                <p class="kicker">Newer</p>
                <p class="mt-3 text-[15px] font-medium">{newer.data.title}</p>
              </a>
            ) : (
              <span />
            )}
            {older && (
              <a href={`/blog/${older.id}`} class="surface p-5 text-right transition-colors hover:border-[var(--signal)] sm:text-right">
                <p class="kicker">Older</p>
                <p class="mt-3 text-[15px] font-medium">{older.data.title}</p>
              </a>
            )}
          </nav>
        )
      }
    </div>
  </article>
</Base>
