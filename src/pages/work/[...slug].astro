---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import BackLink from '~/components/BackLink.astro';
import CallToAction from '~/components/CallToAction.astro';
import PostCard from '~/components/PostCard.astro';
import Section from '~/components/Section.astro';
import { publishedPosts } from '~/lib/blog';
import { site } from '~/site.config';
// Math only renders in posts and project write-ups, so KaTeX's CSS and fonts load only here.
import 'katex/dist/katex.min.css';

export const getStaticPaths = (async () => {
  const entries = await getCollection('work', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, blurb, kind, year, stack, highlight, links, cover, coverAlt, product } = entry.data;
// Posts that name this project in their `project:` frontmatter.
const posts = (await publishedPosts()).filter((p) => p.data.project?.id === entry.id);

const jsonLd = product && {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: title,
  description: blurb,
  url: product.url,
  applicationCategory: product.applicationCategory,
  operatingSystem: 'Web browser',
  ...(product.audience && { audience: { '@type': 'BusinessAudience', name: product.audience } }),
  ...(product.featureList.length > 0 && { featureList: product.featureList }),
  ...(product.price && {
    offers: {
      '@type': 'Offer',
      price: product.price,
      priceCurrency: 'USD',
      ...(product.priceUnit && { description: product.priceUnit }),
    },
  }),
  author: { '@type': 'Person', name: site.name, url: site.url },
  subjectOf: { '@type': 'WebPage', url: new URL(`/work/${entry.id}`, site.url).href },
};
---

<Base title={title} description={blurb} type="article" image={`/og/work/${entry.id}.png`} jsonLd={jsonLd || undefined}>
  <article>
    <header>
      <div class="wrap py-14 md:py-20">
        <BackLink href="/work" label="All work" />

        <h1 class="mt-6 max-w-3xl font-semibold tracking-[-0.03em] text-h1 text-on-surface">{title}</h1>
        <p class="mt-4 max-w-2xl text-title-sm leading-relaxed text-on-surface-variant">{blurb}</p>

        <div class="ruled-panel is-instrument mt-10">
          <span class="tick tick-tl" /><span class="tick tick-tr" /><span class="tick tick-bl" /><span class="tick tick-br" />
          <dl class="ruled-grid sm:grid-cols-3">
            <div class="ruled-cell p-5">
              <dt class="meta-label">Type</dt>
              <dd class="mt-1 text-body font-medium text-on-surface">{kind}</dd>
            </div>
            <div class="ruled-cell p-5">
              <dt class="meta-label">Year</dt>
              <dd class="mt-1 text-body font-medium tabular-nums text-on-surface">{year}</dd>
            </div>
            <div class="ruled-cell p-5">
              <dt class="meta-label">Built with</dt>
              <dd class="mt-1 text-body-sm font-medium text-on-surface">{stack.join(' · ')}</dd>
            </div>
          </dl>
        </div>

        {
          links.length > 0 && (
            <div class="mt-8 flex flex-wrap gap-3">
              {links.map((link, i) => (
                <a
                  href={link.href}
                  class:list={['btn', i === 0 ? 'btn-primary' : 'btn-ghost']}
                  rel={link.href.startsWith('http') ? 'noopener' : undefined}
                >
                  {link.label}
                  <Icon name={link.href.startsWith('http') ? 'arrowUpRight' : 'arrow'} size={16} />
                </a>
              ))}
            </div>
          )
        }
      </div>
    </header>

    {
      cover && (
        <div class="wrap pt-12 md:pt-16">
          <Image
            src={cover}
            alt={coverAlt}
            widths={[720, 1200, 1600]}
            sizes="(min-width: 1024px) 72rem, 100vw"
            class="w-full overflow-hidden border border-outline-variant bg-surface-container-low"
          />
        </div>
      )
    }

    <div class="wrap py-14 md:py-20">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,42rem)_1fr] lg:gap-16">
        <div class="prose">
          <Content />
        </div>

        {
          highlight && (
            <aside class="lg:pt-2">
              <div class="ruled-panel dot-reveal p-6 lg:sticky lg:top-28">
                <span class="tick tick-tl" /><span class="tick tick-tr" /><span class="tick tick-bl" /><span class="tick tick-br" />
                <p class="kicker">The key metric</p>
                <p class="mt-3 text-[1.25rem] font-semibold leading-snug tracking-[-0.015em] text-on-surface">{highlight}</p>
              </div>
            </aside>
          )
        }
      </div>
    </div>
  </article>

  {
    posts.length > 0 && (
      <Section kicker="Writing" title="More on this project" alt>
        <div class="ruled-list mt-10">
          {posts.map((post) => (
            <PostCard entry={post} />
          ))}
        </div>
      </Section>
    )
  }

  <CallToAction />
</Base>
