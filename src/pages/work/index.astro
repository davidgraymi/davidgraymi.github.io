---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import WorkCard from '~/components/WorkCard.astro';
import CallToAction from '~/components/CallToAction.astro';
import Icon from '~/components/Icon.astro';

const entries = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return a.data.order - b.data.order;
});
---

<Base
  title="Work"
  description="Real-time embedded systems, applied machine learning, and side projects that got out of hand."
>
  <PageHeader
    kicker="Portfolio"
    title="Things I've built, and what each one taught me"
    lead="Production defense software I can only describe in outline, research projects with the numbers attached, and side projects I built because something annoyed me. Sorted by how much I want you to read them."
  />

  <div class="wrap py-12 md:py-16">
    {/* Interactive Filter Pills */}
    <div class="flex flex-wrap items-center justify-between gap-4 border-b pb-8" style="border-color: var(--rule);">
      <div id="filter-tabs" class="flex flex-wrap items-center gap-2">
        <button
          type="button"
          data-filter="all"
          class="filter-tab active rounded-full px-4 py-1.5 font-mono text-[12.5px] font-medium transition-all"
        >
          All ({entries.length})
        </button>
        <button
          type="button"
          data-filter="embedded"
          class="filter-tab rounded-full px-4 py-1.5 font-mono text-[12.5px] font-medium transition-all"
        >
          Embedded & Real-Time
        </button>
        <button
          type="button"
          data-filter="ai"
          class="filter-tab rounded-full px-4 py-1.5 font-mono text-[12.5px] font-medium transition-all"
        >
          Applied AI / ML
        </button>
        <button
          type="button"
          data-filter="tools"
          class="filter-tab rounded-full px-4 py-1.5 font-mono text-[12.5px] font-medium transition-all"
        >
          Tools & Apps
        </button>
      </div>

      <a href="/wordlet" class="inline-flex items-center gap-1.5 font-mono text-[12.5px] transition-colors hover:text-[var(--signal)]" style="color: var(--fg-muted)">
        <span>Launch Wordlet</span>
        <Icon name="arrowUpRight" size={14} />
      </a>
    </div>

    {/* Project Cards Grid */}
    <div id="projects-grid" class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {entries.map((entry) => <WorkCard entry={entry} />)}
    </div>

    <div id="no-projects" class="hidden py-16 text-center text-[15px]" style="color: var(--fg-muted)">
      No projects match this category.
    </div>
  </div>

  <CallToAction
    title="Want the version with more detail?"
    body="A lot of the best work is easier to explain out loud than in writing. Ask me about any of it."
  />
</Base>

<style>
  .filter-tab {
    background: var(--bg-surface);
    border: 1px solid var(--rule);
    color: var(--fg-muted);
  }

  .filter-tab:hover {
    border-color: var(--rule-strong);
    color: var(--fg);
  }

  .filter-tab.active {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--signal-contrast);
    box-shadow: 0 0 15px -3px var(--signal-glow);
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
  const cards = document.querySelectorAll<HTMLElement>('#projects-grid article');
  const emptyState = document.getElementById('no-projects');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');

      const filter = tab.dataset.filter;
      let visibleCount = 0;

      cards.forEach((card) => {
        const cat = card.dataset.category;
        const match = filter === 'all' || cat === filter;
        card.style.display = match ? 'flex' : 'none';
        if (match) visibleCount++;
      });

      if (emptyState) {
        emptyState.classList.toggle('hidden', visibleCount > 0);
      }
    });
  });
</script>
