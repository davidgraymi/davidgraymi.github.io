---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import WorkCard from '~/components/WorkCard.astro';
import CallToAction from '~/components/CallToAction.astro';
import Icon from '~/components/Icon.astro';

const all = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return a.data.order - b.data.order;
});
const entries = all.filter((e) => !e.data.archived);
const archive = all.filter((e) => e.data.archived).sort((a, b) => b.data.year.localeCompare(a.data.year));

const filters = [
  { key: 'security', label: 'Security & Cloud' },
  { key: 'embedded', label: 'Embedded & Real-Time' },
  { key: 'ai', label: 'Applied AI / ML' },
  { key: 'tools', label: 'Tools & Apps' },
].filter((f) => entries.some((e) => e.data.category === f.key));
---

<Base
  title="Work"
  description="Cloud and product security, real-time embedded systems, applied machine learning, and side projects that got out of hand."
>
  <PageHeader
    kicker="Portfolio"
    title="Things I've built, and what each one taught me"
    lead="Production security and defense work I can only describe in outline, research projects with the numbers attached, and side projects I built because something annoyed me. Sorted by how much I want you to read them."
  />

  <div class="wrap py-12 md:py-16">
    {/* Filter pills */}
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div id="filter-tabs" class="flex flex-wrap items-center gap-2">
        <button
          type="button"
          data-filter="all"
          class="filter-tab active"
        >
          All ({entries.length})
        </button>
        {
          filters.map((f) => (
            <button type="button" data-filter={f.key} class="filter-tab">
              {f.label}
            </button>
          ))
        }
      </div>

      <a href="/wordlet" class="btn btn-ghost">
        Launch Wordlet
        <Icon name="arrowUpRight" size={16} />
      </a>
    </div>

    {/* Projects: ruled panel of cells */}
    <div class="ruled-panel mt-10">
      <span class="tick tick-tl" /><span class="tick tick-tr" /><span class="tick tick-bl" /><span class="tick tick-br" />
      <div id="projects-grid" class="ruled-grid md:grid-cols-2 lg:grid-cols-3">
        {entries.map((entry) => <WorkCard entry={entry} />)}
      </div>
    </div>

    <div id="no-projects" class="hidden py-16 text-center text-body text-on-surface-variant">
      No projects match this category.
    </div>

    {
      archive.length > 0 && (
        <section id="archive" class="mt-20" aria-labelledby="archive-title">
          <p class="kicker">Archive</p>
          <h2 id="archive-title" class="mt-4 text-headline-sm font-semibold text-on-surface">
            Coursework from undergrad
          </h2>
          <p class="mt-3 max-w-2xl text-body text-on-surface-variant">
            Where I learned the basics properly. Kept because the code and reports are still
            downloadable, not because they're the best thing here.
          </p>
          <ul class="ruled-list mt-8">
            {archive.map((entry) => (
              <li data-category={entry.data.category} class="archive-row">
                <a
                  href={`/work/${entry.id}`}
                  class="group grid gap-x-6 gap-y-1 py-4 sm:grid-cols-[4rem_1fr_auto] sm:items-baseline"
                >
                  <span class="font-mono text-label text-on-surface-variant">{entry.data.year}</span>
                  <span>
                    <span class="font-semibold text-on-surface transition-colors group-hover:text-primary">
                      {entry.data.title}
                    </span>
                    <span class="block text-body-sm text-on-surface-variant">{entry.data.blurb}</span>
                  </span>
                  <span class="font-mono text-label text-on-surface-variant">
                    {entry.data.stack.slice(0, 2).join(' · ')}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>

  <CallToAction
    title="Want the version with more detail?"
    body="A lot of the best work is easier to explain out loud than in writing. Ask me about any of it."
  />
</Base>

<script>
  const filterTabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
  const projectCards = document.querySelectorAll<HTMLElement>('#projects-grid article, #archive .archive-row');
  const noProjects = document.getElementById('no-projects');

  filterTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      filterTabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');

      const filter = tab.dataset.filter ?? 'all';
      let visibleCount = 0;

      projectCards.forEach((card) => {
        const category = card.dataset.category ?? '';
        const match = filter === 'all' || category === filter;
        card.style.display = match ? '' : 'none';
        if (match) visibleCount++;
      });

      if (noProjects) {
        noProjects.classList.toggle('hidden', visibleCount > 0);
      }

      // The archive heading only makes sense when at least one of its rows is showing.
      const archive = document.getElementById('archive');
      if (archive) {
        const rows = [...archive.querySelectorAll<HTMLElement>('.archive-row')];
        archive.hidden = rows.every((row) => row.style.display === 'none');
      }
    });
  });
</script>
