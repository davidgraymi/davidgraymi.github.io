---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Section from '~/components/Section.astro';
import WorkCard from '~/components/WorkCard.astro';
import PostCard from '~/components/PostCard.astro';
import CallToAction from '~/components/CallToAction.astro';
import Icon from '~/components/Icon.astro';
import { site, socials } from '~/site.config';
import { services, stats } from '~/data/resume';
import avatar from '~/assets/avatar.png';

const featured = (await getCollection('work', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Base>
  {/* ---------------------------------------------------------------- hero */}
  <section class="gridlines relative overflow-hidden border-b" style="border-color: var(--md-sys-color-outline-variant);">
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-px"
      style="background: linear-gradient(90deg, transparent 5%, color-mix(in srgb, var(--md-sys-color-primary) 50%, transparent) 50%, transparent 95%); opacity: 0.8"
    >
    </div>

    <div class="wrap py-10 sm:py-14 md:py-18 lg:py-22">
      <div class="grid items-start gap-8 lg:grid-cols-[minmax(19rem,0.85fr)_minmax(0,1.15fr)] lg:gap-16">
        {/* Avatar: Precision Instrument Frame */}
        <div class="relative order-1 w-36 sm:w-48 lg:w-full">
          <div
            class="absolute -inset-2 rounded-2xl border opacity-60 sm:-inset-2.5 sm:rounded-[1.25rem] lg:-inset-3 lg:rounded-[1.5rem]"
            style="border-color: var(--md-sys-color-primary); box-shadow: 0 0 35px -6px var(--signal-glow);"
          />
          <div
            class="relative overflow-hidden rounded-xl border sm:rounded-[1.1rem] lg:rounded-[1.35rem]"
            style="border-color: var(--md-sys-color-outline-variant); background: var(--md-sys-color-surface-container-low);"
          >
            <Image
              src={avatar}
              alt="David Gray"
              widths={[480, 720, 960]}
              sizes="(min-width: 1024px) 38vw, 22rem"
              class="aspect-[4/5] w-full object-cover object-top transition-transform duration-500 ease-out hover:scale-105"
              loading="eager"
            />
            <div
              class="absolute inset-x-0 bottom-0 hidden items-center justify-between gap-3 px-5 py-4 font-mono text-[12px] backdrop-blur-xl sm:flex"
              style="background: color-mix(in srgb, var(--md-sys-color-surface-container-highest) 82%, transparent); color: var(--md-sys-color-on-surface); border-top: 1px solid var(--md-sys-color-outline-variant);"
            >
              <span>{site.location}</span>
              <span class="rounded-md px-2.5 py-0.5 font-semibold font-mono text-[12px]" style="background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container);">
                M.S. CS @ UIUC
              </span>
            </div>
          </div>
        </div>

        {/* Hero Copy & Controls */}
        <div class="order-2">
          <div class="inline-flex items-center gap-2 rounded-lg border px-3 py-1 font-mono text-[12px] uppercase tracking-wider font-semibold" style="background: var(--md-sys-color-surface-container-high); border-color: var(--md-sys-color-outline-variant); color: var(--md-sys-color-primary);">
            <span class="h-1.5 w-1.5 rounded-full" style="background: var(--md-sys-color-primary); box-shadow: 0 0 8px var(--md-sys-color-primary);" />
            <span>Product Security & Cloud Systems</span>
          </div>

          <h1 class="mt-4 max-w-3xl font-semibold leading-[1.04] tracking-tight text-[1.85rem] sm:text-[2.6rem] md:text-[3.4rem] lg:text-[4.25rem]" style="color: var(--md-sys-color-on-surface);">
            Engineer. Scientist.<br /><span class="shimmer-text">Occasionally underwater.</span>
          </h1>

          <p class="mt-4 max-w-2xl text-[15px] leading-relaxed sm:mt-5 sm:text-[17px] md:mt-6 md:text-[19px]" style="color: var(--md-sys-color-on-surface-variant)">
            <strong class="font-semibold" style="color: var(--md-sys-color-on-surface)">I'm a product security engineer in St. Louis, securing Kubernetes and Azure delivery from threat model to release.</strong>{' '}
            Alongside it, I work on machine learning, a document platform nobody asked me to
            build, and a master's degree at the University of Illinois.
          </p>
          <p class="mt-3.5 max-w-xl text-[14px] leading-relaxed sm:text-[15px]" style="color: var(--md-sys-color-on-surface-variant)">
            Outside of that: scuba diving, rock climbing, hiking, and making things that aren't
            software. I like problems where the consequences are real.
          </p>

          {/* Action Button Row */}
          <div class="mt-7 flex flex-wrap items-center gap-2.5 sm:mt-9 sm:gap-3.5">
            <a href="/work" class="btn btn-primary">
              See my work
              <Icon name="arrow" size={15} />
            </a>
            <a href="/contact" class="btn btn-ghost">
              Get in touch
            </a>
          </div>

          {/* Social Links: Chips */}
          <ul class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-1 font-mono text-[13px] sm:mt-7">
            {
              socials.slice(0, 3).map((s) => (
                <li>
                  <a
                    href={s.href}
                    class="inline-flex min-h-10 items-center gap-2 transition-colors hover:text-[var(--md-sys-color-primary)]"
                    style="color: var(--md-sys-color-on-surface-variant)"
                    rel={s.href.startsWith('http') ? 'me noopener' : undefined}
                  >
                    <Icon name={s.icon} size={14} />
                    {s.handle}
                  </a>
                </li>
              ))
            }
          </ul>

          {site.availableForWork && (
            <p class="mt-3 inline-flex items-center gap-2 text-[14px]" style="color: var(--md-sys-color-on-surface-variant);">
              <span class="h-2 w-2 rounded-full" style="background: var(--md-sys-color-primary); box-shadow: 0 0 8px var(--md-sys-color-primary);" />
              {site.availabilityNote}
            </p>
          )}
        </div>
      </div>

      {/* Stats Cards: Precision Blocks */}
      <div class="mt-16 grid grid-cols-2 gap-4 border-t pt-10 sm:grid-cols-2 md:grid-cols-4 md:gap-5" style="border-color: var(--md-sys-color-outline-variant);">
        {
          stats.map((stat) => (
            <div
              class="rounded-xl border p-5 transition-transform duration-200 hover:-translate-y-0.5"
              style="background: var(--md-sys-color-surface-container-low); border-color: var(--md-sys-color-outline-variant); box-shadow: var(--md-sys-elevation-1);"
            >
              <p class="font-mono text-[28px] font-bold tracking-tight md:text-[32px]" style="color: var(--md-sys-color-primary)">
                {stat.value}
              </p>
              <p class="mt-1 text-[13.5px] leading-snug font-medium" style="color: var(--md-sys-color-on-surface-variant)">
                {stat.label}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ services */}
  <Section
    kicker="How I can help"
    title="The kinds of problem I'm good at"
    lead="Everything below is work I do now, not work I did once. If your problem looks like one of these, we should talk."
    alt
  >
    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        services.map((service, i) => (
          <div class="spotlight-card flex flex-col justify-between p-7 md:p-8">
            <div>
              <span
                class="inline-flex items-center justify-center rounded-xl border px-3 py-1 font-mono text-[12.5px] font-semibold"
                style="background: var(--md-sys-color-secondary-container); border-color: transparent; color: var(--md-sys-color-on-secondary-container);"
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-5 text-[20px] font-semibold leading-snug" style="color: var(--md-sys-color-on-surface);">{service.title}</h3>
              <p class="mt-3 text-[14.5px] leading-relaxed" style="color: var(--md-sys-color-on-surface-variant)">
                {service.body}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  {/* ---------------------------------------------------------------- work */}
  <Section
    kicker="Selected work"
    title="A few things worth showing"
    lead="Some of it shipped to production on hardware I'll never see again. Some of it is a side project my wife asked for. Both taught me something."
  >
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {featured.map((entry) => <WorkCard entry={entry} />)}
    </div>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a href="/work" class="btn btn-ghost">
        All projects
        <Icon name="arrow" size={16} />
      </a>
      <a href="/wordlet" class="btn btn-tonal font-mono text-[13px]">
        Play Wordlet in browser →
      </a>
    </div>
  </Section>

  {/* ------------------------------------------------------------- writing */}
  {
    posts.length > 0 && (
      <Section kicker="Writing" title="Notes from the workbench" alt>
        <div class="mt-10 flex flex-col gap-3">
          {posts.map((entry) => (
            <PostCard entry={entry} />
          ))}
        </div>
        <a href="/blog" class="btn btn-ghost mt-10">
          All posts
          <Icon name="arrow" size={16} />
        </a>
      </Section>
    )
  }

  <CallToAction />
</Base>
