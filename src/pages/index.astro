---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Section from '~/components/Section.astro';
import WorkCard from '~/components/WorkCard.astro';
import PostCard from '~/components/PostCard.astro';
import CallToAction from '~/components/CallToAction.astro';
import Icon from '~/components/Icon.astro';
import { site, socials } from '~/site.config';
import { services, stats } from '~/data/resume';
import avatar from '~/assets/avatar.png';

const featured = (await getCollection('work', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Base>
  {/* ---------------------------------------------------------------- hero */}
  <section class="gridlines relative overflow-hidden border-b" style="border-color: var(--rule);">
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-px"
      style="background: linear-gradient(90deg, transparent 5%, color-mix(in srgb, var(--signal) 50%, transparent) 50%, transparent 95%); opacity: 0.8"
    >
    </div>

    <div class="wrap py-8 sm:py-10 md:py-16 lg:py-20">
      <div class="grid items-start gap-8 lg:grid-cols-[minmax(19rem,0.8fr)_minmax(0,1.2fr)] lg:gap-16">
        <div class="relative order-1 mx-auto w-full max-w-[18rem] sm:max-w-[22rem] lg:mx-0 lg:max-w-none">
          <div class="absolute -inset-1.5 rounded-[1rem] border opacity-60 sm:-inset-2.5 sm:rounded-[1.5rem] lg:-inset-3 lg:rounded-[2rem]" style="border-color: var(--signal);" />
          <div class="relative overflow-hidden rounded-[0.9rem] border sm:rounded-[1.35rem] lg:rounded-[1.75rem]" style="border-color: var(--rule-strong); background: var(--bg-surface);">
            <Image
              src={avatar}
              alt="David Gray"
              widths={[480, 720, 960]}
              sizes="(min-width: 1024px) 38vw, 22rem"
              class="aspect-[4/5] w-full object-cover object-top"
              loading="eager"
            />
            <div class="absolute inset-x-0 bottom-0 hidden items-center justify-between gap-3 bg-black/55 px-4.5 py-3.5 font-mono text-[11.5px] text-white backdrop-blur-md sm:flex">
              <span>{site.location}</span>
              <span class="whitespace-nowrap" style="color: #fbbf24">M.S. CS @ UIUC</span>
            </div>
          </div>
        </div>

        <div class="order-2">
          <h1 class="max-w-3xl font-semibold leading-[1.02] tracking-tight text-[1.35rem] sm:text-[2.2rem] md:text-[3.1rem] lg:mt-6 lg:text-[length:var(--text-display)]">
            Engineer. Scientist.<br /><span class="shimmer-text">Occasionally underwater.</span>
          </h1>
          <p class="mt-3 max-w-2xl text-[11px] leading-[1.45] sm:mt-5 sm:text-[14px] md:mt-7 md:text-[18px] md:leading-relaxed lg:text-[20px]" style="color: var(--fg-muted)">
            I'm a product security engineer in St. Louis. I spend my working hours on Kubernetes,
            Azure, and cloud infrastructure, and the rest of my brain on machine learning, a document
            platform nobody asked me to build, and a master's degree at the University of Illinois.
          </p>
          <p class="mt-3 max-w-xl text-[10px] leading-[1.45] sm:mt-4 sm:text-[12px] md:mt-5 md:text-[15px] md:leading-relaxed" style="color: var(--fg-muted)">
            Outside of that: scuba diving, rock climbing, hiking, and making things that aren't
            software. I like problems where the consequences are real.
          </p>

          <div class="mt-4 flex flex-wrap items-center gap-1.5 sm:mt-6 sm:gap-2.5 md:mt-9 md:gap-3.5">
            <a href="/work" class="btn h-8 px-2 text-[10px] sm:h-9 sm:px-3 sm:text-[12px] md:h-[2.875rem] md:px-5 md:text-[15px]">
              See my work
              <Icon name="arrow" size={13} />
            </a>
            <a href="/contact" class="btn btn-ghost h-8 px-2 text-[10px] sm:h-9 sm:px-3 sm:text-[12px] md:h-[2.875rem] md:px-5 md:text-[15px]">
              Get in touch
            </a>
            <button
              type="button"
              onclick="if(window.openCommandPalette) window.openCommandPalette()"
              class="btn btn-ghost h-8 px-2 font-mono text-[10px] sm:h-9 sm:px-3 sm:text-[12px] md:h-[2.875rem] md:px-4 md:text-[13px]"
              title="Open Command Menu (⌘K)"
            >
              <Icon name="globe" size={13} />
              <span>⌘K</span>
            </button>
          </div>

          <ul class="mt-4 flex flex-wrap items-center gap-x-2.5 gap-y-1.5 sm:mt-6 sm:gap-x-4 sm:gap-y-2 md:mt-8 md:gap-x-6 md:gap-y-3">
            {
              socials.slice(0, 3).map((s) => (
                <li>
                  <a
                    href={s.href}
                    class="inline-flex items-center gap-1 font-mono text-[8px] transition-colors hover:text-[var(--signal)] sm:gap-1.5 sm:text-[10px] md:gap-2 md:text-[12.5px]"
                    style="color: var(--fg-muted)"
                    rel={s.href.startsWith('http') ? 'me noopener' : undefined}
                  >
                    <Icon name={s.icon} size={12} />
                    {s.handle}
                  </a>
                </li>
              ))
            }
          </ul>

          {site.availableForWork && (
            <p class="mt-4 inline-flex items-center gap-1.5 font-mono text-[7px] uppercase tracking-[0.08em] sm:mt-6 sm:gap-2 sm:text-[9px] sm:tracking-[0.1em] md:mt-8 md:text-[11px] md:tracking-[0.12em]" style="color: var(--signal)">
              <span class="h-1.5 w-1.5 rounded-full sm:h-2 sm:w-2" style="background: var(--signal); box-shadow: 0 0 14px var(--signal-glow);" />
              {site.availabilityNote}
            </p>
          )}
        </div>
      </div>

      <div class="mt-16 grid grid-cols-2 gap-3.5 border-t pt-8 md:grid-cols-4 md:gap-4" style="border-color: var(--rule);">
        {
          stats.map((stat) => (
            <div>
              <p class="font-mono text-[25px] font-bold tracking-tight md:text-[28px]" style="color: var(--signal)">
                {stat.value}
              </p>
              <p class="mt-1.5 text-[13px] leading-snug" style="color: var(--fg-muted)">
                {stat.label}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ services */}
  <Section
    kicker="How I can help"
    title="Three kinds of problem I'm genuinely good at"
    lead="Everything below is work I do now, not work I did once. If your problem looks like one of these, we should talk."
    alt
  >
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {
        services.map((service, i) => (
          <div class="spotlight-card flex flex-col justify-between p-7 md:p-8">
            <div>
              <span
                class="inline-flex items-center justify-center rounded-lg border px-2.5 py-1 font-mono text-[12px] font-medium"
                style="background: var(--bg-surface-2); border-color: var(--rule); color: var(--signal);"
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-5 text-[19px] font-semibold leading-snug">{service.title}</h3>
              <p class="mt-3 text-[14.5px] leading-relaxed" style="color: var(--fg-muted)">
                {service.body}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  {/* ---------------------------------------------------------------- work */}
  <Section
    kicker="Selected work"
    title="A few things worth showing"
    lead="Some of it shipped to production on hardware I'll never see again. Some of it is a side project my wife asked for. Both taught me something."
  >
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {featured.map((entry) => <WorkCard entry={entry} />)}
    </div>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a href="/work" class="btn btn-ghost">
        All projects
        <Icon name="arrow" size={16} />
      </a>
      <a href="/wordlet" class="btn btn-ghost font-mono text-[13px]">
        Play Wordlet in browser →
      </a>
    </div>
  </Section>

  {/* ------------------------------------------------------------- writing */}
  {
    posts.length > 0 && (
      <Section kicker="Writing" title="Notes from the workbench" alt>
        <div class="mt-10 flex flex-col gap-2">
          {posts.map((entry) => (
            <PostCard entry={entry} />
          ))}
        </div>
        <a href="/blog" class="btn btn-ghost mt-10">
          All posts
          <Icon name="arrow" size={16} />
        </a>
      </Section>
    )
  }

  <CallToAction />
</Base>
