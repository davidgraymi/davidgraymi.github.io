---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Section from '~/components/Section.astro';
import WorkCard from '~/components/WorkCard.astro';
import PostCard from '~/components/PostCard.astro';
import CallToAction from '~/components/CallToAction.astro';
import Icon from '~/components/Icon.astro';
import { site, socials } from '~/site.config';
import { services, stats } from '~/data/resume';
import avatar from '~/assets/avatar.jpeg';

const featured = (await getCollection('work', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Base>
  {/* ---------------------------------------------------------------- hero */}
  <section class="gridlines relative overflow-hidden border-b">
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-px"
      style="background: linear-gradient(90deg, transparent, var(--signal), transparent); opacity: 0.6"
    >
    </div>

    <div class="wrap py-20 md:py-28">
      {
        site.availableForWork && (
          <p class="inline-flex items-center gap-2.5 rounded-full border px-3 py-1.5 font-mono text-[11.5px] uppercase tracking-[0.12em]" style="background: var(--bg-surface)">
            <span class="relative flex h-1.5 w-1.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full opacity-70" style="background: var(--signal)" />
              <span class="relative inline-flex h-1.5 w-1.5 rounded-full" style="background: var(--signal)" />
            </span>
            {site.availabilityNote}
          </p>
        )
      }

      <h1 class="mt-8 max-w-4xl font-semibold leading-[1.02]" style="font-size: var(--text-display)">
        I build software for <span style="color: var(--signal)">systems that can't fail.</span>
      </h1>

      <p class="mt-7 max-w-2xl text-[18px] leading-relaxed md:text-[19.5px]" style="color: var(--fg-muted)">
        Four years of real-time embedded engineering at Boeing — kernels, schedulers, anti-tamper,
        code that ships once and has to be right. Plus a second life in applied machine learning,
        and a master's at Illinois to make it rigorous.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href="/contact" class="btn btn-primary">
          Hire me
          <Icon name="arrow" size={17} />
        </a>
        <a href="/work" class="btn btn-ghost">See the work</a>
      </div>

      <ul class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3">
        {
          socials.slice(0, 3).map((s) => (
            <li>
              <a
                href={s.href}
                class="inline-flex items-center gap-2 font-mono text-[12.5px] transition-colors hover:text-[var(--signal)]"
                style="color: var(--fg-muted)"
                rel={s.href.startsWith('http') ? 'me noopener' : undefined}
              >
                <Icon name={s.icon} size={15} />
                {s.handle}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {/* telemetry strip */}
    <div class="border-t" style="background: var(--bg-surface)">
      <div class="wrap grid grid-cols-2 md:grid-cols-4">
        {
          stats.map((stat, i) => (
            <div
              class:list={[
                'py-6 pr-5 md:py-7',
                i % 2 === 1 && 'border-l pl-5',
                i >= 2 && 'border-t pt-6',
                'md:border-t-0 md:pt-7',
                i >= 1 && 'md:border-l md:pl-5',
              ]}
            >
              <p class="font-mono text-[24px] font-semibold md:text-[27px]" style="color: var(--signal)">
                {stat.value}
              </p>
              <p class="mt-1 text-[13px] leading-snug" style="color: var(--fg-muted)">
                {stat.label}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ services */}
  <Section
    kicker="How I can help"
    title="Three kinds of problem I'm genuinely good at"
    lead="Everything below is work I do now, not work I did once. If your problem looks like one of these, we should talk."
  >
    <div class="mt-12 grid gap-px overflow-hidden rounded-[var(--radius-card)] border md:grid-cols-3" style="background: var(--rule)">
      {
        services.map((service, i) => (
          <div class="p-7" style="background: var(--bg)">
            <p class="font-mono text-[12px]" style="color: var(--signal)">
              {String(i + 1).padStart(2, '0')}
            </p>
            <h3 class="mt-4 text-[18px] font-semibold">{service.title}</h3>
            <p class="mt-3 text-[14.5px] leading-relaxed" style="color: var(--fg-muted)">
              {service.body}
            </p>
          </div>
        ))
      }
    </div>
  </Section>

  {/* ---------------------------------------------------------------- work */}
  <Section
    kicker="Selected work"
    title="A few things worth showing"
    lead="Some of it shipped to production on hardware I'll never see again. Some of it is a side project my wife asked for. Both taught me something."
    alt
  >
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {featured.map((entry) => <WorkCard entry={entry} />)}
    </div>
    <a href="/work" class="btn btn-ghost mt-10">
      All projects
      <Icon name="arrow" size={16} />
    </a>
  </Section>

  {/* --------------------------------------------------------------- about */}
  <Section kicker="Who you'd be working with">
    <div class="mt-12 grid items-start gap-10 md:grid-cols-[minmax(0,20rem)_1fr] md:gap-14">
      <div class="surface mx-auto w-full max-w-xs overflow-hidden md:mx-0 md:max-w-none">
        <Image
          src={avatar}
          alt="David Gray"
          widths={[320, 640]}
          sizes="(min-width: 768px) 20rem, 18rem"
          class="aspect-square w-full object-cover"
          loading="lazy"
        />
        <div class="flex items-center justify-between gap-3 border-t px-4 py-3 font-mono text-[11.5px]" style="color: var(--fg-muted)">
          <span>{site.location}</span>
          <span>M.S. CS @ UIUC</span>
        </div>
      </div>

      <div>
        <h2 class="font-semibold" style="font-size: var(--text-h2)">
          Engineer. Scientist.<br />Occasionally underwater.
        </h2>
        <div class="mt-6 space-y-5 text-[17px] leading-relaxed" style="color: var(--fg-muted)">
          <p>
            I'm a software engineer in St. Louis. I spend my working hours on real-time embedded
            systems at Boeing and the rest of my brain on machine learning, a document platform
            nobody asked me to build, and a master's degree at the University of Illinois.
          </p>
          <p>
            Outside of that: scuba diving, rock climbing, hiking, and making things that aren't
            software. I'm told the common thread is that I like problems where the consequences
            are real.
          </p>
        </div>
        <a href="/about" class="link-underline mt-6 inline-flex items-center gap-2 font-medium" style="color: var(--fg)">
          More about me
          <Icon name="arrow" size={16} />
        </a>
      </div>
    </div>
  </Section>

  {/* ------------------------------------------------------------- writing */}
  {
    posts.length > 0 && (
      <Section kicker="Writing" title="Notes from the workbench" alt>
        <div class="mt-10 border-b">
          {posts.map((entry) => (
            <PostCard entry={entry} />
          ))}
        </div>
        <a href="/blog" class="btn btn-ghost mt-10">
          All posts
          <Icon name="arrow" size={16} />
        </a>
      </Section>
    )
  }

  <CallToAction />
</Base>
