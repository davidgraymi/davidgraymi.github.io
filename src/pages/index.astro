---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Section from '~/components/Section.astro';
import WorkCard from '~/components/WorkCard.astro';
import PostCard from '~/components/PostCard.astro';
import CallToAction from '~/components/CallToAction.astro';
import Icon from '~/components/Icon.astro';
import { site, socials } from '~/site.config';
import { offTheClock, services, stats } from '~/data/resume';
import avatar from '~/assets/avatar.png';
import { personSchema, websiteSchema } from '~/lib/schema';

const featured = (await getCollection('work', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Base jsonLd={[websiteSchema, personSchema]}>
  {/* ---------------------------------------------------------------- hero */}
  <section class="gridlines relative overflow-hidden border-b border-outline-variant">
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-px"
      style="background: linear-gradient(90deg, transparent 5%, color-mix(in srgb, var(--md-sys-color-primary) 50%, transparent) 50%, transparent 95%); opacity: 0.8"
    >
    </div>

    <div class="wrap py-10 sm:py-14 md:py-18 lg:py-22">
      <div class="grid items-start gap-8 lg:grid-cols-[minmax(19rem,0.85fr)_minmax(0,1.15fr)] lg:gap-16">
        {/* Avatar: Precision Instrument Frame */}
        <div class="relative order-1 w-36 sm:w-48 lg:w-full">
          <div class="ticked-frame">
          <span class="tick tick-tl" /><span class="tick tick-tr" /><span class="tick tick-bl" /><span class="tick tick-br" />
          <div class="relative overflow-hidden bg-surface-container-low">
            <Image
              src={avatar}
              alt="David Gray"
              widths={[480, 720, 960]}
              sizes="(min-width: 1024px) 38vw, 22rem"
              class="aspect-[4/5] w-full object-cover object-top transition-transform duration-500 ease-out hover:scale-105"
              loading="eager"
            />
            <div
              class="absolute inset-x-0 bottom-0 hidden items-center justify-between gap-3 px-5 py-4 font-mono text-label backdrop-blur-xl sm:flex text-on-surface bg-surface-container-highest/82 border-t border-outline-variant"
            >
              <span>{site.location}</span>
              <span class="rounded-md px-2.5 py-0.5 font-semibold font-mono text-label bg-primary-container text-on-primary-container">
                M.S. CS @ UIUC
              </span>
            </div>
          </div>
          </div>
        </div>

        {/* Hero Copy & Controls */}
        <div class="order-2">
          <div class="inline-flex items-center gap-2 rounded-lg border px-3 py-1 font-mono text-label uppercase tracking-wider font-semibold bg-surface-container-high border-outline-variant text-primary">
            <span class="h-1.5 w-1.5 rounded-full bg-primary" />
            <span>Product Security & Cloud Systems</span>
          </div>

          <h1 class="mt-4 max-w-3xl font-semibold leading-[1.04] tracking-tight text-[1.85rem] sm:text-[2.6rem] md:text-[3.4rem] lg:text-[4.25rem] text-on-surface">
            Engineer. Scientist.<br /><span class="shimmer-text">Occasionally underwater.</span>
          </h1>

          <p class="mt-4 max-w-2xl text-body leading-relaxed sm:mt-5 sm:text-body-lg md:mt-6 md:text-title-sm text-on-surface-variant">
            <strong class="font-semibold text-on-surface">I'm a product security engineer in St. Louis, securing Kubernetes and Azure delivery from threat model to release.</strong>{' '}
            Alongside it, I work on machine learning, a document platform nobody asked me to
            build, and a master's degree at the University of Illinois.
          </p>
          <p class="mt-3.5 max-w-xl text-body-sm leading-relaxed sm:text-body text-on-surface-variant">
            Outside of that: scuba diving, rock climbing, hiking, and making things that aren't
            software. I like problems where the consequences are real.
          </p>

          {/* Action Button Row */}
          <div class="mt-7 flex flex-wrap items-center gap-2.5 sm:mt-9 sm:gap-3.5">
            <a href="/work" class="btn btn-primary">
              See my work
              <Icon name="arrow" size={15} />
            </a>
            <a href="/contact" class="btn btn-ghost">
              Get in touch
            </a>
          </div>

          {/* Social Links: Chips */}
          <ul class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-1 font-mono text-caption sm:mt-7">
            {
              socials.slice(0, 3).map((s) => (
                <li>
                  <a
                    href={s.href}
                    class="inline-flex min-h-10 items-center gap-2 transition-colors hover:text-primary text-on-surface-variant"
                    rel={s.href.startsWith('http') ? 'me noopener' : undefined}
                  >
                    <Icon name={s.icon} size={14} />
                    {s.handle}
                  </a>
                </li>
              ))
            }
          </ul>

          {site.availableForWork && (
            <p class="mt-3 inline-flex items-center gap-2 text-body-sm text-on-surface-variant">
              <span class="h-2 w-2 rounded-full bg-primary" />
              {site.availabilityNote}
            </p>
          )}
        </div>
      </div>

      {/* Stats: ruled telemetry strip */}
      <div class="ruled-panel mt-16">
        <span class="tick tick-tl" /><span class="tick tick-tr" /><span class="tick tick-bl" /><span class="tick tick-br" />
      <div class="ruled-grid grid-cols-2 md:grid-cols-4">
        {
          stats.map((stat) => (
            <div class="ruled-cell p-5 md:p-6">
              <p class="font-mono text-headline font-bold tracking-tight md:text-headline-lg text-primary">
                {stat.value}
              </p>
              <p class="mt-1 text-caption leading-snug font-medium text-on-surface-variant">
                {stat.label}
              </p>
            </div>
          ))
        }
      </div>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ services */}
  <Section
    kicker="How I can help"
    title="The kinds of problem I'm good at"
    lead="Everything below is work I do now, not work I did once. If your problem looks like one of these, we should talk."
    alt
  >
    <div class="ruled-panel mt-12">
      <span class="tick tick-tl" /><span class="tick tick-tr" /><span class="tick tick-bl" /><span class="tick tick-br" />
      <div class="ruled-grid md:grid-cols-2 lg:grid-cols-4">
        {
          services.map((service, i) => (
            <div class="ruled-cell is-interactive p-7 md:p-8">
              <span class="cell-index inline-flex items-center justify-center rounded-md px-2.5 py-1 font-mono text-label font-semibold">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-5 text-title font-semibold leading-snug text-on-surface">{service.title}</h3>
              <p class="mt-3 text-body-sm leading-relaxed text-on-surface-variant">
                {service.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  {/* ---------------------------------------------------------------- work */}
  <Section
    kicker="Selected work"
    title="A few things worth showing"
    lead="Some of it shipped to production on hardware I'll never see again. Some of it is a side project my wife asked for. Both taught me something."
  >
    <div class="ruled-panel mt-12">
      <span class="tick tick-tl" /><span class="tick tick-tr" /><span class="tick tick-bl" /><span class="tick tick-br" />
      <div class="ruled-grid md:grid-cols-3">
        {featured.map((entry) => <WorkCard entry={entry} />)}
      </div>
    </div>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a href="/work" class="btn btn-ghost">
        All projects
        <Icon name="arrow" size={16} />
      </a>
      <a href="/wordlet" class="btn btn-tonal font-mono text-caption">
        Play Wordlet in browser →
      </a>
    </div>
  </Section>

  {/* ------------------------------------------------------------- writing */}
  {
    posts.length > 0 && (
      <Section kicker="Writing" title="Notes from the workbench" alt>
        <div class="ruled-list mt-10">
          {posts.map((entry) => (
            <PostCard entry={entry} />
          ))}
        </div>
        <a href="/blog" class="btn btn-ghost mt-10">
          All posts
          <Icon name="arrow" size={16} />
        </a>
      </Section>
    )
  }

  {/* ------------------------------------------------------- off the clock */}
  <Section
    kicker="Off the clock"
    title="The parts that aren't on the résumé"
    lead="Same habits, different problems. Most of what I'm good at at work, I practised somewhere else first."
  >
    <div class="ruled-panel mt-12">
      <span class="tick tick-tl" /><span class="tick tick-tr" /><span class="tick tick-bl" /><span class="tick tick-br" />
      <div class="ruled-grid sm:grid-cols-2 lg:grid-cols-4">
        {
          offTheClock.map((item) => (
            <div class="ruled-cell is-interactive dot-reveal flex flex-col p-7 md:p-8">
              <p class="font-mono text-label font-semibold uppercase tracking-[0.12em] text-primary">{item.label}</p>
              <h3 class="mt-4 text-title font-semibold leading-snug text-on-surface">{item.title}</h3>
              <p class="mt-3 text-body-sm leading-relaxed text-on-surface-variant">{item.body}</p>
              {item.href && (
                <a href={item.href} class="link-underline relative z-10 mt-auto inline-flex items-center gap-1.5 pt-6 font-mono text-caption text-on-surface">
                  {item.cta}
                  <Icon name="arrow" size={14} />
                </a>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <CallToAction />
</Base>
