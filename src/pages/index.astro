---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Section from '~/components/Section.astro';
import WorkCard from '~/components/WorkCard.astro';
import PostCard from '~/components/PostCard.astro';
import CallToAction from '~/components/CallToAction.astro';
import Icon from '~/components/Icon.astro';
import ProductCard from '~/components/ProductCard.astro';
import ProofQuote from '~/components/ProofQuote.astro';
import { products } from '~/data/products';
import { quotes, receipts } from '~/data/proof';
import { site, socials } from '~/site.config';
import { offTheClock, services, stats } from '~/data/resume';
import avatar from '~/assets/avatar.png';
import { personSchema, websiteSchema } from '~/lib/schema';
import { hasPhotos } from '~/lib/nav';

// Products have their own row above, so Selected work shows the next three
// projects: featured first, then by order.
const productSlugs = new Set(products.map((p) => p.slug));
const featured = (await getCollection('work', ({ id, data }) => !data.draft && !productSlugs.has(id)))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order)
  .slice(0, 3);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// Until there's an album, the diving and climbing cards shouldn't lead to an empty page.
const showPhotos = await hasPhotos();
const hobbies = offTheClock.map((item) =>
  item.href === '/photos' && !showPhotos ? { ...item, href: undefined } : item,
);
---

<Base jsonLd={[websiteSchema, personSchema]}>
  {/* ---------------------------------------------------------------- hero */}
  <section class="dot-field relative overflow-hidden">
    <div class="wrap pt-10 pb-20 sm:pt-14 md:pt-20 md:pb-28">
      <div class="grid items-center gap-10 lg:grid-cols-[minmax(18rem,0.8fr)_minmax(0,1.2fr)] lg:gap-16">
        {/* Portrait */}
        <div class="hero-photo relative w-40 sm:w-52 lg:w-full">
          <div class="ticked-frame">
            <div class="relative bg-surface-container-low">
              <Image
                src={avatar}
                alt="David Gray"
                widths={[288, 384, 480, 720, 960]}
                sizes="(min-width: 1024px) 38vw, (min-width: 640px) 13rem, 10rem"
                class="block aspect-[4/5] w-full object-cover object-top"
                loading="eager"
              />
              <div class="hero-badge absolute inset-x-3 bottom-3 hidden items-center justify-between gap-3 rounded-full py-1.5 pr-1.5 pl-4 text-[0.8125rem] font-medium text-on-surface sm:flex">
                <span>{site.location}</span>
                <span class="rounded-full bg-primary px-3 py-1 text-[0.75rem] font-semibold text-on-primary">M.S. CS @ UIUC</span>
              </div>
            </div>
          </div>
        </div>

        {/* Copy */}
        <div>
          <p class="kicker">Machine learning &amp; systems</p>
          <h1 class="mt-3 max-w-3xl text-[clamp(2.6rem,7.2vw,5.25rem)] leading-[1.0] font-semibold tracking-[-0.045em] text-on-surface">
            Engineer. Scientist.<br /><span class="hero-gradient">Occasionally underwater.</span>
          </h1>

          <p class="mt-6 max-w-2xl text-[clamp(1.0625rem,1.8vw,1.3125rem)] leading-relaxed text-on-surface-variant">
            <strong class="font-semibold text-on-surface">I'm a software engineer in St. Louis working on machine learning: how fast models really run, why, and the systems they run on.</strong>{' '}
            By day I secure Kubernetes and Azure delivery at Boeing. Alongside it, a document
            platform nobody asked me to build, and a master's in data science at the University of Illinois.
          </p>
          <p class="mt-4 max-w-xl text-[1rem] leading-relaxed text-on-surface-variant">
            Outside of that: scuba diving, rock climbing, hiking, and making things that aren't
            software. I like problems where the consequences are real.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a href="/work" class="btn btn-primary">
              See my work
              <Icon name="arrow" size={15} />
            </a>
            <a href="/contact" class="btn btn-ghost">Get in touch</a>
          </div>

          <ul class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-1 text-[0.875rem]">
            {
              socials.slice(0, 3).map((s) => (
                <li>
                  <a
                    href={s.href}
                    class="inline-flex min-h-11 items-center gap-2 text-on-surface-variant transition-colors duration-200 hover:text-on-surface"
                    rel={s.href.startsWith('http') ? 'me noopener' : undefined}
                  >
                    <Icon name={s.icon} size={15} />
                    {s.handle}
                  </a>
                </li>
              ))
            }
          </ul>

          {site.availableForWork && (
            <p class="mt-3 inline-flex items-center gap-2 text-body-sm text-on-surface-variant">
              <span class="h-2 w-2 rounded-full bg-secondary" />
              {site.availabilityNote}
            </p>
          )}
        </div>
      </div>

      {/* By the numbers */}
      <dl class="mt-20 grid grid-cols-2 gap-x-6 gap-y-10 md:mt-24 md:grid-cols-4" data-reveal>
        {
          stats.map((stat) => (
            <div class="flex flex-col">
              <dt class="mt-2 max-w-[14rem] text-[0.9375rem] leading-snug text-on-surface-variant">{stat.label}</dt>
              <dd class="hero-stat order-first text-[clamp(2.5rem,5vw,3.75rem)] leading-none font-semibold tracking-[-0.045em]">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* --------------------------------------------------------------- proof */}
  <Section kicker="In other words" title="What it's like to work with me">
    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {quotes.map((quote) => <ProofQuote quote={quote} class="lg:col-span-2" />)}
      {
        receipts.map((r) => (
          <div class="surface flex flex-col p-7">
            <p class="kicker">On the record</p>
            <p class="receipt-value mt-6">{r.value}</p>
            <p class="mt-2 text-body-sm leading-relaxed text-on-surface-variant">{r.label}</p>
            <a href={r.source.href} class="receipt-source mt-auto inline-flex min-h-11 items-center pt-4" rel={r.source.href.startsWith('http') ? 'noopener' : undefined}>
              {r.source.label} →
            </a>
          </div>
        ))
      }
    </div>
  </Section>

  {/* ------------------------------------------------------------ products */}
  <Section
    kicker="Things you can use"
    title="Products, not just projects"
    lead="Two things I've built that are out in the world today. One is a business; one is a library."
    alt
  >
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {products.map((product) => <ProductCard product={product} />)}
    </div>
  </Section>

  {/* ------------------------------------------------------------ services */}
  <Section
    kicker="How I can help"
    title="The kinds of problem I'm good at"
    lead="Everything below is work I do now, not work I did once. If your problem looks like one of these, we should talk."
  >
    <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {
        services.map((service, i) => (
          <div class="surface p-7">
            <span class="grid size-8 place-items-center rounded-full bg-[var(--g-fill)] text-[0.8125rem] font-semibold text-primary">{i + 1}</span>
            <h3 class="mt-5 text-title font-semibold leading-snug tracking-[-0.015em] text-on-surface">{service.title}</h3>
            <p class="mt-3 text-body-sm leading-relaxed text-on-surface-variant">{service.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  {/* ---------------------------------------------------------------- work */}
  <Section
    kicker="Selected work"
    title="A few things worth showing"
    lead="Some of it shipped to production on hardware I'll never see again. Some of it started as a class project and outlived the class. All of it taught me something."
    alt
  >
    <div class="ruled-panel mt-12">
      <div class="ruled-grid md:grid-cols-3">
        {featured.map((entry) => <WorkCard entry={entry} />)}
      </div>
    </div>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a href="/work" class="btn btn-ghost">
        All projects
        <Icon name="arrow" size={16} />
      </a>
      <a href="/play" class="btn btn-tonal">
        Play the games
      </a>
    </div>
  </Section>

  {/* ------------------------------------------------------------- writing */}
  {
    posts.length > 0 && (
      <Section kicker="Writing" title="Notes from the workbench">
        <div class="ruled-list mt-10">
          {posts.map((entry) => (
            <PostCard entry={entry} />
          ))}
        </div>
        <a href="/blog" class="btn btn-ghost mt-10">
          All posts
          <Icon name="arrow" size={16} />
        </a>
      </Section>
    )
  }

  {/* ------------------------------------------------------- off the clock */}
  <Section
    kicker="Off the clock"
    title="The parts that aren't on the resume"
    lead="Same habits, different problems. Most of what I'm good at at work, I practiced somewhere else first."
    alt
  >
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        hobbies.map((item) => (
          <div class:list={['surface relative flex flex-col p-7', item.href && 'spotlight-card']}>
            <p class="text-[0.8125rem] font-semibold text-primary">{item.label}</p>
            <h3 class="mt-2 text-title font-semibold leading-snug tracking-[-0.015em] text-on-surface">{item.title}</h3>
            <p class="mt-3 text-body-sm leading-relaxed text-on-surface-variant">{item.body}</p>
            {item.href && (
              <a href={item.href} class="mt-auto inline-flex min-h-11 items-center gap-1.5 pt-5 text-[0.875rem] font-medium text-primary after:absolute after:inset-0 after:content-['']">
                {item.cta}
                <Icon name="arrow" size={14} />
              </a>
            )}
          </div>
        ))
      }
    </div>
  </Section>

  <CallToAction />
</Base>

<style>
  /* The last line of the headline in an amber-to-coral gradient. */
  .hero-gradient {
    background: linear-gradient(
      100deg,
      var(--md-sys-color-primary) 10%,
      color-mix(in srgb, var(--md-sys-color-primary) 55%, #e8465b) 90%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-stat {
    background: linear-gradient(180deg, var(--md-sys-color-on-surface), color-mix(in srgb, var(--md-sys-color-on-surface) 62%, transparent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-variant-numeric: tabular-nums;
  }
  .hero-badge {
    background: color-mix(in srgb, var(--md-sys-color-surface) 70%, transparent);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    box-shadow: 0 0 0 0.5px var(--g-hair);
  }
  @media (forced-colors: active) {
    .hero-gradient,
    .hero-stat {
      background: none;
      color: CanvasText;
    }
  }
</style>
