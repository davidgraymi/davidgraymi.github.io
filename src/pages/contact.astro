---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import CopyEmail from '~/components/CopyEmail.astro';
import { site, socials } from '~/site.config';

const goodFits = [
  'Kubernetes, Azure, cloud, platform, or infrastructure work that needs to be reliable and easy to operate',
  'Machine learning that needs to survive contact with production, not just a benchmark',
  'Build systems, CI and internal tooling that everybody wants and nobody has time for',
  'A second opinion on an architecture before you commit to it',
];

const badFits = [
  'Unpaid "quick chats" that are actually a job interview',
  'Anything that needs me to be a full-time founder tomorrow',
  'Cold recruiter templates with my name find-and-replaced in',
];
---

<Base
  title="Contact"
  description="The fastest way to reach me is email. No form, no funnel, no autoresponder."
>
  <section class="dot-field border-b border-outline-variant">
    <div class="wrap py-16 md:py-24">
      <div class="max-w-2xl">
        <p class="kicker">Contact</p>
        <h1 class="mt-5 font-semibold leading-tight tracking-tight text-h1 text-on-surface">
          Email me. It goes straight to me.
        </h1>
        <p class="mt-4 text-title-sm leading-relaxed text-on-surface-variant">
          No contact form, no funnel, no autoresponder pretending to be a person. One address, read
          by one human, usually answered within a day or two.
        </p>

        <a
          href={`mailto:${site.email}`}
          class="link-underline mt-8 inline-block font-mono text-[clamp(1.2rem,0.9rem+1.8vw,2.1rem)] font-semibold text-primary"
        >
          {site.email}
        </a>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={`mailto:${site.email}`} class="btn btn-primary">
            <Icon name="mail" size={17} />
            Open my mail app
          </a>
          <CopyEmail />
        </div>

        <p class="mt-8 font-mono text-label text-on-surface-variant">
          {site.location} · Central Time · {site.availabilityNote}
        </p>
      </div>
    </div>
  </section>

  <section class="border-b border-outline-variant">
    <div class="wrap py-16 md:py-20">
     <div class="ruled-panel">
      <span class="tick tick-tl" /><span class="tick tick-tr" /><span class="tick tick-bl" /><span class="tick tick-br" />
     <div class="ruled-grid md:grid-cols-2">
      <div class="ruled-cell p-8">
        <h2 class="text-title font-semibold text-on-surface">Good reasons to write</h2>
        <ul class="mt-6 space-y-4">
          {
            goodFits.map((item) => (
              <li class="flex gap-3.5 text-body leading-relaxed">
                <span
                  class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full text-primary bg-surface-container-high"
                >
                  <Icon name="check" size={15} />
                </span>
                <span class="text-on-surface">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="ruled-cell p-8">
        <h2 class="text-title font-semibold text-on-surface">Honestly, probably not</h2>
        <ul class="mt-6 space-y-4">
          {
            badFits.map((item) => (
              <li class="flex gap-3.5 text-body leading-relaxed text-on-surface-variant">
                <span
                  class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full opacity-80 text-error bg-error-container"
                >
                  <Icon name="close" size={14} />
                </span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-6 text-body-sm leading-relaxed text-on-surface-variant">
          If you're not sure which list you're on, write anyway. I'd rather read a message that
          turns out to be a no than miss the one that wasn't.
        </p>
      </div>
     </div>
     </div>
    </div>
  </section>

  <section>
    <div class="wrap py-16 md:py-20">
      <p class="kicker">Elsewhere on the internet</p>
      <div class="ruled-panel mt-8">
        <span class="tick tick-tl" /><span class="tick tick-tr" /><span class="tick tick-bl" /><span class="tick tick-br" />
      <div class="ruled-grid sm:grid-cols-2">
        {
          socials.map((s) => (
            <a
              href={s.href}
              class="ruled-cell is-interactive group flex items-center gap-4 p-5"
              rel={s.href.startsWith('http') ? 'me noopener' : undefined}
            >
              <div
                class="rounded-md border p-2.5 transition-colors group-hover:border-primary group-hover:text-primary bg-surface border-outline-variant"
              >
                <Icon name={s.icon} size={20} />
              </div>
              <div>
                <span class="block text-body font-semibold transition-colors group-hover:text-primary text-on-surface">{s.label}</span>
                <span class="block font-mono text-label text-on-surface-variant">
                  {s.handle}
                </span>
              </div>
              <span class="ml-auto opacity-0 transition-all duration-200 group-hover:translate-x-0.5 group-hover:opacity-100 text-primary">
                <Icon name="arrowUpRight" size={17} />
              </span>
            </a>
          ))
        }
      </div>
      </div>
    </div>
  </section>
</Base>
