---
import Base from '~/layouts/Base.astro';
import BackLink from '~/components/BackLink.astro';
import Wordlet from '~/components/games/Wordlet.astro';
---

<Base
  title="Daily Wordlet"
  description="One five-letter word a day, six guesses, nothing to install. The daily edition of Wordlet."
>
  <header class="dot-field border-b border-outline-variant">
    <div class="wrap py-14 md:py-20">
      <BackLink href="/work/wordlet" label="About Wordlet" />
      <h1 class="mt-6 max-w-3xl font-semibold tracking-tight text-h1 text-on-surface">Daily Wordlet</h1>
      <p class="mt-4 max-w-2xl text-title-sm leading-relaxed text-on-surface-variant">
        One word a day, the same for everyone. Six guesses. Any five letters count as a guess, just
        like the original. An amber tile is in the right spot; a blue one is in the word somewhere else.
      </p>
    </div>
  </header>

  <div class="wrap py-12 md:py-16">
    <Wordlet />
    <p class="mx-auto mt-10 max-w-lg text-body-sm leading-relaxed text-on-surface-variant">
      Type on your keyboard or tap the keys. Your board, streak and stats stay in this browser and
      nowhere else. Want endless rounds instead?
      The <a href="/wordlet" class="link-underline text-primary">original Flutter build</a> picks a
      new word every time.
    </p>
  </div>
</Base>
