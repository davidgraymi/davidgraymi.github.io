---
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import BotOrHuman from '~/components/games/BotOrHuman.astro';
import { rounds } from '~/data/bot-or-human';
---

<Base
  title="Bot or human?"
  description="A small game: two short texts side by side, one public-domain human classic and one written by a language model. Spot the bot."
>
  <PageHeader
    kicker="Mini game"
    title="Bot or human?"
    lead={`${rounds.length} rounds. Each pairs a line from a public-domain poem, novel or proverb with an imitation written by a language model. Pick the bot, then see what gave it away.`}
  />

  <section>
    <div class="wrap py-12 md:py-16">
      <BotOrHuman />
    </div>
  </section>
</Base>
