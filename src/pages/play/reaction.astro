---
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import ReactionTest from '~/components/games/ReactionTest.astro';
---

<Base title="Reaction test" description="Wait for the panel to light up amber, then hit it as fast as you can.">
  <PageHeader
    kicker="Play"
    title="Reaction test"
    lead="Quiet until something matters. Wait for the panel to light up amber, then click, tap or press Space as fast as you can. Jump early and it doesn't count."
  />
  <section>
    <div class="wrap py-16 md:py-20">
      <div class="max-w-3xl">
        <ReactionTest />
      </div>
    </div>
  </section>
</Base>
