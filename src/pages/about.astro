---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Section from '~/components/Section.astro';
import CallToAction from '~/components/CallToAction.astro';
import Icon from '~/components/Icon.astro';
import { site, socials } from '~/site.config';
import { education, roles, skills } from '~/data/resume';
import avatar from '~/assets/avatar.png';
import { personSchema } from '~/lib/schema';

const interests = ['Scuba diving', 'Rock climbing', 'Hiking', 'Making art'];
---

<Base
  title="About"
  jsonLd={personSchema}
  description="Product Security Engineer in St. Louis. Kubernetes, Azure, and secure cloud infrastructure by day, machine learning and a document platform nobody asked for by night."
>
  <section class="gridlines border-b border-outline-variant">
    <div class="wrap grid items-start gap-10 py-16 md:grid-cols-[1.5fr_1fr] md:gap-16 md:py-24">
      <div>
        <p class="kicker">About</p>
        <h1 class="mt-5 font-semibold leading-tight tracking-tight text-h1 text-on-surface">
          Hi, I'm David. I got into this to find out how the magic worked.
        </h1>
        <div class="mt-7 space-y-5 text-body-lg leading-relaxed text-on-surface-variant">
          <p>
            It turned out there wasn't any. Starting my career writing kernels and schedulers in C
            and Ada meant meeting the computer with nothing between us — no runtime, no framework,
            no safety net, nobody to page at 3am. Every abstraction I'd been quietly grateful for
            turned out to be somebody's careful engineering, made of the same parts I was now
            writing by hand.
          </p>
          <p>
            That has shaped how I work more than any language or framework has. I'm suspicious of
            things I can't explain to the bottom. I'd rather ship something smaller that I
            understand completely than something impressive that I'm holding by the handle.
          </p>
          <p>
            These days that plays out in two directions. During the day it's product security and
            cloud platform work — Kubernetes, Azure, infrastructure-as-code, service mesh, and the
            systems that make secure deployment pipelines practical instead of fragile. On evenings
            and weekends it's machine learning, a document platform I built because my wife had a bad
            one at work, and a master's in computer science at Illinois to make the ML half rigorous
            rather than intuitive.
          </p>
          <p>
            I like problems where the consequences are real. That's true of the software, and
            apparently it's true of me generally — the hobbies that stuck are the ones where you
            check your gear before you go.
          </p>
        </div>
      </div>

      <div class="w-full">
        {/* Avatar: M3 Expressive Card Shape */}
        <div class="ticked-frame">
          <span class="tick tick-tl" /><span class="tick tick-tr" /><span class="tick tick-bl" /><span class="tick tick-br" />
          <div class="overflow-hidden bg-surface-container-low">
          <Image
            src={avatar}
            alt="David Gray"
            widths={[480, 720, 960]}
            sizes="(min-width: 768px) 36vw, 92vw"
            loading="eager"
            class="aspect-square w-full object-cover transition-transform duration-700 ease-out hover:scale-105"
          />
          </div>
        </div>

        {/* Info DL Block */}
        <dl
          class="mt-6 space-y-3.5 border p-6 font-mono text-caption bg-surface border-outline-variant"
        >
          <div class="flex justify-between gap-4 border-b pb-3 border-outline-variant">
            <dt class="text-on-surface-variant">Based in</dt>
            <dd class="text-right font-medium text-on-surface">{site.location}</dd>
          </div>
          <div class="flex justify-between gap-4 border-b pb-3 border-outline-variant">
            <dt class="text-on-surface-variant">Studying</dt>
            <dd class="text-right font-semibold text-primary">M.S. CS, UIUC</dd>
          </div>
          <div class="flex justify-between gap-4 border-b pb-3 border-outline-variant">
            <dt class="text-on-surface-variant">Language</dt>
            <dd class="text-right font-medium text-on-surface">English (native)</dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-on-surface-variant">Off the clock</dt>
            <dd class="text-right font-medium text-on-surface">{interests.join(', ')}</dd>
          </div>
        </dl>

        <div class="mt-6 flex flex-wrap gap-2.5">
          {
            socials.map((s) => (
              <a
                href={s.href}
                class="btn btn-ghost h-9.5 rounded-lg px-3.5 text-caption"
                rel={s.href.startsWith('http') ? 'me noopener' : undefined}
              >
                <Icon name={s.icon} size={15} />
                {s.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ experience */}
  <Section kicker="Experience" title="Where I've worked" alt>
    <div class="ruled-panel mt-12">
      <span class="tick tick-tl" /><span class="tick tick-tr" /><span class="tick tick-bl" /><span class="tick tick-br" />
    <div class="ruled-grid">
      {
        roles.map((role) => (
          <div class="ruled-cell grid gap-6 p-7 md:grid-cols-[1fr_2fr] md:gap-10 md:p-8">
            <div>
              <h3 class="text-title-sm font-semibold leading-snug text-on-surface">{role.title}</h3>
              <p class="mt-1.5 font-medium text-body text-primary">
                {role.org}
              </p>
              <p class="mt-2 font-mono text-label text-on-surface-variant">
                {role.period}
              </p>
            </div>
            <div>
              <p class="text-body leading-relaxed text-on-surface">{role.summary}</p>
              <ul class="mt-4 space-y-2.5">
                {role.points.map((point) => (
                  <li class="flex gap-3 text-body-sm leading-relaxed text-on-surface-variant">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" />
                    {point}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
    </div>
  </Section>

  {/* ------------------------------------------------- education and skills */}
  <Section kicker="Background">
    <div class="grid gap-12 md:grid-cols-2 md:gap-16">
      <div>
        <h2 class="text-headline-sm font-semibold text-on-surface">Education</h2>
        <div class="mt-6 space-y-4">
          {
            education.map((item) => (
              <div
                class="border border-l-4 border-outline-variant border-l-primary bg-surface p-6"
              >
                <p class="text-body-lg font-semibold text-on-surface">{item.degree}</p>
                <p class="mt-1 text-body text-on-surface-variant">
                  {item.school}
                </p>
                <p class="mt-2 font-mono text-label text-on-surface-variant">
                  {item.period}
                  {item.note && ` · ${item.note}`}
                </p>
              </div>
            ))
          }
        </div>
      </div>

      <div>
        <h2 class="text-headline-sm font-semibold text-on-surface">Tools I reach for</h2>
        <div class="mt-6 space-y-6">
          {
            skills.map((group) => (
              <div>
                <p class="kicker">{group.group}</p>
                <div class="mt-3 flex flex-wrap gap-2">
                  {group.items.map((item) => (
                    <span
                      class="rounded-lg border px-3 py-1.5 font-mono text-label transition-all hover:border-primary hover:text-primary bg-surface-container border-outline-variant text-on-surface-variant"
                    >
                      {item}
                    </span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <a href="/files/Resume.docx" class="btn btn-tonal mt-12">
      <Icon name="file" size={16} />
      Download my résumé
    </a>
  </Section>

  <CallToAction
    title="That's the short version"
    body="The longer one involves an experimental aircraft, a mushroom classifier, and a word game. Ask me about any of it."
  />
</Base>
