---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import Icon from '~/components/Icon.astro';

const albums = (await getCollection('photos', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const coverOf = (album: (typeof albums)[number]) => album.data.cover ?? album.data.images[0]?.src;
---

<Base
  title="Photos"
  description="Above water and below it — a slowly growing collection of places I've been."
  noindex={albums.length === 0}
>
  <PageHeader
    kicker="Photos"
    title="Above water and below it"
    lead="Diving, climbing, hiking, and whatever else got me outside. Shot mostly badly, kept anyway."
  />

  <div class="wrap py-14 md:py-20">
    {
      albums.length === 0 ? (
        <div
          class="surface flex max-w-xl flex-col items-start p-8"
          style="background: var(--md-sys-color-surface-container-low); border-color: var(--md-sys-color-outline-variant);"
        >
          <span
            class="grid h-12 w-12 place-items-center rounded-md"
            style="color: var(--md-sys-color-primary); background: var(--md-sys-color-surface-container-high);"
          >
            <Icon name="camera" size={26} />
          </span>
          <p class="mt-5 text-[18px] font-semibold" style="color: var(--md-sys-color-on-surface);">Still sorting through the card.</p>
          <p class="mt-2 text-[15px] leading-relaxed" style="color: var(--md-sys-color-on-surface-variant)">
            The first albums from diving and climbing trips are on their way. In the meantime, the
            <a href="/work" class="link-underline">work</a> and <a href="/blog" class="link-underline">writing</a> are all here.
          </p>
        </div>
      ) : (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {albums.map((album) => {
            const cover = coverOf(album);
            return (
              <a
                href={`/photos/${album.id}`}
                class="spotlight-card group relative overflow-hidden transition-all duration-300"
                style="background: var(--md-sys-color-surface-container-low); border-color: var(--md-sys-color-outline-variant);"
              >
                {cover && (
                  <div class="aspect-[4/3] overflow-hidden" style="background: var(--md-sys-color-surface-container)">
                    <Image
                      src={cover}
                      alt=""
                      widths={[400, 800]}
                      sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
                      class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="border-t p-5.5" style="border-color: var(--md-sys-color-outline-variant);">
                  <h2 class="text-[18px] font-semibold transition-colors group-hover:text-[var(--md-sys-color-primary)]" style="color: var(--md-sys-color-on-surface);">{album.data.title}</h2>
                  <p class="mt-1.5 font-mono text-[12px]" style="color: var(--md-sys-color-on-surface-variant)">
                    {album.data.location && `${album.data.location} · `}
                    {album.data.images.length}{' '}
                    {album.data.images.length === 1 ? 'photo' : 'photos'}
                  </p>
                </div>
              </a>
            );
          })}
        </div>
      )
    }
  </div>
</Base>
