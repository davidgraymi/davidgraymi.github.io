---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import FormattedDate from '~/components/FormattedDate.astro';
import BackLink from '~/components/BackLink.astro';
import CallToAction from '~/components/CallToAction.astro';

export const getStaticPaths = (async () => {
  const albums = await getCollection('photos', ({ data }) => !data.draft);
  return albums.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, date, location, images } = entry.data;
---

<Base title={title} description={`${title}${location ? ` — ${location}` : ''}`} type="article">
  <header class="gridlines border-b border-outline-variant">
    <div class="wrap py-12 md:py-16">
      <BackLink href="/photos" label="All albums" />
      <h1 class="mt-6 font-semibold tracking-tight text-h1 text-on-surface">{title}</h1>
      <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-label uppercase tracking-[0.12em] text-on-surface-variant">
        {location && <span class="text-primary">{location}</span>}
        <FormattedDate date={date} />
        <span>{images.length} {images.length === 1 ? 'photo' : 'photos'}</span>
      </p>
      <div class="prose mt-6 max-w-2xl">
        <Content />
      </div>
    </div>
  </header>

  <div class="wrap py-12 md:py-16">
    <div class="columns-1 gap-6 sm:columns-2 lg:columns-3">
      {
        images.map((photo) => (
          <figure class="mb-6 break-inside-avoid">
            <Image
              src={photo.src}
              alt={photo.alt}
              widths={[400, 800, 1200]}
              sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
              class="w-full border border-outline-variant"
              loading="lazy"
            />
            {photo.caption && (
              <figcaption class="mt-2.5 text-caption leading-relaxed text-on-surface-variant">
                {photo.caption}
              </figcaption>
            )}
          </figure>
        ))
      }
    </div>
  </div>

  <CallToAction
    title="Know a good dive site?"
    body="Or a crag, a trail, or a game I should be playing. Recommendations are as welcome as work."
  />
</Base>
