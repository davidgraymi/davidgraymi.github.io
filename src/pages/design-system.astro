---
/**
 * Living style guide. Every swatch and specimen here renders from the same
 * tokens and classes the rest of the site uses, so if it looks wrong here it
 * looks wrong everywhere. Not linked from the nav; noindex. DESIGN.md is the
 * written version; keep the two in step.
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import Section from '~/components/Section.astro';
import Icon from '~/components/Icon.astro';
import AuthorCard from '~/components/AuthorCard.astro';
import BackLink from '~/components/BackLink.astro';
import ProductCard from '~/components/ProductCard.astro';
import ProofQuote from '~/components/ProofQuote.astro';
import { products } from '~/data/products';
import { quotes } from '~/data/proof';

const colorGroups = [
  {
    name: 'Accent',
    roles: [
      ['primary', 'on-primary'],
      ['primary-container', 'on-primary-container'],
      ['secondary', 'on-secondary'],
      ['secondary-container', 'on-secondary-container'],
      ['tertiary', 'on-tertiary'],
      ['error', 'on-error'],
    ],
  },
  {
    name: 'Surface',
    roles: [
      ['surface', 'on-surface'],
      ['surface-container-lowest', 'on-surface'],
      ['surface-container-low', 'on-surface'],
      ['surface-container', 'on-surface'],
      ['surface-container-high', 'on-surface'],
      ['surface-container-highest', 'on-surface'],
    ],
  },
  {
    name: 'Content and lines',
    roles: [
      ['on-surface', 'surface'],
      ['on-surface-variant', 'surface'],
      ['outline', 'surface'],
      ['outline-variant', 'on-surface'],
    ],
  },
];

const typeScale = [
  ['text-display', 'fluid 45–83px', 'Hero headline'],
  ['text-h1', 'fluid 34–58px', 'Page title'],
  ['text-h2', 'fluid 26–38px', 'Section title'],
  ['text-headline-lg', '32px', 'Large stat'],
  ['text-headline', '28px', 'Stat, feature heading'],
  ['text-headline-sm', '22px', 'Sub-section heading'],
  ['text-title', '20px', 'Card title'],
  ['text-title-sm', '18px', 'Page lead'],
  ['text-body-lg', '17px', 'Section lead, intro paragraph'],
  ['text-body', '15px', 'Default interface copy'],
  ['text-body-sm', '14px', 'Secondary copy, nav'],
  ['text-caption', '13px', 'Metadata, filters'],
  ['text-label', '12px', 'The floor: nothing smaller'],
];

/** Headings tighten as they grow, the way a display face is set. */
const tracking = (cls: string) =>
  ({ 'text-display': 'tracking-[-0.045em]', 'text-h1': 'tracking-[-0.04em]', 'text-h2': 'tracking-[-0.03em]' })[cls] ??
  'tracking-[-0.015em]';

// Each trait the site has to prove, and the design decision that carries it.
const principles = [
  ['Engineer', 'Measurements look like measurements', 'Big tabular numerals for stats, and every number can carry a link to its source.'],
  ['Smart', 'Reads like a good essay', 'Newsreader serif for articles at 19px, tight sans headings, a real hierarchy.'],
  ['Friendly', 'Warm, not clinical', 'Stone and cream neutrals, charcoal instead of blue-black, 20px card corners, a real photo up top.'],
  ['Kind', 'Never makes you work for it', 'Plain labels, 44pt targets on touch, AA contrast in both themes, motion only when it explains something.'],
  ['Trustworthy', 'Every claim has a receipt', 'Numbers link to their source. Quotes carry a name, a role, and how they know me.'],
  ['Maker', 'Products, not features', 'Product cards lead with the problem, show a live status, and end in one action you can take today.'],
];

const radii = [
  ['rounded-md', '10px', 'Inputs, small media'],
  ['rounded-xl', '16px', 'Figures, code'],
  ['rounded-card', '20px', 'Cards, panels'],
  ['rounded-[1.75rem]', '28px', 'Portrait, game tray'],
  ['rounded-full', 'Pill', 'Buttons, chips'],
];
---

<Base title="Design system" description="Tokens and components behind davidmgray.com." noindex>
  <PageHeader
    kicker="Design system"
    title="Workbench"
    lead="Precise like an instrument, warm like a workshop, finished like a product. Amber on warm paper and charcoal, tight sans headlines, soft cards that lift and buttons that press. Everything below is the real token or component, so flip the theme to check both modes."
  />

  <!-- Principles -->
  <Section kicker="Principles" title="What the design has to prove" lead="The site exists to show that I'm someone you'd want to work with. Each trait maps to a decision you can check.">
    <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        principles.map(([trait, claim, how]) => (
          <div class="surface p-6 md:p-7">
            <p class="text-[0.9375rem] font-semibold text-primary">{trait}</p>
            <h3 class="mt-2 text-title font-semibold leading-snug tracking-[-0.02em] text-on-surface">{claim}</h3>
            <p class="mt-2 text-body-sm leading-relaxed text-on-surface-variant">{how}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Colour -->
  <Section alt kicker="Colour" title="Roles, not hex codes" lead="Components ask for a role, and each role resolves to a light and a dark value. Amber means act here. Sage means it works: shipped, live, correct. Neutrals are warm stone; nothing is blue-grey.">
    <div class="mt-10 space-y-10">
      {
        colorGroups.map((group) => (
          <div>
            <h3 class="text-[0.9375rem] font-semibold text-on-surface">{group.name}</h3>
            <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
              {group.roles.map(([bg, fg]) => (
                <div class="swatch overflow-hidden rounded-card">
                  <div class="flex h-24 items-end p-4 text-title font-semibold tracking-[-0.02em]" style={`background: var(--md-sys-color-${bg}); color: var(--md-sys-color-${fg});`}>
                    Aa
                  </div>
                  <div class="bg-surface-container-low px-4 py-2.5 text-caption font-medium text-on-surface-variant">{bg}</div>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Type -->
  <Section kicker="Type" title="Three faces, three jobs" lead="Sans is the voice of the interface and every headline. Serif is for reading at length. Mono is only for code and genuine data. Nothing renders below 12px.">
    <div class="mt-10 grid gap-4 md:grid-cols-3">
      <div class="surface p-6">
        <p class="meta-label">Interface and headlines · <code>font-sans</code></p>
        <p class="mt-4 text-headline font-semibold leading-tight tracking-[-0.03em] text-on-surface">See my work</p>
        <p class="mt-2 text-body-sm text-on-surface-variant">Titles, cards, nav, buttons, forms, tables.</p>
        <p class="mt-4 text-caption text-on-surface-variant">Roboto Flex 400–650</p>
      </div>
      <div class="surface p-6">
        <p class="meta-label">Reading · <code>font-serif</code></p>
        <p class="mt-4 font-serif text-headline leading-tight text-on-surface">I like problems where the consequences are real.</p>
        <p class="mt-4 text-caption text-on-surface-variant">Newsreader 400–600 · post bodies, quotes</p>
      </div>
      <div class="surface p-6">
        <p class="meta-label">Code and data · <code>font-mono</code></p>
        <p class="mt-4 font-mono text-title text-on-surface">kubectl apply -f</p>
        <p class="mt-2 text-body-sm text-on-surface-variant">Stats use the sans with tabular numerals instead.</p>
        <p class="mt-4 text-caption text-on-surface-variant">JetBrains Mono 400–700</p>
      </div>
    </div>

    <div class="surface mt-6 divide-y divide-outline-variant overflow-hidden p-0">
      {
        typeScale.map(([cls, size, use]) => (
          <div class="grid gap-1 px-6 py-4 md:grid-cols-[13rem_1fr] md:items-baseline md:gap-6">
            <p class="text-caption text-on-surface-variant">
              <code class="font-medium text-on-surface">{cls}</code> · {size}
            </p>
            <p class:list={[cls, tracking(cls), 'truncate font-semibold leading-tight text-on-surface']}>{use}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <div class="surface p-6">
        <p class="kicker">Kicker · <code>.kicker</code></p>
        <h3 class="mt-1 text-headline-sm font-semibold tracking-[-0.025em] text-on-surface">One per section, above the title</h3>
        <p class="mt-2 text-body-sm text-on-surface-variant">Amber, sentence case, semibold sans. No numbering, no capitals.</p>
      </div>
      <div class="surface p-6">
        <dl class="grid grid-cols-2 gap-6">
          <div class="flex flex-col">
            <dt class="meta-label mt-1">Published</dt>
            <dd class="order-first text-title font-semibold tracking-[-0.02em] text-on-surface">Mar 2025</dd>
          </div>
          <div class="flex flex-col">
            <dt class="meta-label mt-1">Reading time</dt>
            <dd class="order-first text-title font-semibold tabular-nums tracking-[-0.02em] text-on-surface">6 min</dd>
          </div>
        </dl>
        <p class="mt-4 text-body-sm text-on-surface-variant"><code>.meta-label</code> sits under a value: post and project metadata, hero stats.</p>
      </div>
    </div>
  </Section>

  <!-- Shape, depth, motion -->
  <Section alt kicker="Shape, depth and motion" title="Soft objects that respond" lead="Corners are soft everywhere and the corner ticks are retired. Cards stay flat until you point at them, then lift. Buttons press down instead.">
    <div class="mt-10 grid gap-10 lg:grid-cols-2">
      <div>
        <h3 class="text-[0.9375rem] font-semibold text-on-surface">Radius</h3>
        <div class="mt-4 grid grid-cols-5 gap-3">
          {
            radii.map(([cls, label, use]) => (
              <div class="text-center">
                <div class:list={[cls, 'mx-auto aspect-square w-full max-w-20 bg-primary-container']} />
                <p class="mt-2 text-caption font-medium text-on-surface">{label}</p>
                <p class="text-label text-on-surface-variant">{use}</p>
              </div>
            ))
          }
        </div>
      </div>
      <div>
        <h3 class="text-[0.9375rem] font-semibold text-on-surface">Elevation</h3>
        <div class="mt-4 grid grid-cols-5 gap-3">
          {
            ['shadow-elevation-1', 'shadow-elevation-2', 'shadow-elevation-3', 'shadow-elevation-4', 'shadow-elevation-5'].map((cls, i) => (
              <div class="text-center">
                <div class={`${cls} mx-auto aspect-square w-full max-w-20 rounded-card bg-surface-container-low`} />
                <p class="mt-2 text-caption font-medium text-on-surface">{i + 1}</p>
              </div>
            ))
          }
        </div>
        <p class="mt-6 text-body-sm leading-relaxed text-on-surface-variant">
          Cards are flat; depth comes from hairlines. Use 2 for floating chrome and 3–5 for overlays like search. Light-mode shadows are tinted warm brown, not black.
        </p>
      </div>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-3">
      <article class="spotlight-card p-6">
        <p class="meta-label">Hover · <code>.spotlight-card</code></p>
        <h3 class="mt-2 text-title font-semibold tracking-[-0.02em] text-on-surface">Lifts 3px</h3>
        <p class="mt-2 text-body-sm leading-relaxed text-on-surface-variant">and gains a soft shadow. For anything that navigates.</p>
      </article>
      <div class="surface p-6">
        <p class="meta-label">Press · <code>.btn</code></p>
        <button class="btn btn-tonal mt-4" type="button">Hold me down</button>
        <p class="mt-3 text-body-sm leading-relaxed text-on-surface-variant">Buttons scale to 96% while pressed.</p>
      </div>
      <div class="surface p-6">
        <p class="meta-label">Reveal · <code>data-reveal</code></p>
        <p class="mt-2 text-body-sm leading-relaxed text-on-surface-variant">
          Blocks rise and fade in the first time they scroll into view. Blocks on screen at load show at once; reduced motion and print never hide anything. One ease everywhere: <code>cubic-bezier(0.22, 1, 0.36, 1)</code>.
        </p>
      </div>
    </div>
  </Section>

  <!-- Components -->
  <Section kicker="Components" title="The parts bin">
    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      <div class="surface p-6">
        <h3 class="text-[0.9375rem] font-semibold text-on-surface">Buttons</h3>
        <div class="mt-5 flex flex-wrap gap-3">
          <button class="btn btn-primary" type="button">Primary <Icon name="arrow" size={16} /></button>
          <button class="btn btn-tonal" type="button">Tonal</button>
          <button class="btn btn-ghost" type="button">Ghost</button>
          <button class="btn btn-primary" type="button" disabled>Disabled</button>
        </div>
        <p class="mt-5 text-body-sm text-on-surface-variant">44px borderless pills, filled by emphasis. One primary per view.</p>
      </div>

      <div class="surface p-6">
        <h3 class="text-[0.9375rem] font-semibold text-on-surface">Chips and segmented control</h3>
        <div class="mt-5 flex flex-wrap gap-1.5">
          <span class="chip">kubernetes</span>
          <span class="chip">azure</span>
          <span class="chip">python</span>
          <span class="chip chip-accent">Playable</span>
        </div>
        <div class="seg mt-5" role="group" aria-label="Example filter">
          <button class="filter-tab" type="button" aria-pressed="true" data-demo-seg>All</button>
          <button class="filter-tab" type="button" aria-pressed="false" data-demo-seg>Security</button>
          <button class="filter-tab" type="button" aria-pressed="false" data-demo-seg>ML</button>
        </div>
        <p class="mt-5 text-body-sm text-on-surface-variant">At most one accent chip per card. The selected segment lifts on a pill.</p>
      </div>

      <div class="surface p-6">
        <h3 class="text-[0.9375rem] font-semibold text-on-surface">Static card · <code>.surface</code></h3>
        <p class="mt-2 text-body-sm leading-relaxed text-on-surface-variant">
          20px corners and a 9% ink hairline. For content that doesn't go anywhere.
        </p>
        <a href="#main" class="link-underline mt-4 inline-block text-body-sm font-medium text-on-surface">Inline link outside prose</a>
      </div>

      <div class="glass-panel p-6">
        <h3 class="text-[0.9375rem] font-semibold text-on-surface">Glass panel · <code>.glass-panel</code></h3>
        <p class="mt-2 text-body-sm leading-relaxed text-on-surface-variant">Static callout frame for asides and the collapsed table of contents.</p>
      </div>
    </div>

    <h3 class="mt-14 text-[0.9375rem] font-semibold text-on-surface">Ruled panel · <code>.ruled-panel</code></h3>
    <div class="ruled-panel mt-4">
      <div class="ruled-grid md:grid-cols-3">
        <div class="ruled-cell p-6">
          <p class="meta-label">Static cell</p>
          <p class="mt-2 text-body-sm leading-relaxed text-on-surface-variant">Hairline cells inside one soft frame. No hover on content that isn't clickable.</p>
        </div>
        <div class="ruled-cell is-interactive p-6">
          <p class="meta-label"><code>.is-interactive</code></p>
          <p class="mt-2 text-body-sm leading-relaxed text-on-surface-variant">Fills softly on hover. Work cards and prev/next links.</p>
        </div>
        <div class="ruled-cell is-interactive dot-reveal p-6">
          <p class="meta-label"><code>.dot-reveal</code></p>
          <p class="mt-2 text-body-sm leading-relaxed text-on-surface-variant">Fades a dot matrix in from the corner. Playful cells only.</p>
        </div>
      </div>
    </div>

    <div class="mt-10 grid gap-10 lg:grid-cols-2">
      <div>
        <h3 class="text-[0.9375rem] font-semibold text-on-surface">Ruled list · <code>.ruled-list</code></h3>
        <div class="ruled-list mt-4">
          <div class="p-5 text-body-sm text-on-surface-variant">Rows split by hairlines, with a soft fill on hover.</div>
          <div class="p-5 text-body-sm text-on-surface-variant">Used for the post list.</div>
        </div>
      </div>
      <div>
        <h3 class="text-[0.9375rem] font-semibold text-on-surface">Portrait frame · <code>.ticked-frame</code></h3>
        <div class="ticked-frame mt-4 max-w-xs overflow-hidden">
          <div class="grid aspect-[4/3] place-items-center bg-surface-container text-caption text-on-surface-variant">Photo</div>
        </div>
        <p class="mt-3 text-body-sm text-on-surface-variant">28px corners and a long soft shadow, no mat.</p>
      </div>
    </div>

    <div class="mt-10 grid gap-10 lg:grid-cols-2">
      <div>
        <h3 class="text-[0.9375rem] font-semibold text-on-surface">Back link · <code>BackLink</code></h3>
        <div class="mt-3"><BackLink href="#main" label="Writing" /></div>
        <p class="mt-2 text-body-sm text-on-surface-variant">Top of every detail page, like an app's back button.</p>
      </div>
      <div>
        <h3 class="text-[0.9375rem] font-semibold text-on-surface">Icon button · <code>.g-icon-btn</code></h3>
        <div class="mt-3 flex gap-2">
          <button class="g-icon-btn" type="button" aria-label="Search"><Icon name="search" size={18} /></button>
          <button class="g-icon-btn" type="button" aria-label="Back"><Icon name="chevronLeft" size={18} /></button>
        </div>
        <p class="mt-2 text-body-sm text-on-surface-variant">Round toolbar buttons in the header and the game player.</p>
      </div>
    </div>

    <h3 class="mt-14 text-[0.9375rem] font-semibold text-on-surface">Signal block · <code>.signal-block</code></h3>
  </Section>

  <section class="signal-block">
    <div class="wrap relative py-14 text-center md:py-20">
      <p class="text-[0.9375rem] font-semibold">Let's connect</p>
      <p class="mx-auto mt-2 max-w-2xl text-h2 font-semibold leading-[1.1] tracking-[-0.03em]">The one call to action on a page</p>
      <p class="mx-auto mt-4 max-w-xl text-body-lg text-on-signal-block/80">A full-bleed amber band. Pair it with <code>.btn-ink</code> and an optional <code>.ticker</code>.</p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <button class="btn btn-ink" type="button">Ink button</button>
        <button class="btn btn-tonal" type="button">Tonal</button>
      </div>
    </div>
  </section>

  <!-- Trust -->
  <Section alt kicker="Trust and products" title="Proof, products, and a byline" lead="The components that do the persuading. They only work if what's inside them is real: a live product, a checkable number, a quote someone actually said.">
    <div class="mt-10 grid gap-6 lg:grid-cols-[1.2fr_1fr]">
      <ProductCard product={products[0]} />

      <div class="space-y-6">
        <div class="surface p-6">
          <h3 class="text-[0.9375rem] font-semibold text-on-surface">Status pill</h3>
          <div class="mt-4 flex flex-wrap gap-2">
            <span class="status-pill" data-status="live">Live</span>
            <span class="status-pill" data-status="beta">Beta</span>
            <span class="status-pill" data-status="research">Research</span>
            <span class="status-pill" data-status="archived">Archived</span>
          </div>
          <p class="mt-4 text-body-sm text-on-surface-variant">Only <em>Live</em> uses sage: you can use it today, and it works.</p>
        </div>
        <div class="surface p-6">
          <h3 class="text-[0.9375rem] font-semibold text-on-surface">Receipt</h3>
          <p class="receipt-value mt-4">11 citations</p>
          <p class="mt-1 text-body-sm text-on-surface-variant">for an undergraduate sign-language project</p>
          <a href="/blog/an-unexpected-email-and-11-citations" class="receipt-source mt-2">Source: the story →</a>
        </div>
      </div>
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-2">
      <ProofQuote quote={quotes[0]} />
      <div class="flex flex-col justify-center">
        <AuthorCard class="" />
      </div>
    </div>
  </Section>

  <!-- Games -->
  <Section kicker="Games" title="The arcade's own kit" lead="The games leave the page on purpose and feel like a native app. Their primitives live in games.css as .g-* classes, under a .g-root.">
    <div class="g-root mt-10 grid gap-6 lg:grid-cols-[1.3fr_1fr]">
      <div class="g-tray p-6 md:p-8">
        <p class="g-eyebrow">vs. the solver</p>
        <p class="g-title mt-1">The tray is what you play on</p>
        <div class="g-stats mt-6">
          <div><p class="g-stat-value">212<span class="text-[0.6em]"> ms</span></p><p class="g-stat-label">Median</p></div>
          <div><p class="g-stat-value">7</p><p class="g-stat-label">Rounds</p></div>
          <div><p class="g-stat-value">4/5</p><p class="g-stat-label">Correct</p></div>
        </div>
        <p class="g-status mt-6">Your move. Pick a column.</p>
        <div class="mt-6 flex flex-wrap gap-2">
          <button class="g-btn" type="button">New game</button>
          <button class="g-btn g-btn-tonal" type="button">Hint</button>
          <button class="g-btn g-btn-plain" type="button">How to play</button>
        </div>
      </div>

      <div class="g-card space-y-5 p-6">
        <div class="g-seg" role="group" aria-label="Example difficulty">
          <button class="g-seg-btn" type="button" aria-pressed="false" data-demo-seg>Easy</button>
          <button class="g-seg-btn" type="button" aria-pressed="true" data-demo-seg>Fair</button>
          <button class="g-seg-btn" type="button" aria-pressed="false" data-demo-seg>Hard</button>
        </div>
        <label class="flex items-center justify-between gap-4">
          <span class="text-body-sm font-medium text-on-surface">Show the bot's plan</span>
          <input type="checkbox" class="g-switch" checked />
        </label>
        <label class="block">
          <span class="text-body-sm font-medium text-on-surface">Neighbours</span>
          <input type="range" min="1" max="15" value="6" class="g-range mt-3" data-demo-range />
        </label>
        <div class="flex flex-wrap gap-1.5">
          <span class="g-tag">Tag</span>
          <span class="g-tag g-tag-accent">Accent</span>
          <span class="g-tag g-tag-good">Correct</span>
          <span class="g-tag g-tag-bad">Wrong</span>
        </div>
        <p class="g-note">Press <kbd class="g-kbd">Space</kbd> to drop. No mono kickers, ticks or ruled grids inside a game.</p>
      </div>
    </div>
  </Section>

  <!-- Prose -->
  <Section alt kicker="Long-form" title="Prose">
    <div class="prose mt-10 max-w-3xl">
      <p>Articles use <code>.prose</code>: Newsreader at 19px with a 1.7 line height, and amber <a href="#main">links</a> with a soft underline.</p>
      <h2>Headings are sans</h2>
      <p>Section headings switch to the interface face, tight and semibold, so a long post scans like the rest of the site.</p>
      <blockquote>Quotes are the voice turned up: larger italic serif, a thin amber rule, no box.</blockquote>
      <ul>
        <li>List markers pick up the primary colour.</li>
        <li><strong>Bold</strong> stays on-surface so it reads as weight, not colour.</li>
      </ul>
      <pre><code>// Code blocks and figures sit on 16px corners with a hairline ring.</code></pre>
      <table>
        <thead><tr><th>Element</th><th>Treatment</th></tr></thead>
        <tbody>
          <tr><td>Tables</td><td>Horizontal hairlines only</td></tr>
          <tr><td>Captions</td><td>Centred sans</td></tr>
        </tbody>
      </table>
    </div>
  </Section>
</Base>

<style>
  .swatch {
    box-shadow: inset 0 0 0 1px var(--md-comp-card-border);
  }
  .swatch > :first-child {
    box-shadow: inset 0 -1px 0 var(--md-comp-card-border);
  }
</style>

<script>
  // Demo controls: make the segmented examples and the slider behave like the real ones.
  for (const group of document.querySelectorAll<HTMLElement>('[role="group"]')) {
    const buttons = group.querySelectorAll<HTMLButtonElement>('[data-demo-seg]');
    buttons.forEach((b) =>
      b.addEventListener('click', () => buttons.forEach((o) => o.setAttribute('aria-pressed', String(o === b)))),
    );
  }
  for (const r of document.querySelectorAll<HTMLInputElement>('[data-demo-range]')) {
    const sync = () => r.style.setProperty('--g-range-pct', `${((+r.value - +r.min) / (+r.max - +r.min)) * 100}%`);
    sync();
    r.addEventListener('input', sync);
  }
</script>
