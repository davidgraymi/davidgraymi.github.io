---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { visibleNav } from '~/lib/nav';
import { games } from '~/data/games';

const projects = (await getCollection('work', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({
    id: p.id,
    title: p.data.title,
    subtitle: p.data.blurb,
    href: `/work/${p.id}`,
    category: 'Projects',
    badge: p.data.kind,
    stack: p.data.stack.join(' '),
  }));

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((b) => ({
    id: b.id,
    title: b.data.title,
    subtitle: b.data.description,
    href: `/blog/${b.id}`,
    category: 'Writing',
    badge: 'Post',
    stack: b.data.tags.join(' '),
  }));

const gameItems = games.map((g) => ({
  id: `game-${g.slug}`,
  title: g.title,
  subtitle: g.blurb,
  href: `/play/${g.slug}`,
  category: 'Games',
  badge: 'Game',
  stack: g.opponent,
}));

const navHrefs = new Set((await visibleNav()).map((item) => item.href));
const pages = [
  { id: 'nav-home', title: 'Home', subtitle: 'Main landing page & highlights', href: '/', category: 'Navigation', badge: 'Page' },
  { id: 'nav-work', title: 'Work', subtitle: 'All engineering projects & case studies', href: '/work', category: 'Navigation', badge: 'Page' },
  { id: 'nav-writing', title: 'Writing', subtitle: 'Technical notes & engineering articles', href: '/blog', category: 'Navigation', badge: 'Page' },
  { id: 'nav-games', title: 'Games', subtitle: 'Browser games, several against real models', href: '/play', category: 'Navigation', badge: 'Page' },
  { id: 'nav-photos', title: 'Photos', subtitle: 'Photography & outdoor expeditions', href: '/photos', category: 'Navigation', badge: 'Page' },
  { id: 'nav-about', title: 'About', subtitle: 'Background, career timeline & skills', href: '/about', category: 'Navigation', badge: 'Page' },
  { id: 'nav-contact', title: 'Contact', subtitle: 'Email, inquiries & consultation', href: '/contact', category: 'Navigation', badge: 'Page' },
].filter((page) => page.href === '/' || navHrefs.has(page.href));

const actions = [
  { id: 'action-copy-email', title: 'Copy Email Address', subtitle: 'davidgraymi@gmail.com', action: 'copy-email', category: 'Actions', badge: 'Action' },
  { id: 'action-theme', title: 'Toggle Light / Dark Theme', subtitle: 'Switch color theme', action: 'toggle-theme', category: 'Actions', badge: 'Action' },
  { id: 'action-resume', title: 'Resume', subtitle: 'Web page, with a PDF download', href: '/resume', category: 'Actions', badge: 'Read' },
  { id: 'action-github', title: 'Visit GitHub', subtitle: 'github.com/davidgraymi', href: 'https://github.com/davidgraymi', category: 'Actions', badge: 'External' },
  { id: 'action-linkedin', title: 'Visit LinkedIn', subtitle: 'linkedin.com/in/david-gray-mi', href: 'https://www.linkedin.com/in/david-gray-mi/', category: 'Actions', badge: 'External' },
];

const allItems = [...pages, ...actions, ...gameItems, ...projects, ...posts];
---

<dialog id="command-palette" class="spotlight z-[100] w-[92vw] max-w-[40rem] p-0 text-on-surface" aria-label="Search the site">
  <div class="flex flex-col">
    {/* Search field */}
    <div class="flex items-center gap-3 px-5 py-4">
      <span class="text-on-surface-variant">
        <Icon name="search" size={22} />
      </span>
      <input
        id="command-search"
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-controls="command-results"
        aria-autocomplete="list"
        placeholder="Search pages, projects and posts"
        aria-label="Search the site"
        autocomplete="off"
        spellcheck="false"
        class="w-full bg-transparent text-[1.375rem] font-normal tracking-[-0.015em] outline-none placeholder:text-on-surface-variant/70 text-on-surface"
      />
      <kbd class="g-kbd pointer-coarse:hidden">esc</kbd>
    </div>

    {/* Results */}
    <div id="command-results" role="listbox" aria-label="Results" class="spotlight-results max-h-[min(60vh,28rem)] overflow-y-auto p-2">
      {
        allItems.map((item, index) => (
          <div
            id={`command-item-${index}`}
            role="option"
            aria-selected="false"
            class="command-item flex cursor-pointer items-center justify-between gap-3 rounded-xl px-3.5 py-2.5"
            data-index={index}
            data-title={item.title.toLowerCase()}
            data-subtitle={item.subtitle.toLowerCase()}
            data-category={item.category.toLowerCase()}
            data-stack={(item as any).stack?.toLowerCase() || ''}
            data-href={(item as any).href || ''}
            data-action={(item as any).action || ''}
            tabindex="-1"
          >
            <div class="min-w-0">
              <p class="command-title truncate text-[0.9375rem] font-medium">{item.title}</p>
              <p class="command-sub truncate text-[0.8125rem] text-on-surface-variant">{item.subtitle}</p>
            </div>
            <span class="command-badge shrink-0 rounded-full px-2.5 py-0.5 text-[0.75rem] font-medium">{item.badge}</span>
          </div>
        ))
      }
      <div id="command-empty" class="hidden py-14 text-center text-[0.9375rem] text-on-surface-variant">
        No results. Try a project, a post or “theme”.
      </div>
    </div>

    {/* Shortcuts */}
    <div class="spotlight-foot flex items-center justify-between px-5 py-2.5 text-[0.75rem] text-on-surface-variant pointer-coarse:hidden">
      <span class="flex items-center gap-3">
        <span><kbd class="g-kbd">↑</kbd> <kbd class="g-kbd">↓</kbd> to move</span>
        <span><kbd class="g-kbd">↵</kbd> to open</span>
      </span>
      <span><kbd class="g-kbd">esc</kbd> to close</span>
    </div>
  </div>
</dialog>

<p id="command-toast" class="command-toast" role="status" aria-live="polite"></p>

<style>
  /* Spotlight: a frosted panel that drops in high on the screen. */
  .spotlight {
    position: fixed;
    inset: 14vh 0 auto;
    margin-inline: auto;
    overflow: hidden;
    border-radius: 1.375rem;
    background: color-mix(in srgb, var(--md-sys-color-surface-container-low) 86%, transparent);
    -webkit-backdrop-filter: saturate(180%) blur(30px);
    backdrop-filter: saturate(180%) blur(30px);
    box-shadow:
      0 0 0 0.5px var(--g-hair),
      0 40px 80px -20px rgb(0 0 0 / 0.45),
      0 4px 12px rgb(0 0 0 / 0.1);
  }
  .spotlight[open] {
    animation: spotlight-in 360ms var(--g-ease) both;
  }
  .spotlight::backdrop {
    background: rgb(0 0 0 / 0.28);
  }
  @keyframes spotlight-in {
    from {
      opacity: 0;
      transform: translateY(-10px) scale(0.98);
    }
  }
  .spotlight-results {
    box-shadow: inset 0 0.5px 0 var(--g-hair);
  }
  .spotlight-foot {
    box-shadow: inset 0 0.5px 0 var(--g-hair);
  }

  .command-item {
    transition: background-color 120ms var(--g-ease);
  }
  .command-item:hover {
    background: var(--g-fill);
  }
  .command-badge {
    background: var(--g-fill);
    color: var(--md-sys-color-on-surface-variant);
  }
  /* The selected row fills with the signal colour, like Spotlight's. */
  .command-item.active {
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
  }
  .command-item.active .command-sub,
  .command-item.active .command-badge {
    color: color-mix(in srgb, var(--md-sys-color-on-primary) 80%, transparent);
  }
  .command-item.active .command-badge {
    background: color-mix(in srgb, var(--md-sys-color-on-primary) 14%, transparent);
  }

  /* Small confirmation that floats up from the bottom (replaces alert()). */
  .command-toast {
    position: fixed;
    left: 50%;
    bottom: 2rem;
    z-index: 110;
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--md-sys-color-inverse-surface, var(--md-sys-color-on-surface)) 92%, transparent);
    color: var(--md-sys-color-inverse-on-surface, var(--md-sys-color-surface));
    font-size: 0.875rem;
    font-weight: 500;
    box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.4);
    opacity: 0;
    transform: translate(-50%, 12px);
    pointer-events: none;
    transition:
      opacity 260ms var(--g-ease),
      transform 360ms var(--g-ease);
  }
  .command-toast[data-show] {
    opacity: 1;
    transform: translate(-50%, 0);
  }
</style>

<script>
  import { track } from '~/lib/track';

  const dialog = document.getElementById('command-palette') as HTMLDialogElement | null;
  const searchInput = document.getElementById('command-search') as HTMLInputElement | null;
  const items = Array.from(document.querySelectorAll('.command-item')) as HTMLElement[];
  const emptyState = document.getElementById('command-empty');
  let activeIndex = 0;

  function openPalette() {
    if (!dialog) return;
    dialog.showModal();
    track('palette_open');
    if (searchInput) {
      searchInput.value = '';
      searchInput.focus();
    }
    filterItems('');
  }

  function closePalette() {
    if (!dialog) return;
    dialog.close();
  }

  function getVisibleItems() {
    return items.filter((item) => !item.classList.contains('hidden'));
  }

  function setActive(newIndex: number) {
    const visible = getVisibleItems();
    if (visible.length === 0) return;
    visible.forEach((item) => {
      item.classList.remove('active');
      item.setAttribute('aria-selected', 'false');
    });
    activeIndex = Math.max(0, Math.min(newIndex, visible.length - 1));
    const activeItem = visible[activeIndex];
    if (activeItem) {
      activeItem.classList.add('active');
      activeItem.setAttribute('aria-selected', 'true');
      searchInput?.setAttribute('aria-activedescendant', activeItem.id);
      activeItem.scrollIntoView({ block: 'nearest' });
    }
  }

  function executeItem(item: HTMLElement) {
    const href = item.getAttribute('data-href');
    const action = item.getAttribute('data-action');
    // What people typed, and what they picked from it.
    const term = searchInput?.value.trim();
    if (term) track('search', { search_term: term, result: item.getAttribute('data-title') ?? '' });

    closePalette();

    if (action === 'copy-email') {
      track('contact_email', { method: 'palette' });
      navigator.clipboard.writeText('davidgraymi@gmail.com');
      const toast = document.getElementById('command-toast');
      if (toast) {
        toast.textContent = 'Email address copied';
        toast.setAttribute('data-show', '');
        setTimeout(() => toast.removeAttribute('data-show'), 2400);
      }
      return;
    }

    if (action === 'toggle-theme') {
      const root = document.documentElement;
      const current = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = current;
      try { localStorage.setItem('theme', current); } catch {}
      return;
    }

    if (href) {
      if (href.startsWith('http')) {
        window.open(href, '_blank', 'noopener,noreferrer');
      } else {
        window.location.href = href;
      }
    }
  }

  function filterItems(query: string) {
    const q = query.toLowerCase().trim();
    let matchCount = 0;

    items.forEach((item) => {
      const title = item.getAttribute('data-title') || '';
      const subtitle = item.getAttribute('data-subtitle') || '';
      const category = item.getAttribute('data-category') || '';
      const stack = item.getAttribute('data-stack') || '';

      const match = !q || title.includes(q) || subtitle.includes(q) || category.includes(q) || stack.includes(q);
      if (match) {
        item.classList.remove('hidden');
        matchCount++;
      } else {
        item.classList.add('hidden');
      }
    });

    if (emptyState) {
      emptyState.classList.toggle('hidden', matchCount > 0);
    }

    setActive(0);
  }

  // Keyboard shortcut listener: Cmd+K / Ctrl+K / slash
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (dialog?.open) {
        closePalette();
      } else {
        openPalette();
      }
      return;
    }

    if (e.key === '/' && !dialog?.open) {
      const activeTag = document.activeElement?.tagName;
      if (activeTag !== 'INPUT' && activeTag !== 'TEXTAREA') {
        e.preventDefault();
        openPalette();
      }
    }
  });

  // Modal keyboard navigation
  dialog?.addEventListener('keydown', (e) => {
    const visible = getVisibleItems();
    if (visible.length === 0) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setActive(activeIndex + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setActive(activeIndex - 1);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      const current = visible[activeIndex];
      if (current) executeItem(current);
    }
  });

  // Close when clicking backdrop
  dialog?.addEventListener('click', (e) => {
    const rect = dialog.getBoundingClientRect();
    const inDialog =
      rect.top <= e.clientY &&
      e.clientY <= rect.top + rect.height &&
      rect.left <= e.clientX &&
      e.clientX <= rect.left + rect.width;
    if (!inDialog) {
      closePalette();
    }
  });

  // Search input typing
  searchInput?.addEventListener('input', (e) => {
    filterItems((e.target as HTMLInputElement).value);
  });

  // Item click
  items.forEach((item) => {
    item.addEventListener('click', () => executeItem(item));
    item.addEventListener('mouseenter', () => {
      const visible = getVisibleItems();
      const idx = visible.indexOf(item);
      if (idx !== -1) setActive(idx);
    });
  });

  // Show the shortcut the visitor will actually press.
  const isMac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
  if (!isMac) {
    document.querySelectorAll('[data-shortcut]').forEach((el) => {
      el.textContent = 'Ctrl K';
    });
  }

  // Buttons elsewhere (the footer) open it without an inline onclick, which the CSP blocks.
  document.querySelectorAll('[data-open-palette]').forEach((el) => el.addEventListener('click', () => openPalette()));

  // Expose global trigger for other components (like header button)
  (window as any).openCommandPalette = openPalette;
</script>
