---
interface Props {
  kicker: string;
  title: string;
  lead?: string;
}
const { kicker, title, lead } = Astro.props;
---

<section class="dot-field border-b border-outline-variant">
  <div class="wrap py-16 md:py-22">
    <p class="kicker">{kicker}</p>
    <h1 class="mt-5 max-w-3xl font-semibold tracking-tight text-h1 text-on-surface">{title}</h1>
    {
      lead && (
        <p class="mt-5 max-w-2xl text-title-sm leading-relaxed text-on-surface-variant">
          {lead}
        </p>
      )
    }
    <slot />
  </div>
</section>
