---
interface Props {
  kicker: string;
  title: string;
  lead?: string;
}
const { kicker, title, lead } = Astro.props;
---

<section>
  <div class="wrap pt-16 pb-10 md:pt-24 md:pb-14" data-reveal>
    <p class="kicker">{kicker}</p>
    <h1 class="mt-2 max-w-4xl text-[clamp(2.5rem,7vw,4.5rem)] leading-[1.03] font-semibold tracking-[-0.04em] text-on-surface">{title}</h1>
    {
      lead && (
        <p class="mt-5 max-w-2xl text-[clamp(1.0625rem,2vw,1.3125rem)] leading-relaxed text-on-surface-variant">
          {lead}
        </p>
      )
    }
    <slot />
  </div>
</section>
