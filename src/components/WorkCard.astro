---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  entry: CollectionEntry<'work'>;
}
const { entry } = Astro.props;
const { title, blurb, kind, category, year, stack, highlight, cover, coverAlt } = entry.data;
---

<article
  class="spotlight-card group relative flex flex-col"
  data-category={category}
  data-kind={kind.toLowerCase()}
  data-stack={stack.join(' ').toLowerCase()}
>
  {
    cover && (
      <div
        class="aspect-[16/9] overflow-hidden border-b border-outline-variant bg-surface-container"
      >
        <Image
          src={cover}
          alt={coverAlt}
          widths={[480, 800]}
          sizes="(min-width: 768px) 40vw, 92vw"
          class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
          loading="lazy"
        />
      </div>
    )
  }

  <div class="flex flex-1 flex-col p-6 sm:p-7">
    {/* Header / Meta: M3 Expressive Assist Chip */}
    <div
      class="flex items-center justify-between gap-3 font-mono text-label uppercase tracking-[0.12em] text-on-surface-variant"
    >
      <div class="flex items-center gap-2">
        <span>{kind}</span>
        <span aria-hidden="true" class="opacity-50">·</span>
        <span>{year}</span>
      </div>
      {entry.id === 'wordlet' && (
        <span
          class="inline-flex items-center gap-1 rounded-md px-2.5 py-0.5 text-label font-semibold bg-primary-container text-on-primary-container"
        >
          Playable
        </span>
      )}
    </div>

    {/* Title */}
    <h3 class="mt-3.5 text-title font-semibold leading-snug transition-colors duration-200 group-hover:text-primary">
      <a href={`/work/${entry.id}`} class="after:absolute after:inset-0 after:content-['']">
        {title}
      </a>
    </h3>

    {/* Blurb */}
    <p class="mt-2.5 text-body-sm leading-relaxed text-on-surface-variant">
      {blurb}
    </p>

    {/* Highlight Metric: M3 Tonal Container Badge */}
    {
      highlight && (
        <div
          class="mt-4 flex items-start gap-2.5 rounded-xl border px-3.5 py-2 font-mono text-label leading-snug bg-surface-container border-outline-variant text-on-surface"
        >
          <span
            class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-primary shadow-glow-sm"
          />
          <span class="line-clamp-3 font-medium">{highlight}</span>
        </div>
      )
    }

    {/* Footer: M3 Expressive Chips & Arrow Button */}
    <div class="mt-auto flex flex-wrap items-center gap-1.5 pt-6">
      {
        stack.slice(0, 4).map((tech) => (
          <span
            class="chip py-1 transition-colors group-hover:border-outline"
          >
            {tech}
          </span>
        ))
      }
      <span
        class="ml-auto grid h-7.5 w-7.5 place-items-center rounded-full transition-all duration-200 group-hover:translate-x-0.5 group-hover:text-primary text-on-surface-variant bg-surface-container-high"
      >
        <Icon name="arrow" size={16} />
      </span>
    </div>
  </div>
</article>
