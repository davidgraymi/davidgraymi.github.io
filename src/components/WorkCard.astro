---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  entry: CollectionEntry<'work'>;
}
const { entry } = Astro.props;
const { title, blurb, kind, year, stack, highlight, cover, coverAlt } = entry.data;

// Categorization helper for filtering
let category = 'tools';
const lower = (kind + ' ' + stack.join(' ') + ' ' + title).toLowerCase();
if (lower.includes('real-time') || lower.includes('bare metal') || lower.includes('rtos') || lower.includes('kernel') || lower.includes('ada')) {
  category = 'embedded';
} else if (lower.includes('ml') || lower.includes('ai') || lower.includes('gesture') || lower.includes('classifier') || lower.includes('rl') || lower.includes('id3') || lower.includes('knn')) {
  category = 'ai';
}
---

<article
  class="spotlight-card group relative flex flex-col"
  data-category={category}
  data-kind={kind.toLowerCase()}
  data-stack={stack.join(' ').toLowerCase()}
>
  {
    cover && (
      <div
        class="aspect-[16/9] overflow-hidden border-b"
        style="border-color: var(--md-sys-color-outline-variant); background: var(--md-sys-color-surface-container)"
      >
        <Image
          src={cover}
          alt={coverAlt}
          widths={[480, 800]}
          sizes="(min-width: 768px) 40vw, 92vw"
          class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
          loading="lazy"
        />
      </div>
    )
  }

  <div class="flex flex-1 flex-col p-6 sm:p-7">
    {/* Header / Meta: M3 Expressive Assist Chip */}
    <div
      class="flex items-center justify-between gap-3 font-mono text-[11.5px] uppercase tracking-[0.12em]"
      style="color: var(--md-sys-color-on-surface-variant)"
    >
      <div class="flex items-center gap-2">
        <span>{kind}</span>
        <span aria-hidden="true" class="opacity-50">·</span>
        <span>{year}</span>
      </div>
      {entry.id === 'wordlet' && (
        <span
          class="inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-[10.5px] font-semibold"
          style="background: var(--md-sys-color-secondary-container); color: var(--md-sys-color-on-secondary-container);"
        >
          Playable
        </span>
      )}
    </div>

    {/* Title */}
    <h3 class="mt-3.5 text-[20px] font-semibold leading-snug transition-colors duration-200 group-hover:text-[var(--md-sys-color-primary)]">
      <a href={`/work/${entry.id}`} class="after:absolute after:inset-0 after:content-['']">
        {title}
      </a>
    </h3>

    {/* Blurb */}
    <p class="mt-2.5 text-[14.5px] leading-relaxed" style="color: var(--md-sys-color-on-surface-variant)">
      {blurb}
    </p>

    {/* Highlight Metric: M3 Tonal Container Badge */}
    {
      highlight && (
        <div
          class="mt-4 flex items-center gap-2.5 rounded-xl border px-3.5 py-2 font-mono text-[12.5px]"
          style="background: var(--md-sys-color-surface-container); border-color: var(--md-sys-color-outline-variant); color: var(--md-sys-color-on-surface);"
        >
          <span
            class="h-2 w-2 rounded-full"
            style="background: var(--md-sys-color-primary); box-shadow: 0 0 8px var(--md-sys-color-primary);"
          />
          <span class="truncate font-medium">{highlight}</span>
        </div>
      )
    }

    {/* Footer: M3 Expressive Chips & Arrow Button */}
    <div class="mt-auto flex flex-wrap items-center gap-1.5 pt-6">
      {
        stack.slice(0, 4).map((tech) => (
          <span
            class="rounded-lg border px-2.5 py-1 font-mono text-[11px] transition-colors group-hover:border-[var(--md-sys-color-outline)]"
            style="background: var(--md-sys-color-surface-container); border-color: var(--md-sys-color-outline-variant); color: var(--md-sys-color-on-surface-variant)"
          >
            {tech}
          </span>
        ))
      }
      <span
        class="ml-auto grid h-7.5 w-7.5 place-items-center rounded-full transition-all duration-200 group-hover:translate-x-0.5 group-hover:translate-y--0.5 group-hover:text-[var(--md-sys-color-primary)]"
        style="color: var(--md-sys-color-on-surface-variant); background: var(--md-sys-color-surface-container-high);"
      >
        <Icon name="arrowUpRight" size={16} />
      </span>
    </div>
  </div>
</article>
