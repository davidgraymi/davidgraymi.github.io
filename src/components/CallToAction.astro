---
import { site } from '~/site.config';
import Icon from './Icon.astro';
import CopyEmail from './CopyEmail.astro';

interface Props {
  title?: string;
  body?: string;
}
const {
  title = 'Have something hard that has to work?',
  body = "Contract work, a full-time role, or a problem you want a second opinion on — I read every message and reply to the ones that aren't a template.",
} = Astro.props;

/** Ticker under the block: the work and the rest of it, on one strip. */
const ticker = [
  'Threat models',
  'Scuba diving',
  'Kubernetes',
  'Video games',
  'Applied ML',
  'Rock climbing',
  'Making art',
  'Hiking',
];
---

<section class="signal-block mt-20 md:mt-28">
  <div class="wrap relative py-16 text-center md:py-24">
    <p class="font-mono text-label font-semibold uppercase tracking-[0.14em]">Let's connect</p>
    <h2 class="mx-auto mt-5 max-w-3xl font-semibold leading-tight text-h2">{title}</h2>
    <p class="mx-auto mt-4 max-w-xl text-body-lg leading-relaxed text-on-signal-block/80">
      {body}
    </p>

    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href={`mailto:${site.email}`} class="btn btn-ink w-full sm:w-auto">
        <Icon name="mail" size={17} />
        Email me
      </a>
      <CopyEmail class="w-full sm:w-auto" />
    </div>

    <p class="mt-6 font-mono text-label text-on-signal-block/75">
      Usually replies within a day or two · {site.location}
    </p>
  </div>

  <div class="ticker relative font-mono text-caption" aria-hidden="true">
    {
      [0, 1].map(() => (
        <div class="ticker-track">
          {ticker.map((item) => (
            <span class="inline-flex items-center gap-2.5 whitespace-nowrap">
              <span class="h-1.5 w-1.5 rotate-45 bg-on-signal-block" />
              {item}
            </span>
          ))}
        </div>
      ))
    }
  </div>
</section>
