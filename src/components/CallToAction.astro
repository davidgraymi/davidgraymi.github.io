---
import { site } from '~/site.config';
import Icon from './Icon.astro';
import CopyEmail from './CopyEmail.astro';

interface Props {
  title?: string;
  body?: string;
}
const {
  title = 'Have something hard that has to work?',
  body = "Contract work, a full-time role, or a problem you want a second opinion on — I read every message and reply to the ones that aren't a template.",
} = Astro.props;
---

<section class="border-t" style="background: var(--bg-surface)">
  <div class="wrap py-16 md:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <p class="kicker justify-center">Let's talk</p>
      <h2 class="mt-5 font-semibold" style="font-size: var(--text-h2)">{title}</h2>
      <p class="mx-auto mt-4 max-w-xl text-[17px] leading-relaxed" style="color: var(--fg-muted)">
        {body}
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={`mailto:${site.email}`} class="btn btn-primary w-full sm:w-auto">
          <Icon name="mail" size={17} />
          Email me
        </a>
        <CopyEmail class="w-full sm:w-auto" />
      </div>
      <p class="mt-6 font-mono text-[12.5px]" style="color: var(--fg-muted)">
        Usually replies within a day or two · {site.location}
      </p>
    </div>
  </div>
</section>
