---
import { site } from '~/site.config';
import Icon from './Icon.astro';
import CopyEmail from './CopyEmail.astro';

interface Props {
  title?: string;
  body?: string;
}
const {
  title = 'Have something hard that has to work?',
  body = "Contract work, a full-time role, or a problem you want a second opinion on — I read every message and reply to the ones that aren't a template.",
} = Astro.props;
---

<section class="border-t py-20 md:py-28" style="border-color: var(--md-sys-color-outline-variant);">
  <div class="wrap">
    <div
      class="glass-panel relative mx-auto max-w-4xl overflow-hidden rounded-[32px] p-8 text-center sm:p-14"
      style="background: var(--md-sys-color-surface-container-low); border-color: var(--md-sys-color-outline-variant);"
    >
      {/* Background glow accent: M3 Primary & Tertiary Glow */}
      <div
        class="pointer-events-none absolute -top-24 left-1/2 -z-10 h-52 w-96 -translate-x-1/2 rounded-full opacity-35 blur-3xl"
        style="background: radial-gradient(circle, var(--md-sys-color-primary) 0%, var(--md-sys-color-tertiary) 70%, transparent 100%);"
      />

      <p class="kicker justify-center">Let's connect</p>
      <h2 class="mt-5 font-semibold leading-tight" style="font-size: var(--text-h2); color: var(--md-sys-color-on-surface);">{title}</h2>
      <p class="mx-auto mt-4 max-w-xl text-[17px] leading-relaxed" style="color: var(--md-sys-color-on-surface-variant)">
        {body}
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={`mailto:${site.email}`} class="btn btn-primary w-full sm:w-auto">
          <Icon name="mail" size={17} />
          Email me
        </a>
        <CopyEmail class="w-full sm:w-auto" />
      </div>

      <p class="mt-6 font-mono text-[12.5px]" style="color: var(--md-sys-color-on-surface-variant)">
        Usually replies within 24 hours · {site.location}
      </p>
    </div>
  </div>
</section>
