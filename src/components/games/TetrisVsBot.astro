---
/**
 * "Beat the bot" — Tetris against the trained agent from the Tetris RL project.
 * Static markup only; the game code (and the network's weights) load with a
 * dynamic import when the panel scrolls into view.
 */
const boards = [
  { side: 'human', name: 'You', label: 'Your board' },
  { side: 'bot', name: 'Agent', label: "The agent's board" },
] as const;

const pad = [
  { action: 'left', label: 'Move left', glyph: '←' },
  { action: 'ccw', label: 'Rotate anticlockwise', glyph: '↺' },
  { action: 'cw', label: 'Rotate clockwise', glyph: '↻' },
  { action: 'right', label: 'Move right', glyph: '→' },
  { action: 'soft', label: 'Soft drop', glyph: '↓' },
  { action: 'drop', label: 'Hard drop', glyph: '⤓' },
] as const;

const speeds = [
  { id: 'relaxed', label: 'Relaxed' },
  { id: 'even', label: 'Even' },
  { id: 'flat', label: 'Flat out' },
];
---

<section class="g-root not-prose my-10" data-tvb aria-labelledby="tvb-title">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h2 id="tvb-title" class="g-title">Beat the bot</h2>
      <p class="g-note mt-0.5 text-[0.9375rem]">Same pieces, two minutes, most lines wins.</p>
    </div>
    <div class="flex flex-col items-end gap-2.5 max-sm:items-start">
      <div class="g-seg" role="group" aria-label="Agent speed">
        {
          speeds.map((s) => (
            <button
              type="button"
              class:list={['g-seg-btn', s.id === 'even' && 'active']}
              data-tvb-speed={s.id}
              aria-pressed={s.id === 'even' ? 'true' : 'false'}
            >
              {s.label}
            </button>
          ))
        }
      </div>
      <label class="flex cursor-pointer items-center gap-2.5 text-[0.8125rem] text-on-surface-variant">
        Show the agent's chosen placement
        <input type="checkbox" class="g-switch" data-tvb-plan checked />
      </label>
    </div>
  </div>

  <dl class="g-card g-stats mt-5 px-4 py-4">
    <div>
      <dt class="g-stat-label">You</dt>
      <dd class="g-stat-value text-primary" data-tvb-stat="human-lines">0</dd>
      <dd class="g-num text-[0.75rem] text-on-surface-variant">
        <span class="max-sm:sr-only">lines · </span><span data-tvb-stat="human-score">0</span> pts
      </dd>
    </div>
    <div>
      <dt class="g-stat-label">Clock</dt>
      <dd class="g-stat-value" data-tvb-stat="clock">2:00</dd>
      <dd class="text-[0.75rem] text-on-surface-variant" data-tvb-stat="lead">Level</dd>
    </div>
    <div>
      <dt class="g-stat-label">Agent</dt>
      <dd class="g-stat-value text-secondary" data-tvb-stat="bot-lines">0</dd>
      <dd class="g-num text-[0.75rem] text-on-surface-variant">
        <span class="max-sm:sr-only">lines · </span><span data-tvb-stat="bot-score">0</span> pts
      </dd>
    </div>
  </dl>

  <div
    class="g-tray relative mt-5 grid grid-cols-2 gap-3 p-3 sm:gap-6 sm:p-6"
    tabindex="0"
    role="application"
    aria-roledescription="game"
    aria-label="Tetris against the agent. Arrow keys move and rotate, Space hard-drops, P pauses."
    aria-describedby="tvb-keys"
    data-tvb-field
  >
    {
      boards.map((b) => (
        <div class="mx-auto w-full max-w-56">
          <div class="mb-2 flex items-center justify-between gap-2 px-1">
            <span class:list={['text-[0.8125rem] font-semibold', b.side === 'human' ? 'text-primary' : 'text-secondary']}>
              {b.name}
            </span>
            {b.side === 'bot' && (
              <span class="g-num text-[0.75rem] text-on-surface-variant max-sm:hidden" title="The network's value estimate for the placement it chose">
                V̂ <span data-tvb-stat="bot-value">—</span>
              </span>
            )}
            <span class="flex items-center gap-1.5 text-[0.75rem] text-on-surface-variant">
              Next
              <canvas class="block h-5 w-10" data-tvb-next={b.side} aria-hidden="true" />
            </span>
          </div>
          <div class="g-well rounded-xl">
            <canvas
              class="block aspect-1/2 w-full bg-surface-container-lowest"
              data-tvb-canvas={b.side}
              role="img"
              aria-label={b.label}
            />
            <p
              class="g-tag absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-surface-container-high text-on-surface shadow-elevation-2"
              data-tvb-state={b.side}
              hidden
            >
              Topped out
            </p>
          </div>
        </div>
      ))
    }

    <div class="col-span-2 grid grid-cols-6 gap-1.5 pointer-fine:hidden" aria-label="Touch controls" role="group">
      {
        pad.map((p) => (
          <button type="button" class="g-key h-12 touch-none text-[1.25rem]" data-tvb-pad={p.action} aria-label={p.label}>
            <span aria-hidden="true">{p.glyph}</span>
          </button>
        ))
      }
    </div>

    <div class="g-veil absolute inset-0 z-10 flex flex-col items-center justify-center gap-5 rounded-[inherit] p-6 text-center" data-tvb-overlay>
      <p class="max-w-xs text-[1.375rem] leading-snug font-semibold tracking-[-0.02em] text-on-surface" data-tvb-message>
        Loading the agent…
      </p>
      <button type="button" class="g-btn" data-tvb-start disabled>Start match</button>
      <noscript><p class="g-note">The game needs JavaScript.</p></noscript>
    </div>
  </div>

  <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
    <p id="tvb-keys" class="g-note">
      <kbd class="g-kbd">←</kbd> <kbd class="g-kbd">→</kbd> move · <kbd class="g-kbd">↑</kbd> <kbd class="g-kbd">X</kbd> rotate · <kbd class="g-kbd">Z</kbd> rotate back ·
      <kbd class="g-kbd">↓</kbd> soft drop · <kbd class="g-kbd">Space</kbd> drop · <kbd class="g-kbd">P</kbd> pause
    </p>
    <div class="flex items-center gap-2">
      <span class="g-num text-[0.75rem] text-on-surface-variant">Seed <span data-tvb-seed>-----</span></span>
      <button type="button" class="g-btn g-btn-tonal g-btn-sm" data-tvb-action="pause" aria-pressed="false" disabled>Pause</button>
      <button type="button" class="g-btn g-btn-tonal g-btn-sm" data-tvb-action="restart">Restart</button>
    </div>
  </div>

  <p class="sr-only" aria-live="polite" data-tvb-live></p>

  <!-- Colour probes: the canvas reads its palette from token-backed utilities. -->
  <span class="hidden text-surface-container-lowest" data-tvb-probe="bg"></span>
  <span class="hidden text-rule-soft" data-tvb-probe="grid"></span>
  <span class="hidden text-primary" data-tvb-probe="human"></span>
  <span class="hidden text-secondary" data-tvb-probe="bot"></span>
  <span class="hidden text-on-surface-variant" data-tvb-probe="text"></span>
</section>

<script>
  // Load the game (and the network's weights) only when it's about to be seen.
  document.querySelectorAll<HTMLElement>('[data-tvb]').forEach((root) => {
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        import('~/lib/games/tetris/game').then(({ mount }) => mount(root));
      },
      { rootMargin: '200px' },
    );
    io.observe(root);
  });
</script>
