---
// "Is it poisonous?" — guess edible vs poisonous for a real specimen from the
// UCI Mushroom dataset, then watch the ID3 tree make its call.
//
// The tree is rendered here at build time; the script only loads (and fetches
// the model chunk) once the game scrolls into view, so the rest of the page
// stays static.
import model from '~/lib/games/is-it-poisonous/model.json';
import type { Model } from '~/lib/games/is-it-poisonous/id3';
import Tree from './IsItPoisonousTree.astro';

const { attributes, tree, trainedOn, trainingErrors } = model as unknown as Model;
---

<section class="iip g-root not-prose" data-iip aria-labelledby="iip-title">
  <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-4">
    <div>
      <p class="g-eyebrow" data-iip-specimen-label>Specimen</p>
      <h2 id="iip-title" class="mt-0.5 text-[clamp(1.5rem,4vw,2rem)] leading-tight font-semibold tracking-[-0.025em] text-on-surface">
        Is it poisonous?
      </h2>
    </div>
    <dl class="g-stats gap-6" aria-label="Score">
      <div class="flex flex-col-reverse">
        <dt class="g-stat-label">Score</dt>
        <dd class="g-stat-value text-[1.375rem]" data-iip-score>0 / 0</dd>
      </div>
      <div class="flex flex-col-reverse">
        <dt class="g-stat-label">Streak</dt>
        <dd class="g-stat-value text-[1.375rem] text-primary" data-iip-streak>0</dd>
      </div>
      <div class="flex flex-col-reverse">
        <dt class="g-stat-label">Best</dt>
        <dd class="g-stat-value text-[1.375rem]" data-iip-best>0</dd>
      </div>
    </dl>
  </div>

  <dl class="iip-traits g-tray mt-6 grid grid-cols-2 overflow-hidden sm:grid-cols-3 lg:grid-cols-4" data-iip-traits>
    {
      attributes.map((attr, i) => (
        <div class="iip-trait px-4 py-2.5" data-attr={i}>
          <dt class="text-[0.75rem] font-medium text-on-surface-variant">{attr.name}</dt>
          <dd class="mt-0.5 text-[0.9375rem] font-medium text-on-surface" data-iip-value>—</dd>
        </div>
      ))
    }
  </dl>

  <div class="mt-6 flex flex-wrap items-center justify-center gap-3" data-iip-guess>
    <button type="button" class="iip-choice g-btn" data-iip-choice="e" aria-keyshortcuts="e" disabled>
      Edible
    </button>
    <button type="button" class="iip-choice g-btn" data-iip-choice="p" aria-keyshortcuts="p" disabled>
      Poisonous
    </button>
    <button type="button" class="g-btn" data-iip-next aria-keyshortcuts="n" hidden>
      Next mushroom
    </button>
  </div>
  <p class="g-note mt-3 text-center max-sm:hidden">
    <kbd class="g-kbd">E</kbd> edible · <kbd class="g-kbd">P</kbd> poisonous · <kbd class="g-kbd">N</kbd> next
  </p>

  <div class="mt-6 min-h-12 text-center" aria-live="polite" data-iip-result>
    <noscript>
      <p class="g-note">The game needs JavaScript; the tree below works without it.</p>
    </noscript>
  </div>

  <ol class="iip-path mt-3 flex flex-wrap justify-center gap-2" data-iip-path aria-label="Decision path" hidden></ol>

  <details class="iip-tree g-card mt-8" data-iip-tree>
    <summary class="flex min-h-12 cursor-pointer items-center justify-between gap-3 px-5 py-3 text-[0.875rem] font-medium text-on-surface">
      <span>The whole tree <span class="font-normal text-on-surface-variant">· {trainedOn.toLocaleString('en-US')} training specimens, {trainingErrors} misclassified</span></span>
      <span class="iip-caret text-on-surface-variant" aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 4.5 3 3 3-3"/></svg>
      </span>
    </summary>
    <div class="overflow-x-auto px-3 pb-5">
      <ul class="iip-tree-root" aria-label="ID3 decision tree">
        <Tree node={tree} attributes={attributes} />
      </ul>
    </div>
  </details>

  <p class="g-note mt-5 text-center">
    A toy trained on 23 species of <em>Agaricus</em> and <em>Lepiota</em> from a 1981 field guide. It cannot tell you
    whether the mushroom in your hand is safe — please don't use it for real foraging.
  </p>
</section>

<script>
  import { classify, labelName, type Label, type Model } from '~/lib/games/is-it-poisonous/id3';

  const BEST_KEY = 'iip-best-streak';

  function readBest(): number {
    try {
      return Number(localStorage.getItem(BEST_KEY)) || 0;
    } catch {
      return 0;
    }
  }

  function writeBest(n: number) {
    try {
      localStorage.setItem(BEST_KEY, String(n));
    } catch {
      /* storage blocked: best streak just won't persist */
    }
  }

  function shuffled<T>(items: T[]): T[] {
    const a = items.slice();
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  async function start(root: HTMLElement) {
    const model = (await import('~/lib/games/is-it-poisonous/model.json')).default as unknown as Model;
    const { attributes, tree, specimens } = model;

    const q = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
    const traitCells = [...root.querySelectorAll<HTMLElement>('[data-attr]')];
    const choices = [...root.querySelectorAll<HTMLButtonElement>('[data-iip-choice]')];
    const nextBtn = q<HTMLButtonElement>('[data-iip-next]');
    const result = q<HTMLElement>('[data-iip-result]');
    const pathList = q<HTMLOListElement>('[data-iip-path]');
    const specimenLabel = q<HTMLElement>('[data-iip-specimen-label]');
    const scoreEl = q<HTMLElement>('[data-iip-score]');
    const streakEl = q<HTMLElement>('[data-iip-streak]');
    const bestEl = q<HTMLElement>('[data-iip-best]');
    const treeNodes = [...root.querySelectorAll<HTMLElement>('[data-path]')];

    let bag: number[] = [];
    let current = -1;
    let answered = false;
    let played = 0;
    let correct = 0;
    let streak = 0;
    let best = readBest();

    const renderScore = () => {
      scoreEl.textContent = `${correct} / ${played}`;
      streakEl.textContent = String(streak);
      bestEl.textContent = String(best);
    };

    const traitsOf = (i: number) => specimens[i].slice(1).split('');

    function deal() {
      if (bag.length === 0) {
        bag = shuffled(specimens.map((_, i) => i));
        if (bag[bag.length - 1] === current && bag.length > 1) bag.unshift(bag.pop()!);
      }
      current = bag.pop()!;
      answered = false;
      const x = traitsOf(current);
      traitCells.forEach((cell, i) => {
        cell.removeAttribute('data-tested');
        cell.querySelector('[data-iip-value]')!.textContent = attributes[i].values[x[i]] ?? x[i];
      });
      specimenLabel.textContent = `Specimen ${current + 1}`;
      root.removeAttribute('data-revealed');
      treeNodes.forEach((n) => n.removeAttribute('data-on'));
      result.replaceChildren();
      pathList.replaceChildren();
      pathList.hidden = true;
      choices.forEach((b) => (b.disabled = false));
      nextBtn.hidden = true;
    }

    function guess(choice: Label) {
      if (answered || current < 0) return;
      answered = true;
      const x = traitsOf(current);
      const { steps, verdict } = classify(tree, x);
      const right = choice === verdict;

      played += 1;
      if (right) {
        correct += 1;
        streak += 1;
        if (streak > best) {
          best = streak;
          writeBest(best);
        }
      } else {
        streak = 0;
      }
      renderScore();

      // Highlight the path in the full tree and the traits the tree looked at.
      const onPath = new Set(['', ...steps.map((s) => s.id)]);
      treeNodes.forEach((n) => n.toggleAttribute('data-on', onPath.has(n.dataset.path ?? '')));
      const tested = new Set(steps.map((s) => s.attr));
      traitCells.forEach((cell, i) => cell.toggleAttribute('data-tested', tested.has(i)));
      root.setAttribute('data-revealed', '');

      const headline = document.createElement('p');
      headline.className = 'g-appear g-status ' + (right ? 'text-on-surface' : 'text-error');
      headline.textContent = right
        ? `Correct — the tree says ${labelName(verdict)}.`
        : `Not quite — the tree says ${labelName(verdict)}.`;
      const detail = document.createElement('p');
      detail.className = 'g-appear g-note mt-1 text-[0.9375rem]';
      detail.textContent =
        steps.length === 1
          ? `It only needed one question: the ${attributes[steps[0].attr].name}.`
          : `It asked ${steps.length} questions, ${steps.map((s) => attributes[s.attr].name).join(', then ')}.`;
      result.replaceChildren(headline, detail);

      const chip = (text: string, extra = '') => {
        const li = document.createElement('li');
        const span = document.createElement('span');
        span.className = `g-tag ${extra}`.trim();
        span.textContent = text;
        li.append(span);
        return li;
      };
      const items = steps.map((s) => chip(`${attributes[s.attr].name} = ${attributes[s.attr].values[s.value]}`));
      const leaf = chip(labelName(verdict), verdict === 'p' ? 'g-tag-bad' : 'g-tag-good');
      pathList.replaceChildren(...items, leaf);
      pathList.hidden = false;

      const hadFocus = root.contains(document.activeElement);
      choices.forEach((b) => (b.disabled = true));
      nextBtn.hidden = false;
      if (hadFocus) nextBtn.focus();
    }

    choices.forEach((b) => b.addEventListener('click', () => guess(b.dataset.iipChoice as Label)));
    nextBtn.addEventListener('click', () => {
      deal();
      choices[0].focus();
    });

    // Shortcuts only while focus is inside the game, so the page keeps its own keys.
    root.addEventListener('keydown', (ev) => {
      if (ev.metaKey || ev.ctrlKey || ev.altKey) return;
      const k = ev.key.toLowerCase();
      if (!answered && (k === 'e' || k === 'p')) {
        ev.preventDefault();
        guess(k);
      } else if (answered && k === 'n') {
        ev.preventDefault();
        nextBtn.click();
      }
    });

    renderScore();
    deal();
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-iip]')) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          start(root).catch((err) => console.error('Is it poisonous? failed to start', err));
        }
      },
      { rootMargin: '200px' },
    );
    io.observe(root);
  }
</script>

<style>
  .iip {
    margin-block: 2.5rem;
  }
  .iip-trait {
    box-shadow:
      0.5px 0 0 var(--g-hair),
      0 0.5px 0 var(--g-hair);
    transition: background-color 320ms var(--g-ease);
  }
  .iip-trait[data-tested] {
    background: color-mix(in srgb, var(--md-sys-color-primary) 20%, transparent);
  }
  .iip-trait[data-tested] dt {
    color: var(--md-sys-color-primary);
  }
  /* Two equal choices: tonal until picked. */
  .iip-choice {
    min-width: 9rem;
    background: var(--g-fill);
    color: var(--md-sys-color-on-surface);
  }
  .iip-choice:not(:disabled):hover {
    background: var(--g-fill-strong);
    filter: none;
  }

  .iip-path :global(li) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .iip-path :global(li + li)::before {
    content: '→' / '';
    color: var(--md-sys-color-outline);
  }
  .iip-path :global(li) {
    animation: g-appear 420ms var(--g-ease) both;
  }
  .iip-path :global(li:nth-child(2)) { animation-delay: 60ms; }
  .iip-path :global(li:nth-child(3)) { animation-delay: 120ms; }
  .iip-path :global(li:nth-child(4)) { animation-delay: 180ms; }
  .iip-path :global(li:nth-child(5)) { animation-delay: 240ms; }
  .iip-path :global(li:nth-child(n + 6)) { animation-delay: 300ms; }

  .iip-tree summary {
    list-style: none;
  }
  .iip-tree summary::-webkit-details-marker {
    display: none;
  }
  .iip-tree[open] .iip-caret {
    transform: rotate(180deg);
  }
  .iip-caret {
    display: inline-grid;
    transition: transform 260ms var(--g-ease);
  }
  .iip-tree-root {
    min-width: 22rem;
  }
</style>
