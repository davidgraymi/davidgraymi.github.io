---
// Reaction-time test: wait for the panel to light up, then respond as fast as possible.
const stats = [
  ['last', 'Last'],
  ['best', 'Best'],
  ['avg', 'Avg of 5'],
] as const;
---

<div class="g-root" data-reaction>
  <div
    role="button"
    tabindex="0"
    data-panel
    data-state="idle"
    class="rx-pad g-tray grid min-h-80 cursor-pointer touch-manipulation select-none place-items-center p-8 text-center text-on-surface sm:min-h-96"
  >
    <div>
      <p data-heading class="g-num text-[clamp(2.25rem,7vw,3.75rem)] leading-none font-semibold tracking-[-0.035em]">Click to start</p>
      <p data-hint class="mt-4 min-h-6 text-[1.0625rem] opacity-75">
        Wait for amber, then click, tap or press Space.
      </p>
    </div>
  </div>
  <dl class="g-stats mt-6">
    {
      stats.map(([key, label]) => (
        <div class="flex flex-col-reverse">
          <dt class="g-stat-label">{label}</dt>
          <dd data-stat={key} class="g-stat-value">
            –
          </dd>
        </div>
      ))
    }
  </dl>
  <p role="status" class="sr-only" data-status></p>
</div>

<style>
  .rx-pad {
    transition:
      background 260ms var(--g-ease),
      color 260ms var(--g-ease),
      box-shadow 260ms var(--g-ease),
      transform 160ms var(--g-ease);
  }
  .rx-pad:active {
    transform: scale(0.99);
  }
  .rx-pad[data-state='waiting'] {
    background: var(--md-sys-color-surface-container-highest);
  }
  .rx-pad[data-state='lit'] {
    background: radial-gradient(120% 120% at 50% 0%, color-mix(in srgb, var(--md-sys-color-primary) 80%, white), var(--md-sys-color-primary) 60%);
    color: var(--md-sys-color-on-primary);
    box-shadow:
      var(--g-lift),
      0 0 80px -10px color-mix(in srgb, var(--md-sys-color-primary) 70%, transparent);
    transition-duration: 0ms;
  }
  .rx-pad[data-state='early'] {
    background: var(--md-sys-color-error-container);
    color: var(--md-sys-color-on-error-container);
  }
  .rx-pad[data-state='result'] [data-heading] {
    animation: g-appear 420ms var(--g-ease) both;
  }
</style>

<script>
  type State = 'idle' | 'waiting' | 'lit' | 'result' | 'early';
  const BEST_KEY = 'reaction-best-ms';

  document.querySelectorAll<HTMLElement>('[data-reaction]').forEach((root) => {
    const $ = (sel: string) => root.querySelector<HTMLElement>(sel)!;
    const panel = $('[data-panel]');
    const title = $('[data-heading]');
    const hint = $('[data-hint]');
    const status = $('[data-status]');

    let state: State = 'idle';
    let timer = 0;
    let litAt = 0;
    const recent: number[] = [];
    let best = Number(localStorage.getItem(BEST_KEY)) || 0;
    if (best) $('[data-stat="best"]').textContent = `${best} ms`;

    const show = (next: State, heading: string, sub: string, announce = heading) => {
      state = next;
      panel.dataset.state = next;
      title.textContent = heading;
      hint.textContent = sub;
      status.textContent = announce;
    };

    const respond = () => {
      if (state === 'waiting') {
        clearTimeout(timer);
        show('early', 'Too soon', 'Wait for amber. Click to try again.');
      } else if (state === 'lit') {
        const ms = Math.round(performance.now() - litAt);
        recent.push(ms);
        if (recent.length > 5) recent.shift();
        if (!best || ms < best) {
          best = ms;
          try {
            localStorage.setItem(BEST_KEY, String(ms));
          } catch {
            // Storage unavailable (private mode); best still holds for this visit.
          }
        }
        const avg = Math.round(recent.reduce((a, b) => a + b, 0) / recent.length);
        $('[data-stat="last"]').textContent = `${ms} ms`;
        $('[data-stat="best"]').textContent = `${best} ms`;
        $('[data-stat="avg"]').textContent = `${avg} ms`;
        show('result', `${ms} ms`, 'Click to go again.', `${ms} milliseconds. Best ${best}, average ${avg}.`);
      } else {
        show('waiting', 'Wait for amber…', 'Don’t jump the gun.');
        timer = window.setTimeout(() => {
          show('lit', 'Now!', '');
          litAt = performance.now();
        }, 1500 + Math.random() * 3500);
      }
    };

    // pointerdown, not click: the press is the reaction, not the release.
    panel.addEventListener('pointerdown', (e) => {
      if (e.button === 0) respond();
    });
    panel.addEventListener('keydown', (e) => {
      if ((e.key === ' ' || e.key === 'Enter') && !e.repeat) {
        e.preventDefault();
        respond();
      }
    });
  });
</script>
