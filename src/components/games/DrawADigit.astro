---
/**
 * "Draw a digit": a live weighted-KNN classifier over a 750-digit MNIST subset.
 * The markup ships with the page; the game code and the ~300 KB training set
 * load only when the panel scrolls near the viewport.
 */
const K_DEFAULT = 5;
const digits = Array.from({ length: 10 }, (_, d) => d);
---

<figure class="knn-game g-root not-prose my-10" data-knn-game data-k={K_DEFAULT}>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <div class="g-well aspect-square w-full rounded-[1.75rem] shadow-[var(--g-lift)]">
        <canvas
          data-knn-pad
          width="280"
          height="280"
          tabindex="0"
          role="application"
          aria-roledescription="drawing pad"
          aria-label="Draw a digit"
          aria-describedby="knn-pad-help"
          class="peer block size-full cursor-crosshair touch-none text-primary"></canvas>
        <span
          data-knn-cursor
          aria-hidden="true"
          class="knn-cursor pointer-events-none absolute top-0 left-0 hidden size-4 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-primary peer-focus-visible:block"
        ></span>
        <p
          data-knn-hint
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 grid place-items-center p-6 text-center text-[1.0625rem] font-medium text-on-surface-variant"
        >
          Draw 0 to 9, large and centred
        </p>
      </div>
      <p id="knn-pad-help" class="sr-only">
        Draw with a mouse, finger or pen. With the keyboard: arrow keys move the pen, Space puts it down or lifts it,
        Delete clears.
      </p>
      <div class="mt-4 flex flex-wrap justify-center gap-2">
        <button type="button" class="g-btn g-btn-tonal" data-knn-clear>Clear</button>
        <button type="button" class="g-btn g-btn-tonal" data-knn-example disabled>Try a test digit</button>
      </div>
    </div>

    <div class="g-card flex flex-col gap-6 p-6">
      <div class="flex items-center gap-5">
        <output
          data-knn-guess
          for="knn-k"
          class="g-num w-20 text-center text-[4.5rem] leading-none font-semibold tracking-[-0.04em] text-primary">–</output>
        <div class="min-w-0 flex-1">
          <p class="g-eyebrow">Prediction</p>
          <p data-knn-confidence class="g-status g-num mt-0.5">Waiting for ink</p>
        </div>
        <div class="flex flex-col items-center gap-1">
          <canvas
            data-knn-seen
            width="28"
            height="28"
            class="knn-pixelated size-14 rounded-lg bg-surface-container-lowest text-primary shadow-[inset_0_0_0_0.5px_var(--g-hair)]"
            aria-hidden="true"></canvas>
          <span class="g-num text-[0.6875rem] text-on-surface-variant">28×28</span>
        </div>
      </div>

      <div>
        <p class="g-eyebrow">Weighted vote</p>
        <ol class="mt-2 grid grid-cols-10 gap-1.5" data-knn-votes aria-label="Weighted vote per digit">
          {
            digits.map((d) => (
              <li class="flex flex-col items-center gap-1.5" data-digit={d}>
                <span class="knn-track flex h-16 w-full items-end overflow-hidden rounded-full">
                  <span class="knn-bar block w-full rounded-full bg-outline-variant" data-bar />
                </span>
                <span class="g-num text-[0.8125rem] font-medium text-on-surface-variant" data-digit-label>
                  {d}
                </span>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="mt-auto">
        <label for="knn-k" class="flex items-baseline justify-between">
          <span class="g-eyebrow">Neighbours</span>
          <span class="g-num text-[0.875rem] font-semibold text-on-surface">k = <span data-knn-k-value>{K_DEFAULT}</span></span>
        </label>
        <input id="knn-k" type="range" min="1" max="15" step="1" value={K_DEFAULT} data-knn-k class="g-range" />
      </div>
    </div>
  </div>

  <div class="g-card mt-5 p-6">
    <p class="g-eyebrow">Nearest training digits, closest first</p>
    <ol
      data-knn-neighbours
      class="mt-3 grid grid-cols-5 gap-2 sm:grid-cols-8"
      aria-label="Nearest training digits, closest first"
    >
    </ol>
    <p data-knn-empty class="g-note mt-1">
      The closest matches from the training set appear here.
    </p>
  </div>

  <figcaption class="g-note mx-auto mt-5 max-w-2xl text-center">
    <span data-knn-status>Loading 750 MNIST training digits…</span>{' '}Everything runs in your browser: your drawing is cropped, scaled to 20px and centred by mass on a 28×28 grid, the
    same way MNIST was prepared, then compared pixel by pixel against every training digit.
  </figcaption>

  <p class="sr-only" aria-live="polite" data-knn-live></p>
</figure>

<template id="knn-neighbour-template">
  <li class="flex flex-col items-center gap-1">
    <canvas
      width="28"
      height="28"
      class="knn-pixelated aspect-square w-full rounded-lg bg-surface-container-lowest text-on-surface shadow-[inset_0_0_0_0.5px_var(--g-hair)]"
    ></canvas>
    <span class="g-num text-[0.75rem] font-medium text-on-surface-variant" data-label></span>
  </li>
</template>

<script>
  const roots = document.querySelectorAll<HTMLElement>('[data-knn-game]');
  // Slider fill (WebKit has no ::range-progress).
  document.querySelectorAll<HTMLInputElement>('[data-knn-game] .g-range').forEach((r) => {
    const sync = () => r.style.setProperty('--g-range-pct', `${((+r.value - +r.min) / (+r.max - +r.min)) * 100}%`);
    r.addEventListener('input', sync);
    sync();
  });
  if (roots.length) {
    const start = (root: HTMLElement) =>
      import('~/lib/games/knn-digits/game').then(({ mount }) => mount(root));
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            io.unobserve(entry.target);
            start(entry.target as HTMLElement);
          }
        },
        { rootMargin: '300px 0px' },
      );
      roots.forEach((root) => io.observe(root));
    } else {
      roots.forEach(start);
    }
  }
</script>

<style>
  .knn-pixelated {
    image-rendering: pixelated;
  }
  .knn-track {
    background: var(--g-fill);
  }
  .knn-bar {
    height: 0;
    transition:
      height 320ms var(--g-ease),
      background-color 220ms var(--g-ease);
  }
</style>
