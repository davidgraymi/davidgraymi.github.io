---
/**
 * "Bot or human?" — pick which of two short texts a language model wrote.
 * Rounds live in src/data/bot-or-human.ts. Vanilla script, no framework; the
 * script only loads on the page that renders this component.
 */
import { rounds } from '~/data/bot-or-human';
---

<div class="g-root not-prose" data-bor>
  <noscript>
    <p class="g-card p-6 text-body text-on-surface-variant">
      This game needs JavaScript to shuffle and score its {rounds.length} rounds.
    </p>
  </noscript>

  <div data-bor-game hidden>
    <!-- Progress -->
    <div class="flex items-center justify-between gap-4">
      <p class="g-eyebrow g-num">
        Round <span class="text-on-surface" data-bor-round>1</span> of <span data-bor-total>{rounds.length}</span>
      </p>
      <p class="g-tag g-tag-accent g-num">Score <span data-bor-score>0</span></p>
    </div>
    <div class="bor-progress mt-3" aria-hidden="true"><span data-bor-progress></span></div>

    <!-- Play view -->
    <div data-bor-play>
      <div class="mt-8 text-center">
        <p class="g-eyebrow" data-bor-prompt></p>
        <h2 class="mt-1 text-[clamp(1.5rem,4vw,2rem)] leading-tight font-semibold tracking-[-0.025em] text-on-surface" id="bor-question">
          Which one did the bot write?
        </h2>
        <p class="g-note mt-2">
          One is a public-domain human text, the other was written by a language model.{' '}
          <span class="hidden md:inline">Press <kbd class="g-kbd">1</kbd> <kbd class="g-kbd">2</kbd> or <kbd class="g-kbd">←</kbd> <kbd class="g-kbd">→</kbd>.</span>
        </p>
      </div>

      <div class="mt-7 grid gap-4 md:grid-cols-2" role="group" aria-labelledby="bor-question">
        {
          [0, 1].map((slot) => (
            <button type="button" class="bor-choice g-card flex min-h-48 flex-col gap-4 p-6 text-left md:p-7" data-bor-choice={slot}>
              <span class="flex items-center gap-3">
                <span class="bor-num grid size-7 place-items-center rounded-full text-[0.8125rem] font-semibold">{slot + 1}</span>
                <span class="ml-auto" data-bor-badge hidden />
              </span>
              <span class="whitespace-pre-line font-serif text-[1.1875rem] leading-relaxed text-on-surface" data-bor-text />
              <span class="g-note mt-auto" data-bor-source hidden />
            </button>
          ))
        }
      </div>

      <div class="mt-7 min-h-28 text-center">
        <div aria-live="polite" aria-atomic="true" data-bor-feedback>
          <p class="g-note" data-bor-hint>Pick one to reveal the answer.</p>
        </div>
        <div class="mt-5" data-bor-next-wrap hidden>
          <button type="button" class="g-btn" data-bor-next>
            <span data-bor-next-label>Next round</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Summary view -->
    <div class="g-appear mt-8 text-center outline-none" data-bor-summary hidden tabindex="-1">
      <p class="g-eyebrow">Final score</p>
      <p class="g-num mt-1 text-[4.5rem] leading-none font-semibold tracking-[-0.04em] text-on-surface">
        <span class="text-primary" data-bor-final></span><span class="text-on-surface-variant">/{rounds.length}</span>
      </p>
      <p class="mx-auto mt-4 max-w-xl text-[1.0625rem] leading-relaxed text-on-surface-variant" data-bor-verdict></p>

      <ol class="g-card g-sep mt-8 text-left" data-bor-log></ol>

      <div class="mt-8">
        <button type="button" class="g-btn" data-bor-again>Play again</button>
      </div>
    </div>

    <p class="g-note mt-8 text-center">
      Human texts are public domain, quoted as published. Bot texts were written for this game by a
      language model imitating each form. Left and right are shuffled every round.
    </p>
  </div>
</div>

<style>
  .bor-progress {
    height: 4px;
    border-radius: 999px;
    background: var(--g-fill);
    overflow: hidden;
  }
  .bor-progress span {
    display: block;
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: var(--md-sys-color-primary);
    transition: width 420ms var(--g-ease);
  }
  .bor-choice {
    cursor: pointer;
    transition:
      transform 260ms var(--g-ease),
      box-shadow 260ms var(--g-ease),
      background-color 260ms var(--g-ease),
      opacity 260ms var(--g-ease);
  }
  .bor-choice:not(:disabled):hover {
    transform: translateY(-2px);
    box-shadow: var(--g-lift);
  }
  .bor-choice:not(:disabled):active {
    transform: scale(0.985);
  }
  .bor-choice:disabled {
    cursor: default;
  }
  .bor-num {
    background: var(--g-fill);
    color: var(--md-sys-color-on-surface-variant);
  }
  .bor-choice[data-result='bot'] {
    background: var(--md-sys-color-surface-container-high);
    box-shadow:
      0 0 0 2px var(--md-sys-color-primary),
      0 12px 32px -16px color-mix(in srgb, var(--md-sys-color-primary) 60%, transparent);
  }
  .bor-choice[data-result='bot'] .bor-num {
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
  }
  .bor-choice[data-result='human'] {
    opacity: 0.6;
  }
</style>

<script>
  import { rounds, type BotOrHumanRound } from '~/data/bot-or-human';

  type Side = 'human' | 'bot';
  interface Played {
    round: BotOrHumanRound;
    /** What sits in slot 0 and slot 1. */
    order: [Side, Side];
    picked?: 0 | 1;
  }

  const root = document.querySelector<HTMLElement>('[data-bor]');
  if (root) init(root);

  function shuffle<T>(arr: T[]): T[] {
    const a = arr.slice();
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function verdict(score: number, total: number): string {
    const pct = score / total;
    if (pct === 1) return 'Perfect. Either you know your nineteenth-century poetry or you have a very good ear for filler.';
    if (pct >= 0.75) return 'Sharp eye. The tells were stock images, forced rhymes and modern phrasing; you caught most of them.';
    if (pct >= 0.5) return 'Better than a coin flip. The forced rhymes are usually the giveaway, so read the last word of each line.';
    return 'Tougher than it looks. Try again and check whether each line actually means what it says.';
  }

  function init(root: HTMLElement) {
    const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const game = $('[data-bor-game]');
    const play = $('[data-bor-play]');
    const summary = $('[data-bor-summary]');
    const roundEl = $('[data-bor-round]');
    const scoreEl = $('[data-bor-score]');
    const progress = $('[data-bor-progress]');
    const promptEl = $('[data-bor-prompt]');
    const feedback = $('[data-bor-feedback]');
    const nextWrap = $('[data-bor-next-wrap]');
    const nextBtn = $<HTMLButtonElement>('[data-bor-next]');
    const nextLabel = $('[data-bor-next-label]');
    const againBtn = $<HTMLButtonElement>('[data-bor-again]');
    const log = $('[data-bor-log]');
    const choices = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-bor-choice]'));

    let deck: Played[] = [];
    let index = 0;
    let score = 0;


    function start() {
      deck = shuffle(rounds).map((round) => ({
        round,
        order: Math.random() < 0.5 ? ['human', 'bot'] : ['bot', 'human'],
      }));
      index = 0;
      score = 0;
      scoreEl.textContent = '0';
      summary.hidden = true;
      play.hidden = false;
      render();
    }

    function render() {
      const p = deck[index];
      roundEl.textContent = String(index + 1);
      progress.style.width = `${(index / deck.length) * 100}%`;
      promptEl.textContent = p.round.prompt;
      choices.forEach((btn, slot) => {
        const side = p.order[slot];
        btn.disabled = false;
        btn.removeAttribute('data-result');
        btn.setAttribute('aria-label', `Option ${slot + 1}: ${p.round[side].text.replace(/\n/g, ' ')}`);
        btn.querySelector('[data-bor-text]')!.textContent = p.round[side].text;
        const badge = btn.querySelector<HTMLElement>('[data-bor-badge]')!;
        const source = btn.querySelector<HTMLElement>('[data-bor-source]')!;
        badge.hidden = true;
        badge.textContent = '';
        source.hidden = true;
        source.textContent = '';
      });
      feedback.replaceChildren(
        Object.assign(document.createElement('p'), {
          className: 'g-note',
          textContent: 'Pick one to reveal the answer.',
        }),
      );
      nextWrap.hidden = true;
    }

    function choose(slot: 0 | 1) {
      const p = deck[index];
      if (p.picked !== undefined) return;
      p.picked = slot;
      const correct = p.order[slot] === 'bot';
      if (correct) score++;
      scoreEl.textContent = String(score);

      choices.forEach((btn, i) => {
        const side = p.order[i];
        btn.disabled = true;
        btn.dataset.result = side;
        const badge = btn.querySelector<HTMLElement>('[data-bor-badge]')!;
        badge.className = side === 'bot' ? 'ml-auto g-tag g-tag-accent' : 'ml-auto g-tag';
        badge.textContent = (side === 'bot' ? 'Bot' : 'Human') + (i === slot ? ' · your pick' : '');
        badge.hidden = false;
        if (side === 'human') {
          const source = btn.querySelector<HTMLElement>('[data-bor-source]')!;
          source.textContent = p.round.human.source;
          source.hidden = false;
        }
        btn.setAttribute('aria-label', `${side === 'bot' ? 'Bot' : 'Human'}: ${p.round[side].text.replace(/\n/g, ' ')}`);
      });

      const botSlot = p.order.indexOf('bot') + 1;
      const head = document.createElement('p');
      head.className = `g-appear g-status ${correct ? 'text-on-surface' : 'text-error'}`;
      head.textContent = correct
        ? `Correct — option ${botSlot} was the bot.`
        : `Not quite — option ${botSlot} was the bot.`;
      const why = document.createElement('p');
      why.className = 'g-appear mx-auto mt-2 max-w-2xl text-[0.9375rem] leading-relaxed text-on-surface-variant';
      why.textContent = p.round.explanation;
      feedback.replaceChildren(head, why);

      const last = index === deck.length - 1;
      nextLabel.textContent = last ? 'See your score' : 'Next round';
      nextWrap.hidden = false;
      nextBtn.focus({ preventScroll: true });
    }

    function next() {
      if (deck[index]?.picked === undefined) return;
      if (index < deck.length - 1) {
        index++;
        render();
        choices[0].focus({ preventScroll: true });
        root.scrollIntoView({ block: 'nearest', behavior: 'auto' });
      } else {
        finish();
      }
    }

    function finish() {
      play.hidden = true;
      summary.hidden = false;
      progress.style.width = '100%';
      $('[data-bor-final]').textContent = String(score);
      $('[data-bor-verdict]').textContent = verdict(score, deck.length);
      log.replaceChildren(
        ...deck.map((p, i) => {
          const ok = p.picked !== undefined && p.order[p.picked] === 'bot';
          const li = document.createElement('li');
          li.className = 'flex items-baseline gap-4 px-5 py-3.5';
          const mark = document.createElement('span');
          mark.className = `g-num w-10 shrink-0 text-[0.8125rem] font-semibold ${ok ? 'text-primary' : 'text-error'}`;
          mark.textContent = `${i + 1} ${ok ? '✓' : '✕'}`;
          mark.setAttribute('aria-hidden', 'true');
          const sr = Object.assign(document.createElement('span'), {
            className: 'sr-only',
            textContent: `Round ${i + 1}, ${ok ? 'correct' : 'missed'}: `,
          });
          const label = document.createElement('span');
          label.className = 'text-[0.875rem] text-on-surface';
          label.textContent = `${p.round.prompt}. Human: ${p.round.human.source}`;
          li.append(mark, sr, label);
          return li;
        }),
      );
      summary.focus({ preventScroll: true });
      root.scrollIntoView({ block: 'start', behavior: 'auto' });
    }

    choices.forEach((btn, slot) => btn.addEventListener('click', () => choose(slot as 0 | 1)));
    nextBtn.addEventListener('click', next);
    againBtn.addEventListener('click', () => {
      start();
      choices[0].focus({ preventScroll: true });
    });

    document.addEventListener('keydown', (e) => {
      if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.altKey) return;
      const t = e.target as HTMLElement | null;
      if (t?.closest('input, textarea, select, [contenteditable], dialog[open]')) return;
      // Only steer the game when focus is on the page itself or inside the game.
      if (t && t !== document.body && !root.contains(t)) return;
      if (play.hidden) return;
      const answered = deck[index]?.picked !== undefined;
      if (!answered) {
        if (e.key === '1' || e.key === 'ArrowLeft') {
          e.preventDefault();
          choose(0);
        } else if (e.key === '2' || e.key === 'ArrowRight') {
          e.preventDefault();
          choose(1);
        }
      } else if (e.key === 'n' || e.key === 'N' || e.key === 'ArrowRight') {
        e.preventDefault();
        next();
      }
    });

    game.hidden = false;
    start();
  }
</script>
