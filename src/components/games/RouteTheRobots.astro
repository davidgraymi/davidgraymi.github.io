---
/**
 * Route the robots: an editable MAPF grid with a LaCAM solver and a
 * "beat the solver" mode. Static markup only; the game itself is a separate
 * chunk imported when the panel nears the viewport.
 */
import { MAX_ROBOTS, PRESETS } from '~/lib/games/route-the-robots/presets';

interface Props {
  id?: string;
}
const { id = 'route-the-robots' } = Astro.props;
const robots = Array.from({ length: MAX_ROBOTS }, (_, i) => i);
const tools = [
  { id: 'wall', label: 'Wall', key: 'W' },
  { id: 'start', label: 'Start', key: 'S' },
  { id: 'goal', label: 'Goal', key: 'G' },
  { id: 'erase', label: 'Erase', key: 'X' },
];
const moves = [
  { id: 'ArrowUp', label: 'Move up', glyph: '↑', area: 'up' },
  { id: 'ArrowLeft', label: 'Move left', glyph: '←', area: 'left' },
  { id: 'wait', label: 'Wait', glyph: '·', area: 'wait' },
  { id: 'ArrowRight', label: 'Move right', glyph: '→', area: 'right' },
  { id: 'ArrowDown', label: 'Move down', glyph: '↓', area: 'down' },
];
---

<section id={id} class="rtr g-root not-prose my-10" data-rtr aria-labelledby={`${id}-title`}>
  <header class="text-center">
    <p class="g-eyebrow" id={`${id}-title`}>Route the robots</p>
    <p class="g-note mx-auto mt-1 max-w-xl text-[0.9375rem]">
      Draw walls, drop up to six robots and their goals, then let a JavaScript LaCAM solver route them — or try to beat it by
      hand.
    </p>
  </header>

  <div class="mt-5 flex flex-col items-center gap-2" data-ui hidden>
    <div class="g-seg justify-center" role="group" aria-label="Puzzle">
      {
        PRESETS.map((p) => (
          <button type="button" class="g-seg-btn" data-preset={p.id} aria-pressed="false">
            {p.name}
          </button>
        ))
      }
    </div>
    <p class="g-note min-h-5 text-center" data-preset-blurb></p>
  </div>

  <div class="g-tray mt-4 p-2.5 sm:p-3.5">
    <div class="rtr-stage relative">
      <div
        class="rtr-board"
        data-board
        role="grid"
        tabindex="0"
        aria-label="Puzzle grid, 10 columns by 7 rows. Arrow keys move the cursor."
        aria-describedby={`${id}-keys`}
      >
        <p class="g-note col-span-full row-span-full grid place-items-center" data-loading>
          Loading puzzle…
        </p>
      </div>
    </div>
    <noscript><p class="g-note mt-3">This puzzle needs JavaScript.</p></noscript>
  </div>

  <div data-ui hidden>
    <p class="g-status mt-5 min-h-7 text-center" role="status" aria-live="polite" data-status></p>

    <!-- Edit controls -->
    <div class="g-card mt-4 grid gap-4 p-4 sm:p-5" data-panel="edit">
      <div class="flex flex-wrap items-center gap-3" role="group" aria-label="Tool">
        <span class="g-eyebrow w-12">Tool</span>
        <div class="g-seg">
          {
            tools.map((t) => (
              <button type="button" class="g-seg-btn" data-tool={t.id} aria-pressed="false" aria-keyshortcuts={t.key}>
                {t.label}
              </button>
            ))
          }
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Robot">
        <span class="g-eyebrow mr-1 w-12">Robot</span>
        {
          robots.map((i) => (
            <button type="button" class="rtr-swatch" data-robot={i} aria-pressed="false" aria-keyshortcuts={String(i + 1)}>
              <span class="rtr-dot" data-slot={i} aria-hidden="true">
                {i + 1}
              </span>
            </button>
          ))
        }
        <button type="button" class="g-btn g-btn-plain g-btn-sm ml-auto" data-action="remove">Remove robot 1</button>
      </div>
      <div class="flex flex-wrap justify-center gap-2 pt-1">
        <button type="button" class="g-btn" data-action="solve">Solve with LaCAM</button>
        <button type="button" class="g-btn g-btn-tonal" data-action="play">Beat the solver</button>
        <button type="button" class="g-btn g-btn-plain" data-action="clear">Clear board</button>
      </div>
    </div>

    <!-- Watch controls -->
    <div class="g-card mt-4 grid gap-4 p-4 sm:p-5" data-panel="watch" hidden>
      <div class="flex items-center gap-4">
        <button type="button" class="g-btn g-btn-tonal w-24" data-action="toggle-play">Play</button>
        <label class="flex flex-1 items-center gap-3">
          <span class="sr-only">Timestep</span>
          <input type="range" min="0" max="1" step="1" value="0" class="g-range" data-scrub />
        </label>
        <span class="g-num w-14 text-right text-[0.875rem] font-medium text-on-surface-variant" data-scrub-label>t = 0</span>
      </div>
      <div class="flex flex-wrap justify-center gap-2">
        <button type="button" class="g-btn" data-action="play">Beat the solver</button>
        <button type="button" class="g-btn g-btn-plain" data-action="edit">Back to editing</button>
      </div>
    </div>

    <!-- Manual play controls -->
    <div class="g-card mt-4 grid gap-5 p-4 sm:grid-cols-[auto_1fr] sm:items-center sm:gap-7 sm:p-5" data-panel="play" hidden>
      <div class="rtr-pad" role="group" aria-label="Move the selected robot">
        {
          moves.map((m) => (
            <button type="button" class={`g-key rtr-pad-btn rtr-pad-${m.area}`} data-move={m.id} aria-label={m.label}>
              <span aria-hidden="true">{m.glyph}</span>
            </button>
          ))
        }
      </div>
      <div class="grid gap-4">
        <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Selected robot">
          <span class="g-eyebrow mr-1">Robot</span>
          {
            robots.map((i) => (
              <button type="button" class="rtr-swatch" data-robot={i} aria-pressed="false">
                <span class="rtr-dot" data-slot={i} aria-hidden="true">
                  {i + 1}
                </span>
              </button>
            ))
          }
        </div>
        <div class="flex flex-wrap gap-2">
          <button type="button" class="g-btn" data-action="step" aria-keyshortcuts="Enter">Step</button>
          <button type="button" class="g-btn g-btn-tonal" data-action="undo" aria-keyshortcuts="U">Undo</button>
          <button type="button" class="g-btn g-btn-plain" data-action="restart">Restart</button>
          <button type="button" class="g-btn g-btn-plain" data-action="edit">Edit board</button>
        </div>
      </div>
    </div>

    <dl class="g-card mt-4 grid grid-cols-3 gap-x-3 gap-y-5 px-4 py-5 text-center">
      <div class="flex flex-col-reverse">
        <dt class="g-stat-label">Solver makespan</dt>
        <dd class="g-stat-value text-[1.375rem]" data-stat="solver-makespan">—</dd>
      </div>
      <div class="flex flex-col-reverse">
        <dt class="g-stat-label">Solver sum of costs</dt>
        <dd class="g-stat-value text-[1.375rem]" data-stat="solver-soc">—</dd>
      </div>
      <div class="flex flex-col-reverse">
        <dt class="g-stat-label">Configs explored</dt>
        <dd class="g-stat-value text-[1.375rem]" data-stat="solver-configs">—</dd>
      </div>
      <div class="flex flex-col-reverse">
        <dt class="g-stat-label">Your steps</dt>
        <dd class="g-stat-value text-[1.375rem] text-primary" data-stat="you-steps">—</dd>
      </div>
      <div class="flex flex-col-reverse">
        <dt class="g-stat-label">Your sum of costs</dt>
        <dd class="g-stat-value text-[1.375rem] text-primary" data-stat="you-soc">—</dd>
      </div>
      <div class="flex flex-col-reverse">
        <dt class="g-stat-label">Your moves</dt>
        <dd class="g-stat-value text-[1.375rem] text-primary" data-stat="you-moves">—</dd>
      </div>
    </dl>

    <details class="rtr-keys g-card mt-4 text-[0.8125rem] text-on-surface-variant" id={`${id}-keys`}>
      <summary class="flex min-h-12 cursor-pointer items-center justify-between px-5 text-[0.875rem] font-medium text-on-surface">
        Keyboard and rules
        <svg class="rtr-caret text-on-surface-variant" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 4.5 3 3 3-3"/></svg>
      </summary>
      <ul class="grid gap-1.5 px-5 pb-5">
        <li>Editing: arrow keys move the cursor, Enter or Space applies the tool, W / S / G / X pick a tool, 1–6 pick a robot.</li>
        <li>Playing: 1–6 pick a robot, arrow keys plan its move (. to wait), Enter steps everyone at once, U undoes.</li>
        <li>Watching: Space plays or pauses, left and right arrows step through time.</li>
        <li>
          Every robot moves at the same time each step. Two robots can't end up on the same cell, and two neighbours can't swap
          places. Makespan is when the last robot arrives; sum of costs adds up each robot's arrival time.
        </li>
      </ul>
    </details>
  </div>
</section>

<script>
  // Load the game only when a board is about to be seen; most visitors to
  // this page never scroll this far, so they never download it.
  const roots = document.querySelectorAll<HTMLElement>('[data-rtr]');
  const boot = (el: HTMLElement) => import('~/lib/games/route-the-robots/game').then((m) => m.mount(el));
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          io.unobserve(e.target);
          boot(e.target as HTMLElement);
        }
      },
      { rootMargin: '400px 0px' },
    );
    roots.forEach((r) => io.observe(r));
  } else {
    roots.forEach(boot);
  }
</script>

<style is:global>
  /* Robot palette: amber signal first, then five hues that stay distinct and
     carry label text (surface colour) at AA in both themes. Numbers are
     always drawn on robots and goals, so colour is never the only cue. */
  .rtr {
    --rtr-0: var(--md-sys-color-primary);
    --rtr-1: light-dark(#0369a1, #38bdf8);
    --rtr-2: light-dark(#6d28d9, #a78bfa);
    --rtr-3: light-dark(#047857, #34d399);
    --rtr-4: light-dark(#be123c, #fb7185);
    --rtr-5: light-dark(#4d7c0f, #a3e635);
  }

  .rtr-board {
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    grid-template-rows: repeat(7, minmax(0, 1fr));
    gap: 3px;
    aspect-ratio: 10 / 7;
    border-radius: 1.1rem;
    outline: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .rtr[data-mode='edit'] .rtr-board {
    cursor: crosshair;
    touch-action: none;
  }
  .rtr[data-mode='play'] .rtr-board {
    cursor: pointer;
  }
  .rtr-board:focus-visible {
    outline: 2px solid var(--md-sys-color-primary);
    outline-offset: 4px;
  }

  .rtr-cell {
    border-radius: 0.4rem;
    background: var(--md-sys-color-surface);
    box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.12);
    transition:
      background-color 220ms var(--g-ease),
      box-shadow 220ms var(--g-ease),
      transform 220ms var(--g-ease);
  }
  .rtr-cell.is-wall {
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--md-sys-color-on-surface-variant) 55%, var(--md-sys-color-surface)),
      color-mix(in srgb, var(--md-sys-color-on-surface-variant) 42%, var(--md-sys-color-surface))
    );
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.12),
      0 1px 2px rgb(0 0 0 / 0.2);
  }
  .rtr[data-mode='edit'] .rtr-cell:not(.is-wall):hover {
    background: var(--md-sys-color-surface-container);
  }
  .rtr-board:focus-visible .rtr-cell.is-cursor {
    box-shadow: inset 0 0 0 2px var(--md-sys-color-primary);
  }

  .rtr-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }
  .rtr-goal {
    fill: none;
    stroke-width: 0.06;
    stroke-dasharray: 0.12 0.1;
  }
  .rtr-goal-label {
    font-family: var(--font-mono);
    font-size: 0.34px;
    font-weight: 600;
    text-anchor: middle;
    dominant-baseline: central;
  }
  .rtr-trail {
    fill: none;
    stroke-width: 0.1;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.4;
  }
  .rtr-intent {
    stroke-width: 0.08;
    stroke-linecap: round;
  }
  .rtr-ghost {
    fill: none;
    stroke-width: 0.06;
    stroke-dasharray: 0.1 0.08;
  }
  .rtr-robot {
    stroke: var(--md-sys-color-surface);
    stroke-width: 0.05;
  }
  .rtr-robot-label {
    font-family: var(--font-mono);
    font-size: 0.36px;
    font-weight: 700;
    fill: var(--md-sys-color-surface);
    text-anchor: middle;
    dominant-baseline: central;
  }
  .rtr-selected {
    fill: none;
    stroke: var(--md-sys-color-on-surface);
    stroke-width: 0.05;
  }

  /* Robot swatches: round 44px targets with a numbered colour dot */
  .rtr-swatch {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    background: var(--g-fill);
    cursor: pointer;
    transition:
      background-color 220ms var(--g-ease),
      box-shadow 220ms var(--g-ease),
      transform 160ms var(--g-ease);
  }
  .rtr-swatch:hover {
    background: var(--g-fill-strong);
  }
  .rtr-swatch:active {
    transform: scale(0.92);
  }
  .rtr-swatch.active {
    background: var(--md-sys-color-surface-container-lowest);
    box-shadow:
      0 0 0 2px var(--md-sys-color-on-surface),
      0 2px 6px rgb(0 0 0 / 0.15);
  }
  .rtr-swatch.is-empty .rtr-dot {
    opacity: 0.4;
  }
  .rtr-dot {
    display: grid;
    place-items: center;
    width: 1.625rem;
    height: 1.625rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--md-sys-color-surface);
    box-shadow: inset 0 -2px 3px rgb(0 0 0 / 0.18);
  }
  .rtr-dot[data-slot='0'] { background: var(--rtr-0); }
  .rtr-dot[data-slot='1'] { background: var(--rtr-1); }
  .rtr-dot[data-slot='2'] { background: var(--rtr-2); }
  .rtr-dot[data-slot='3'] { background: var(--rtr-3); }
  .rtr-dot[data-slot='4'] { background: var(--rtr-4); }
  .rtr-dot[data-slot='5'] { background: var(--rtr-5); }

  /* D-pad for touch play */
  .rtr-pad {
    display: grid;
    grid-template-columns: repeat(3, 3rem);
    grid-template-rows: repeat(3, 3rem);
    grid-template-areas: '. up .' 'left wait right' '. down .';
    gap: 0.3rem;
    justify-content: center;
  }
  .rtr-pad-btn {
    border-radius: 999px;
    font-size: 1.125rem;
  }
  .rtr-pad-up { grid-area: up; }
  .rtr-pad-left { grid-area: left; }
  .rtr-pad-wait { grid-area: wait; }
  .rtr-pad-right { grid-area: right; }
  .rtr-pad-down { grid-area: down; }

  .rtr-keys summary {
    list-style: none;
  }
  .rtr-keys summary::-webkit-details-marker {
    display: none;
  }
  .rtr-caret {
    transition: transform 260ms var(--g-ease);
  }
  .rtr-keys[open] .rtr-caret {
    transform: rotate(180deg);
  }
</style>
