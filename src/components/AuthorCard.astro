---
/**
 * The end of every post: who wrote it, what else they write about, and a way
 * to keep reading. A reader who got this far is the most likely person on the
 * site to subscribe or get in touch, so this is where we ask.
 */
import { Image } from 'astro:assets';
import Icon from '~/components/Icon.astro';
import avatar from '~/assets/avatar.png';
import { site } from '~/site.config';

const { class: className = 'mt-16' } = Astro.props as { class?: string };
---

<aside class:list={['author-card', className]} aria-label="About the author">
  <span class="avatar">
    <Image src={avatar} alt={`Photo of ${site.name}`} widths={[64, 128]} sizes="4rem" />
  </span>
  <div>
    <p class="kicker">Written by</p>
    <p class="mt-1.5 text-title font-semibold tracking-[-0.01em] text-on-surface">{site.name}</p>
    <p class="mt-2 text-body-sm leading-relaxed text-on-surface-variant">
      Software engineer in {site.location.split(',')[0]}. I write about measuring machine learning systems honestly,
      the things I build on the side, and what each one taught me.
    </p>
    <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-1 text-[0.875rem]">
      <a href="/rss.xml" class="inline-flex min-h-11 items-center gap-2 text-on-surface-variant transition-colors hover:text-primary">
        <Icon name="rss" size={14} />
        Follow by RSS
      </a>
      <a href="/about" class="inline-flex min-h-11 items-center gap-2 text-on-surface-variant transition-colors hover:text-primary">
        More about me
      </a>
      <a href="/contact" class="inline-flex min-h-11 items-center gap-2 text-on-surface-variant transition-colors hover:text-primary">
        Get in touch
        <Icon name="arrow" size={14} />
      </a>
    </div>
  </div>
</aside>
