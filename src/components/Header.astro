---
import { site } from '~/site.config';
import { visibleNav } from '~/lib/nav';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const nav = await visibleNav();
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href + '/'));
---

<header class="sticky top-3 z-50 mx-auto w-full max-w-5xl px-3.5 sm:px-6 md:top-4">
  <div
    class="flex h-14 items-center justify-between gap-3 rounded-full border border-outline-variant bg-surface-container-high/88 px-3.5 shadow-elevation-2 backdrop-blur-xl sm:h-15 sm:px-5"
  >
    {/* Brand / Logo */}
    <a href="/" class="group flex items-center gap-2.5" aria-label={`${site.name} — home`}>
      <span
        class="grid h-8.5 w-8.5 place-items-center rounded-xl font-mono text-caption font-bold transition-transform duration-200 group-hover:scale-105 bg-primary text-on-primary shadow-glow"
      >dg</span>
      <span class="text-body-sm font-semibold tracking-tight transition-colors group-hover:text-primary sm:text-body">
        {site.name}
      </span>
    </a>

    {/* Desktop Navigation Links */}
    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      {
        nav.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                'relative rounded-full px-4 py-1.5 text-body-sm transition-all duration-200',
                active ? 'bg-primary-container font-semibold text-primary' : 'font-medium text-on-surface-variant',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
              {active && (
                <span
                  class="absolute -bottom-1 left-1/2 h-1 w-1.5 -translate-x-1/2 rounded-full bg-primary"
                />
              )}
            </a>
          );
        })
      }
    </nav>

    {/* Header Actions */}
    <div class="flex items-center gap-2">
      {/* Cmd+K Quick Search Trigger */}
      <button
        id="cmd-palette-btn"
        type="button"
        class="hidden items-center gap-2 rounded-full border px-3 py-1 font-mono text-label transition-all hover:border-outline hover:text-primary sm:inline-flex bg-surface-container-highest border-outline-variant text-on-surface-variant"
        title="Search pages, projects and posts"
        aria-label="Open Command Palette"
      >
        <Icon name="search" size={13} />
        <span>Search</span>
        <kbd data-shortcut class="rounded border px-1.5 py-0.5 text-label border-outline-variant bg-surface-container">⌘K</kbd>
      </button>

      <ThemeToggle />

      <a
        href="/contact"
        class="btn btn-primary hidden h-8.5 rounded-lg px-4 text-caption md:inline-flex"
      >
        Get in touch
      </a>

      {/* Mobile menu hamburger */}
      <button
        id="menu-toggle"
        type="button"
        class="grid h-11 w-11 place-items-center rounded-full border md:hidden border-outline-variant bg-surface-container-highest"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span id="menu-open"><Icon name="menu" size={17} /></span>
        <span id="menu-close" hidden><Icon name="close" size={17} /></span>
      </button>
    </div>
  </div>

  {/* Mobile Menu Overlay */}
  <nav
    id="mobile-nav"
    class="glass-panel absolute inset-x-3.5 top-full mt-2.5 hidden max-h-[calc(100dvh-6rem)] overflow-y-auto rounded-2xl p-4 shadow-elevation-4 sm:inset-x-6 md:hidden bg-surface-container-high border-outline-variant"
    aria-label="Mobile Navigation"
  >
    <ul class="flex flex-col gap-1.5">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'flex items-center justify-between rounded-xl px-3.5 py-2.5 text-body transition-colors',
                isActive(item.href) ? 'bg-primary-container font-semibold text-primary' : 'font-medium text-on-surface',
              ]}
            >
              {item.label}
              <Icon name="arrow" size={15} />
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-3.5 flex flex-col gap-2 border-t border-outline-variant pt-3">
      <button
        id="mobile-cmd-btn"
        type="button"
        class="btn btn-ghost w-full justify-between text-body-sm"
      >
        <span class="flex items-center gap-2">
          <Icon name="search" size={15} />
          Search
        </span>
      </button>
      <a href="/contact" class="btn btn-primary w-full text-body-sm">
        Get in touch
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-nav');
  const openIcon = document.getElementById('menu-open');
  const closeIcon = document.getElementById('menu-close');

  const isOpen = () => !!menu && !menu.classList.contains('hidden');

  function setMenu(open: boolean) {
    if (!menu || !toggle) return;
    menu.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    if (openIcon) openIcon.hidden = open;
    if (closeIcon) closeIcon.hidden = !open;
    // The menu floats over the page, so stop the page scrolling underneath it.
    document.documentElement.style.overflow = open ? 'hidden' : '';
  }

  toggle?.addEventListener('click', () => setMenu(!isOpen()));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) {
      setMenu(false);
      toggle?.focus();
    }
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (isOpen() && !menu?.contains(target) && !toggle?.contains(target)) setMenu(false);
  });

  // Close if the viewport grows past the breakpoint where the menu is hidden.
  matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
    if (e.matches) setMenu(false);
  });

  const triggerPalette = () => {
    setMenu(false);
    if (typeof (window as any).openCommandPalette === 'function') {
      (window as any).openCommandPalette();
    }
  };

  document.getElementById('cmd-palette-btn')?.addEventListener('click', triggerPalette);
  document.getElementById('mobile-cmd-btn')?.addEventListener('click', triggerPalette);
</script>
