---
import { site } from '~/site.config';
import { visibleNav } from '~/lib/nav';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const nav = await visibleNav();
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href + '/'));
---

<header class="site-header sticky top-0 z-50 w-full">
  <div class="wrap relative z-10 grid h-14 grid-cols-[1fr_auto] items-center gap-4 md:grid-cols-[1fr_auto_1fr]">
    {/* Brand */}
    <a href="/" class="brand group flex h-full items-center gap-2.5 justify-self-start">
      <span class="brand-mark grid size-7 place-items-center font-mono text-[0.75rem] font-bold text-on-primary" aria-hidden="true">dg</span>
      <span class="text-[0.9375rem] font-semibold tracking-[-0.01em] text-on-surface transition-opacity duration-200 group-hover:opacity-70">
        {site.name}<span class="sr-only">, home</span>
      </span>
    </a>

    {/* Desktop navigation, centred */}
    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      {
        nav.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              class:list={['nav-link', active && 'is-active']}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    {/* Actions */}
    <div class="flex items-center gap-2 justify-self-end">
      <button id="cmd-palette-btn" type="button" class="search-pill hidden lg:inline-flex" title="Search pages, projects and posts">
        <Icon name="search" size={14} />
        <span class="flex-1 text-left">Search</span>
        <kbd aria-hidden="true" data-shortcut class="g-kbd">⌘K</kbd>
      </button>

      <button
        id="cmd-palette-btn-compact"
        type="button"
        class="g-icon-btn hidden md:inline-grid lg:hidden"
        title="Search pages, projects and posts"
        aria-label="Open Command Palette"
      >
        <Icon name="search" size={15} />
      </button>

      <ThemeToggle />

      <a href="/contact" class="g-btn g-btn-sm hidden md:inline-flex">Get in touch</a>

      {/* Mobile menu: two lines that fold into an X */}
      <button
        id="menu-toggle"
        type="button"
        class="menu-btn g-icon-btn md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="menu-line" aria-hidden="true"></span>
        <span class="menu-line" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  {/* Mobile menu: a frosted sheet with large links that settle in one by one */}
  <nav id="mobile-nav" class="mobile-nav hidden md:hidden" aria-label="Mobile Navigation">
    <ul class="wrap pt-6">
      {
        nav.map((item, i) => (
          <li style={`--i: ${i}`}>
            <a
              href={item.href}
              class:list={['mobile-link', isActive(item.href) && 'is-active']}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="wrap mobile-actions grid grid-cols-2 gap-2 pt-8 pb-10" style={`--i: ${nav.length}`}>
      <button id="mobile-cmd-btn" type="button" class="g-btn g-btn-tonal g-btn-block">
        <Icon name="search" size={15} />
        Search
      </button>
      <a href="/contact" class="g-btn g-btn-block">Get in touch</a>
    </div>
  </nav>
</header>

<style>
  /* Frosted glass; the hairline appears once the page scrolls under it.
     On the header itself, not a pseudo-element: its view-transition-name
     makes it a backdrop root, so a child's backdrop-filter would see nothing. */
  .site-header {
    background: color-mix(in srgb, var(--md-sys-color-surface) 72%, transparent);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    box-shadow: 0 0.5px 0 transparent;
    transition:
      box-shadow 260ms var(--g-ease),
      background-color 260ms var(--g-ease);
  }
  .site-header[data-scrolled] {
    box-shadow: 0 0.5px 0 var(--g-hair);
  }
  /* With the menu open, the bar and the sheet read as one solid surface. */
  .site-header[data-menu-open] {
    background: var(--md-sys-color-surface);
  }

  /* An app-icon squircle with a soft top light. */
  .brand-mark {
    border-radius: 0.5rem;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.22), transparent 55%),
      var(--md-sys-color-primary);
    box-shadow:
      inset 0 0 0 0.5px rgb(0 0 0 / 0.12),
      0 1px 2px rgb(0 0 0 / 0.18);
  }

  .nav-link {
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: var(--md-sys-color-on-surface-variant);
    transition:
      color 200ms var(--g-ease),
      background-color 200ms var(--g-ease);
  }
  .nav-link:hover {
    color: var(--md-sys-color-on-surface);
  }
  .nav-link.is-active {
    color: var(--md-sys-color-on-surface);
    background: var(--g-fill);
  }

  .search-pill {
    align-items: center;
    gap: 0.5rem;
    width: 13rem;
    height: 36px;
    padding: 0 0.4rem 0 0.85rem;
    border-radius: 999px;
    background: var(--g-fill);
    font-size: 0.8125rem;
    color: var(--md-sys-color-on-surface-variant);
    transition:
      background-color 200ms var(--g-ease),
      color 200ms var(--g-ease);
  }
  .search-pill:hover {
    background: var(--g-fill-strong);
    color: var(--md-sys-color-on-surface);
  }

  /* Hamburger: two lines that rotate into an X. */
  .menu-btn {
    position: relative;
  }
  .menu-line {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 16px;
    height: 1.5px;
    margin-left: -8px;
    border-radius: 1px;
    background: currentColor;
    transition: transform 320ms var(--g-ease);
  }
  .menu-line:first-child {
    transform: translateY(-3.5px);
  }
  .menu-line:last-child {
    transform: translateY(3.5px);
  }
  .menu-btn[aria-expanded='true'] .menu-line:first-child {
    transform: rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] .menu-line:last-child {
    transform: rotate(-45deg);
  }

  .mobile-nav {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    height: calc(100dvh - 3.5rem);
    overflow-y: auto;
    background: var(--md-sys-color-surface);
  }
  .mobile-link {
    display: block;
    padding: 0.45rem 0;
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--md-sys-color-on-surface);
    transition: opacity 200ms var(--g-ease);
  }
  .mobile-link:hover {
    opacity: 0.7;
  }
  .mobile-link.is-active {
    color: var(--md-sys-color-primary);
  }
  .mobile-nav:not(.hidden) li,
  .mobile-nav:not(.hidden) .mobile-actions {
    animation: menu-in 480ms var(--g-ease) both;
    animation-delay: calc(var(--i) * 35ms + 40ms);
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-nav:not(.hidden) li,
    .mobile-nav:not(.hidden) .mobile-actions {
      animation: none;
    }
    .menu-line {
      transition: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-nav');
  const header = document.querySelector<HTMLElement>('.site-header');

  const isOpen = () => !!menu && !menu.classList.contains('hidden');

  function setMenu(open: boolean) {
    if (!menu || !toggle) return;
    menu.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    header?.toggleAttribute('data-menu-open', open);
    // The menu floats over the page, so stop the page scrolling underneath it.
    document.documentElement.style.overflow = open ? 'hidden' : '';
  }

  toggle?.addEventListener('click', () => setMenu(!isOpen()));

  // Hairline under the bar only once there's something scrolled beneath it.
  const syncScrolled = () => header?.toggleAttribute('data-scrolled', window.scrollY > 4);
  addEventListener('scroll', syncScrolled, { passive: true });
  syncScrolled();

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) {
      setMenu(false);
      toggle?.focus();
    }
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (isOpen() && !menu?.contains(target) && !toggle?.contains(target)) setMenu(false);
  });

  // Close if the viewport grows past the breakpoint where the menu is hidden.
  matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
    if (e.matches) setMenu(false);
  });

  const triggerPalette = () => {
    setMenu(false);
    if (typeof (window as any).openCommandPalette === 'function') {
      (window as any).openCommandPalette();
    }
  };

  document.getElementById('cmd-palette-btn')?.addEventListener('click', triggerPalette);
  document.getElementById('cmd-palette-btn-compact')?.addEventListener('click', triggerPalette);
  document.getElementById('mobile-cmd-btn')?.addEventListener('click', triggerPalette);
</script>
