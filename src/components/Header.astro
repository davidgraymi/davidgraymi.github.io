---
import { nav, site } from '~/site.config';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header
  class="sticky top-0 z-50 border-b backdrop-blur-md"
  style="background: color-mix(in srgb, var(--bg) 88%, transparent)"
>
  <div class="wrap flex h-16 items-center justify-between gap-4">
    <a href="/" class="group flex items-center gap-2.5" aria-label={`${site.name} — home`}>
      <span
        class="grid h-8 w-8 place-items-center rounded-md font-mono text-[13px] font-bold"
        style="background: var(--signal); color: var(--signal-contrast)"
      >dg</span>
      <span class="text-[15px] font-semibold tracking-tight">{site.name}</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="rounded-lg px-3 py-2 text-[14.5px] font-medium transition-colors"
            style={
              isActive(item.href)
                ? 'color: var(--fg); background: var(--bg-surface-2)'
                : 'color: var(--fg-muted)'
            }
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <a href="/contact" class="btn btn-primary hidden h-9 px-4 text-[14px] sm:inline-flex">
        Hire me
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="grid h-9 w-9 place-items-center rounded-lg border md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span id="menu-open"><Icon name="menu" size={18} /></span>
        <span id="menu-close" hidden><Icon name="close" size={18} /></span>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="wrap hidden border-t py-3 md:hidden"
    style="background: var(--bg)"
    aria-label="Main"
  >
    <ul class="flex flex-col">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="flex items-center justify-between border-b py-3.5 text-[15px] font-medium"
              style={isActive(item.href) ? 'color: var(--signal)' : ''}
            >
              {item.label}
              <Icon name="arrow" size={16} />
            </a>
          </li>
        ))
      }
    </ul>
    <a href="/contact" class="btn btn-primary mt-4 w-full">Hire me</a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-nav');
  const openIcon = document.getElementById('menu-open');
  const closeIcon = document.getElementById('menu-close');

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    if (openIcon) openIcon.hidden = open;
    if (closeIcon) closeIcon.hidden = !open;
  });
</script>
