---
import { site } from '~/site.config';
import { visibleNav } from '~/lib/nav';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const nav = await visibleNav();
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href + '/'));
---

<header class="site-header sticky top-0 z-50 w-full border-b border-outline-variant bg-surface/88 backdrop-blur-xl">
  <div class="wrap flex h-16 items-center gap-4">
    {/* Brand / Logo */}
    <a href="/" class="group flex h-full shrink-0 items-center gap-2.5 pr-2" aria-label={`${site.name} — home`}>
      <span
        class="grid h-8 w-8 place-items-center bg-primary font-mono text-caption font-bold text-on-primary"
      >dg</span>
      <span class="text-body font-semibold tracking-tight transition-colors group-hover:text-primary">
        {site.name}
      </span>
    </a>

    <span class="hidden h-6 w-px bg-outline-variant md:block" aria-hidden="true"></span>

    {/* Desktop Navigation Links */}
    <nav class="hidden h-full items-stretch md:flex" aria-label="Main">
      {
        nav.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                'nav-link relative flex items-center px-4 text-body-sm transition-colors duration-150 hover:text-on-surface',
                active ? 'is-active font-semibold text-on-surface' : 'font-medium text-on-surface-variant',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    {/* Header Actions */}
    <div class="ml-auto flex items-center gap-2">
      {/* Cmd+K Quick Search Trigger */}
      <button
        id="cmd-palette-btn"
        type="button"
        class="hidden h-9 w-52 items-center gap-2 border border-outline-variant bg-surface pl-3 pr-1.5 text-caption text-on-surface-variant transition-colors duration-150 hover:border-outline hover:text-on-surface lg:inline-flex"
        title="Search pages, projects and posts"
        aria-label="Open Command Palette"
      >
        <Icon name="search" size={14} />
        <span class="flex-1 text-left">Search</span>
        <kbd data-shortcut class="rounded-md border border-outline-variant bg-surface-container px-1.5 py-0.5 font-mono text-label">⌘K</kbd>
      </button>

      <button
        id="cmd-palette-btn-compact"
        type="button"
        class="hidden h-9 w-9 place-items-center border border-outline-variant bg-surface text-on-surface-variant transition-colors duration-150 hover:border-outline hover:text-on-surface md:grid lg:hidden"
        title="Search pages, projects and posts"
        aria-label="Open Command Palette"
      >
        <Icon name="search" size={15} />
      </button>

      <ThemeToggle />

      <a href="/contact" class="btn btn-primary hidden h-9 px-4 text-caption md:inline-flex">
        Get in touch
        <Icon name="arrow" size={13} />
      </a>

      {/* Mobile menu hamburger */}
      <button
        id="menu-toggle"
        type="button"
        class="grid h-11 w-11 place-items-center border border-outline-variant bg-surface text-on-surface md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span id="menu-open"><Icon name="menu" size={17} /></span>
        <span id="menu-close" hidden><Icon name="close" size={17} /></span>
      </button>
    </div>
  </div>

  {/* Mobile Menu: full-width ruled sheet under the bar */}
  <nav
    id="mobile-nav"
    class="absolute inset-x-0 top-full hidden max-h-[calc(100dvh-4rem)] overflow-y-auto border-b border-outline-variant bg-surface shadow-elevation-3 md:hidden"
    aria-label="Mobile Navigation"
  >
    <ul class="ruled-list border-t-0">
      {
        nav.map((item, i) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'wrap flex min-h-14 items-center gap-4 text-body transition-colors',
                isActive(item.href) ? 'font-semibold text-primary' : 'font-medium text-on-surface',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              <span class="font-mono text-label text-on-surface-variant">{String(i + 1).padStart(2, '0')}</span>
              <span class="flex-1">{item.label}</span>
              <Icon name="arrow" size={15} />
            </a>
          </li>
        ))
      }
    </ul>
    <div class="wrap grid grid-cols-2 gap-2 py-4">
      <button id="mobile-cmd-btn" type="button" class="btn btn-ghost w-full text-body-sm">
        <Icon name="search" size={15} />
        Search
      </button>
      <a href="/contact" class="btn btn-primary w-full text-body-sm">
        Get in touch
      </a>
    </div>
  </nav>
</header>

<style>
  /* Signal bar along the header's bottom rule: drawn for the active page, grows in on hover. */
  .nav-link::after {
    content: '';
    position: absolute;
    inset: auto 0.75rem -1px;
    height: 2px;
    background: var(--md-sys-color-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--md-sys-motion-duration-medium) var(--md-sys-motion-easing-standard);
  }
  .nav-link:hover::after,
  .nav-link.is-active::after {
    transform: scaleX(1);
  }
  .nav-link:not(.is-active):hover::after {
    background: var(--md-sys-color-outline);
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-nav');
  const openIcon = document.getElementById('menu-open');
  const closeIcon = document.getElementById('menu-close');

  const isOpen = () => !!menu && !menu.classList.contains('hidden');

  function setMenu(open: boolean) {
    if (!menu || !toggle) return;
    menu.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    if (openIcon) openIcon.hidden = open;
    if (closeIcon) closeIcon.hidden = !open;
    // The menu floats over the page, so stop the page scrolling underneath it.
    document.documentElement.style.overflow = open ? 'hidden' : '';
  }

  toggle?.addEventListener('click', () => setMenu(!isOpen()));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) {
      setMenu(false);
      toggle?.focus();
    }
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (isOpen() && !menu?.contains(target) && !toggle?.contains(target)) setMenu(false);
  });

  // Close if the viewport grows past the breakpoint where the menu is hidden.
  matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
    if (e.matches) setMenu(false);
  });

  const triggerPalette = () => {
    setMenu(false);
    if (typeof (window as any).openCommandPalette === 'function') {
      (window as any).openCommandPalette();
    }
  };

  document.getElementById('cmd-palette-btn')?.addEventListener('click', triggerPalette);
  document.getElementById('cmd-palette-btn-compact')?.addEventListener('click', triggerPalette);
  document.getElementById('mobile-cmd-btn')?.addEventListener('click', triggerPalette);
</script>
