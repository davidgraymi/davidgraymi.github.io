---
interface Props {
  date: Date;
  class?: string;
}
const { date, class: className = '' } = Astro.props;
const formatted = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<time class="text-on-surface-variant" datetime={date.toISOString()} class={className}>{formatted}</time>
