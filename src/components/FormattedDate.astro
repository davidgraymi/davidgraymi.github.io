---
interface Props {
  date: Date;
  class?: string;
}
const { date, class: className = '' } = Astro.props;
const formatted = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<time datetime={date.toISOString()} class={className} style="color: var(--fg-muted)">{formatted}</time>
