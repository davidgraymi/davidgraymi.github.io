---
import { site } from '~/site.config';
import { pageCardFor } from '~/lib/og-pages';
import Analytics from './Analytics.astro';
import bodyFont from '@fontsource-variable/roboto-flex/files/roboto-flex-latin-opsz-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** schema.org object(s) rendered as JSON-LD. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = site.tagline,
  image = pageCardFor(Astro.url.pathname),
  type = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

// Search engines truncate past ~70 characters, so long titles drop the site name (npm run check:site enforces it).
const MAX_TITLE = 70;
const branded = title ? `${title} — ${site.name}` : `${site.name} — ${site.titleRole}`;
const pageTitle = title && branded.length > MAX_TITLE ? title : branded;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const ogImage = new URL(image, Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<!-- The body font, fetched alongside the CSS instead of after it, so hero text settles sooner. -->
<link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />

<!-- .ico first for crawlers that only read one; browsers that understand SVG take the later, sharper one. -->
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/images/icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<!-- Match --md-sys-color-surface; Base.astro rewrites these when the toggle pins a theme. -->
<meta name="theme-color" content="#06090e" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

<meta property="og:type" content={type} />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={pageTitle} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<link rel="alternate" type="application/rss+xml" title={`${site.name} — Writing`} href="/rss.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
<Analytics />
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
