---
interface Props {
  kicker?: string;
  title?: string;
  lead?: string;
  id?: string;
  /** Adds the alternate surface background used to break up the page. */
  alt?: boolean;
  class?: string;
}
const { kicker, title, lead, id, alt = false, class: className = '' } = Astro.props;
---

<section id={id} class:list={['py-20 md:py-28', alt && 'bg-surface-container-lowest', className]}>
  <div class="wrap">
    {
      (kicker || title || lead) && (
        <div class="max-w-2xl" data-reveal>
          {kicker && <p class="kicker">{kicker}</p>}
          {title && (
            <h2 class="mt-2 text-[clamp(2rem,4.5vw,3rem)] leading-[1.05] font-semibold tracking-[-0.035em] text-on-surface">{title}</h2>
          )}
          {lead && <p class="mt-4 text-[clamp(1.0625rem,1.6vw,1.25rem)] leading-relaxed text-on-surface-variant">{lead}</p>}
        </div>
      )
    }
    <div data-reveal style="--reveal-i: 1">
      <slot />
    </div>
  </div>
</section>
