---
interface Props {
  kicker?: string;
  title?: string;
  lead?: string;
  id?: string;
  /** Adds the alternate surface background used to break up the page. */
  alt?: boolean;
  class?: string;
}
const { kicker, title, lead, id, alt = false, class: className = '' } = Astro.props;
---

<section
  id={id}
  class:list={['border-t border-outline-variant py-16 md:py-24', alt && 'bg-surface-container-lowest', className]}
>
  <div class="wrap">
    {
      (kicker || title || lead) && (
        <div class="max-w-2xl">
          {kicker && <p class="kicker">{kicker}</p>}
          {title && <h2 class="mt-5 font-semibold text-h2 text-on-surface">{title}</h2>}
          {lead && (
            <p class="mt-4 text-body-lg leading-relaxed text-on-surface-variant">
              {lead}
            </p>
          )}
        </div>
      )
    }
    <slot />
  </div>
</section>
