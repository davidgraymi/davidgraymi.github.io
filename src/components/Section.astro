---
interface Props {
  kicker?: string;
  title?: string;
  lead?: string;
  id?: string;
  /** Adds the alternate surface background used to break up the page. */
  alt?: boolean;
  class?: string;
}
const { kicker, title, lead, id, alt = false, class: className = '' } = Astro.props;
---

<section
  id={id}
  class:list={['border-t py-16 md:py-24', className]}
  style={alt ? 'background: var(--bg-surface)' : ''}
>
  <div class="wrap">
    {
      (kicker || title || lead) && (
        <div class="max-w-2xl">
          {kicker && <p class="kicker">{kicker}</p>}
          {title && <h2 class="mt-5 font-semibold" style="font-size: var(--text-h2)">{title}</h2>}
          {lead && (
            <p class="mt-4 text-[17px] leading-relaxed" style="color: var(--fg-muted)">
              {lead}
            </p>
          )}
        </div>
      )
    }
    <slot />
  </div>
</section>
