---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  entry: CollectionEntry<'blog'>;
}
const { entry } = Astro.props;
---

<article class="group relative border-t py-7">
  <div class="flex flex-col gap-2 md:flex-row md:items-baseline md:gap-8">
    <FormattedDate
      date={entry.data.pubDate}
      class="font-mono text-[12px] uppercase tracking-wider md:w-32 md:shrink-0"
    />
    <div class="min-w-0">
      <h3 class="text-[19px] font-semibold leading-snug transition-colors group-hover:text-[var(--signal)]">
        <a href={`/blog/${entry.id}`} class="after:absolute after:inset-0 after:content-['']">
          {entry.data.title}
        </a>
      </h3>
      <p class="mt-2 text-[15px] leading-relaxed" style="color: var(--fg-muted)">
        {entry.data.description}
      </p>
      {
        entry.data.tags.length > 0 && (
          <p class="mt-3 flex flex-wrap gap-2 font-mono text-[11.5px]" style="color: var(--fg-muted)">
            {entry.data.tags.map((tag) => (
              <span>#{tag}</span>
            ))}
          </p>
        )
      }
    </div>
  </div>
</article>
