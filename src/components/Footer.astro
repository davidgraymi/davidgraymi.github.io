---
import { site, socials } from '~/site.config';
import { visibleNav } from '~/lib/nav';
import Icon from './Icon.astro';

const nav = await visibleNav();
const year = new Date().getFullYear();
---

<footer
  class="mt-24 border-t"
  style="border-color: var(--md-sys-color-outline-variant); background: var(--md-sys-color-surface-container-low)"
>
  <div class="wrap grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="text-[16px] font-semibold tracking-tight" style="color: var(--md-sys-color-on-surface);">{site.name}</p>
      <p class="mt-2 max-w-xs text-[14.5px] leading-relaxed" style="color: var(--md-sys-color-on-surface-variant)">
        {site.role}. Based in {site.location}.
      </p>
      <a href={`mailto:${site.email}`} class="link-underline mt-4 inline-block font-mono text-[13.5px]">
        {site.email}
      </a>
    </div>

    <nav aria-label="Footer">
      <p class="kicker">Pages</p>
      <ul class="mt-3 space-y-0.5 text-[14.5px]">
        <li><a href="/" class="inline-block py-1.5 transition-colors hover:text-[var(--md-sys-color-primary)]" style="color: var(--md-sys-color-on-surface-variant)">Home</a></li>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="inline-block py-1.5 transition-colors hover:text-[var(--md-sys-color-primary)]" style="color: var(--md-sys-color-on-surface-variant)">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <p class="kicker">Elsewhere</p>
      <ul class="mt-3 space-y-0.5 text-[14.5px]">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                class="inline-flex items-center gap-2.5 py-1.5 transition-colors hover:text-[var(--md-sys-color-primary)]"
                style="color: var(--md-sys-color-on-surface-variant)"
                rel={s.href.startsWith('http') ? 'me noopener' : undefined}
              >
                <Icon name={s.icon} size={15} />
                {s.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/rss.xml" class="inline-flex items-center gap-2.5 py-1.5 transition-colors hover:text-[var(--md-sys-color-primary)]" style="color: var(--md-sys-color-on-surface-variant)">
            <Icon name="rss" size={15} />
            RSS Feed
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t" style="border-color: var(--md-sys-color-outline-variant);">
    <div class="wrap flex flex-col gap-2.5 py-6 font-mono text-[12px] sm:flex-row sm:items-center sm:justify-between" style="color: var(--md-sys-color-on-surface-variant)">
      <p>© {year} {site.name} · Material 3 Expressive system</p>
      <button
        type="button"
        onclick="if(window.openCommandPalette) window.openCommandPalette()"
        class="inline-flex items-center gap-1.5 transition-colors hover:text-[var(--md-sys-color-primary)] text-left cursor-pointer"
      >
        <span>Press <kbd data-shortcut class="rounded-md border px-1.5 py-0.5 text-[12px]" style="border-color: var(--md-sys-color-outline-variant); background: var(--md-sys-color-surface-container);">⌘K</kbd> to search</span>
      </button>
    </div>
  </div>
</footer>
