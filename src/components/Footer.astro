---
import { nav, site, socials } from '~/site.config';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t" style="border-color: var(--rule); background: var(--bg-surface)">
  <div class="wrap grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="text-[15.5px] font-semibold tracking-tight">{site.name}</p>
      <p class="mt-2 max-w-xs text-[14.5px] leading-relaxed" style="color: var(--fg-muted)">
        {site.role}. Based in {site.location}.
      </p>
      <a href={`mailto:${site.email}`} class="link-underline mt-4 inline-block font-mono text-[13.5px]">
        {site.email}
      </a>
    </div>

    <nav aria-label="Footer">
      <p class="kicker">Pages</p>
      <ul class="mt-4 space-y-2.5 text-[14.5px]">
        <li><a href="/" class="transition-colors hover:text-[var(--signal)]" style="color: var(--fg-muted)">Home</a></li>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="transition-colors hover:text-[var(--signal)]" style="color: var(--fg-muted)">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <p class="kicker">Elsewhere</p>
      <ul class="mt-4 space-y-2.5 text-[14.5px]">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                class="inline-flex items-center gap-2.5 transition-colors hover:text-[var(--signal)]"
                style="color: var(--fg-muted)"
                rel={s.href.startsWith('http') ? 'me noopener' : undefined}
              >
                <Icon name={s.icon} size={15} />
                {s.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/rss.xml" class="inline-flex items-center gap-2.5 transition-colors hover:text-[var(--signal)]" style="color: var(--fg-muted)">
            <Icon name="rss" size={15} />
            RSS Feed
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t" style="border-color: var(--rule);">
    <div class="wrap flex flex-col gap-2 py-5 font-mono text-[12px] sm:flex-row sm:items-center sm:justify-between" style="color: var(--fg-muted)">
      <p>© {year} {site.name} · Cyber-minimalist design</p>
      <button
        type="button"
        onclick="if(window.openCommandPalette) window.openCommandPalette()"
        class="inline-flex items-center gap-1.5 transition-colors hover:text-[var(--signal)] text-left"
      >
        <span>Press <kbd class="rounded border px-1.5 py-0.5 text-[10px]" style="border-color: var(--rule); background: var(--bg-surface-2);">⌘K</kbd> for command menu</span>
      </button>
    </div>
  </div>
</footer>
