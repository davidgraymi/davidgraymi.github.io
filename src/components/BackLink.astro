---
import Icon from './Icon.astro';

interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---

<a
  href={href}
  class="group -ml-1 inline-flex min-h-11 items-center gap-0.5 text-[0.9375rem] font-medium text-primary transition-opacity duration-200 hover:opacity-75"
>
  <span class="transition-transform duration-200 group-hover:-translate-x-0.5"><Icon name="chevronLeft" size={18} /></span>
  {label}
</a>
