---
import Icon from './Icon.astro';
---

<button
  id="theme-toggle"
  type="button"
  class="theme-btn grid h-11 w-11 place-items-center border border-outline-variant bg-surface text-on-surface-variant transition-colors duration-150 md:h-9 md:w-9"
  aria-label="Switch between light and dark"
  title="Switch between light and dark"
>
  <span class="icon-when-dark transition-transform duration-300 hover:rotate-45"><Icon name="sun" size={15} /></span>
  <span class="icon-when-light transition-transform duration-300 hover:-rotate-12"><Icon name="moon" size={15} /></span>
</button>

<style>
  .theme-btn:hover {
    border-color: var(--md-sys-color-outline);
    color: var(--md-sys-color-on-surface);
  }

  /* Show the destination, not the current state: dark page offers the sun. */
  .icon-when-dark { display: none; }
  .icon-when-light { display: block; }

  :global(:root[data-theme='dark']) .icon-when-dark { display: block; }
  :global(:root[data-theme='dark']) .icon-when-light { display: none; }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-when-dark { display: block; }
    :global(:root:not([data-theme='light'])) .icon-when-light { display: none; }
  }
</style>

<script>
  const root = document.documentElement;
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const current = root.dataset.theme ?? (systemDark ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* private mode: the choice just won't persist */
    }
  });
</script>
