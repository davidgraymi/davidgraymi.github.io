---
import BaseHead from '~/components/BaseHead.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import AuroraBackground from '~/components/AuroraBackground.astro';
import CommandPalette from '~/components/CommandPalette.astro';
import KonamiCode from '~/components/KonamiCode.astro';
import '~/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...props} />
    <script is:inline>
      // Runs before first paint so the chosen theme never flashes.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.dataset.theme = saved;
        }
      } catch (e) {}
      // Keep the browser chrome in step with a pinned theme (the toggle sets data-theme).
      const syncThemeColor = () => {
        const pinned = document.documentElement.dataset.theme;
        document.querySelectorAll('meta[name="theme-color"]').forEach((m) => {
          m.dataset.media ??= m.media;
          m.media = pinned ? (m.dataset.media.includes(pinned) ? 'all' : 'not all') : m.dataset.media;
        });
      };
      new MutationObserver(syncThemeColor).observe(document.documentElement, { attributeFilter: ['data-theme'] });
      syncThemeColor();
    </script>
    <KonamiCode />
  </head>
  <body class="relative flex min-h-dvh flex-col">
    <AuroraBackground />
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:px-5 focus:py-2.5 font-medium shadow-elevation-3 bg-primary text-on-primary"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <CommandPalette />

  </body>
</html>
