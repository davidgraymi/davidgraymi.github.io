---
import BaseHead from '~/components/BaseHead.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import AuroraBackground from '~/components/AuroraBackground.astro';
import CommandPalette from '~/components/CommandPalette.astro';
import '~/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}
const props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...props} />
    <script is:inline>
      // Runs before first paint so the chosen theme never flashes.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.dataset.theme = saved;
        }
      } catch (e) {}
    </script>
  </head>
  <body class="relative flex min-h-dvh flex-col">
    <AuroraBackground />
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:px-4 focus:py-2"
      style="background: var(--signal); color: var(--signal-contrast)"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <CommandPalette />

    <script>
      // High-performance pointer tracking for Linear-style spotlight cards
      function initSpotlights() {
        document.querySelectorAll('.spotlight-card').forEach((card) => {
          if ((card as any).__hasSpotlight) return;
          (card as any).__hasSpotlight = true;
          card.addEventListener('pointermove', (e) => {
            const rect = (card as HTMLElement).getBoundingClientRect();
            (card as HTMLElement).style.setProperty('--mouse-x', `${(e as PointerEvent).clientX - rect.left}px`);
            (card as HTMLElement).style.setProperty('--mouse-y', `${(e as PointerEvent).clientY - rect.top}px`);
          });
        });
      }

      initSpotlights();
      document.addEventListener('astro:page-load', initSpotlights);
    </script>
  </body>
</html>
