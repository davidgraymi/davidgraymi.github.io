---
/**
 * The full-screen game player. Nothing on screen but a slim bar and the game:
 * no site header, footer, command palette, terminal or Konami listener (their
 * shortcuts would fight the game's). The page itself never scrolls. A game
 * taller than the screen scrolls inside the stage, and the keys a game uses
 * (arrows, Space, Page Up/Down) are kept from scrolling it.
 */
import BaseHead from '~/components/BaseHead.astro';
import ThemeInit from '~/components/ThemeInit.astro';
import ThemeToggle from '~/components/ThemeToggle.astro';
import Icon from '~/components/Icon.astro';
import type { Game } from '~/data/games';
import '~/styles/global.css';

interface Props {
  game: Game;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { game, jsonLd } = Astro.props;

const widths: Record<Game['width'], string> = {
  sm: 'max-w-lg',
  md: 'max-w-3xl',
  lg: 'max-w-4xl',
  xl: 'max-w-6xl',
};
---

<!doctype html>
<html lang="en" class="play-shell">
  <head>
    <BaseHead title={game.title} description={game.blurb} image={`/og/play/${game.slug}.png`} jsonLd={jsonLd} />
    <ThemeInit />
  </head>
  <body class="g-root flex h-dvh flex-col overflow-hidden bg-surface">
    <header class="play-bar g-veil relative z-10 grid h-14 shrink-0 grid-cols-[1fr_auto_1fr] items-center gap-2 px-3 md:h-13 md:px-4">
      <a href="/play" class="play-back justify-self-start" aria-label="All games" title="All games">
        <Icon name="chevronLeft" size={20} />
        <span class="max-sm:sr-only">Games</span>
      </a>
      <div class="min-w-0 text-center leading-tight">
        <h1 class="truncate text-[0.9375rem] font-semibold tracking-[-0.01em] text-on-surface">{game.title}</h1>
        <p class="truncate text-[0.75rem] text-on-surface-variant max-sm:hidden">vs. {game.opponent}</p>
      </div>
      <div class="flex items-center gap-2 justify-self-end">
        <button type="button" class="g-icon-btn" data-howto-open aria-label="How to play" title="How to play">
          <Icon name="info" size={17} />
        </button>
        <button type="button" class="g-icon-btn" data-fullscreen hidden aria-label="Full screen" title="Full screen">
          <span data-fs-enter><Icon name="expand" size={16} /></span>
          <span data-fs-exit hidden><Icon name="shrink" size={16} /></span>
        </button>
        <ThemeToggle />
      </div>
    </header>

    <main id="main" class="play-stage flex-1 overflow-y-auto overscroll-contain">
      <div class="grid min-h-full place-items-center px-3 py-6 sm:px-6 sm:py-10">
        <div class:list={['play-game g-appear w-full', widths[game.width]]}>
          <slot />
        </div>
      </div>
    </main>

    <dialog data-howto aria-labelledby="howto-eyebrow howto-title" class="play-sheet m-auto w-[92vw] max-w-md p-0 text-on-surface">
      <form method="dialog" class="absolute top-4 right-4">
        <button class="g-icon-btn" aria-label="Close">
          <Icon name="close" size={15} />
        </button>
      </form>
      <div class="px-7 pt-8 pb-7">
        <p id="howto-eyebrow" class="g-eyebrow">How to play</p>
        <h2 id="howto-title" class="mt-1 pr-10 text-[1.75rem] leading-tight font-semibold tracking-[-0.025em]">{game.title}</h2>
        <div class="mt-4 space-y-3 text-[0.9375rem] leading-relaxed text-on-surface-variant">
          {game.howTo.map((p) => <p>{p}</p>)}
        </div>
        <div class="mt-7 grid gap-2">
          <form method="dialog">
            <button class="g-btn g-btn-block" autofocus>
              <Icon name="play" size={13} />
              Play
            </button>
          </form>
          {
            game.story && (
              <a href={game.story.href} class="g-btn g-btn-plain g-btn-block">
                How it works
              </a>
            )
          }
        </div>
      </div>
    </dialog>
  </body>
</html>

<style is:global>
  /* No rubber-banding or pull-to-refresh while playing. */
  .play-shell,
  .play-shell body {
    overscroll-behavior: none;
  }
  /* Double-tap shouldn't zoom mid-game; pinch still works. */
  .play-stage {
    touch-action: manipulation;
  }
  /* Embedded games carry vertical margins for prose; the stage does its own spacing. */
  .play-game > * {
    margin-block: 0;
  }

  /* Toolbar: frosted, with a hairline only once the stage scrolls under it. */
  .play-bar {
    box-shadow: 0 0.5px 0 transparent;
    transition: box-shadow 220ms var(--g-ease);
  }
  .play-bar[data-scrolled] {
    box-shadow: 0 0.5px 0 var(--g-hair);
  }
  .play-back {
    display: inline-flex;
    align-items: center;
    gap: 0.1rem;
    min-width: 44px;
    min-height: 44px;
    padding-right: 0.5rem;
    margin-left: -0.35rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--md-sys-color-primary);
    transition: opacity 160ms var(--g-ease);
  }
  .play-back:hover {
    opacity: 0.75;
  }
  /* How to play: a sheet that rises and settles over a dimmed, blurred stage.
     Entry only: closing is instant, which also avoids top-layer exit quirks. */
  .play-sheet {
    position: fixed;
    overflow: visible;
    border-radius: 1.75rem;
    background: color-mix(in srgb, var(--md-sys-color-surface-container-low) 94%, transparent);
    -webkit-backdrop-filter: saturate(180%) blur(30px);
    backdrop-filter: saturate(180%) blur(30px);
    box-shadow:
      0 0 0 0.5px var(--g-hair),
      0 40px 80px -20px rgb(0 0 0 / 0.45),
      0 4px 12px rgb(0 0 0 / 0.1);
  }
  .play-sheet[open] {
    animation: play-sheet-in 460ms var(--g-ease) both;
  }
  .play-sheet[open]::backdrop {
    background: rgb(0 0 0 / 0.5);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    animation: play-fade-in 320ms var(--g-ease) both;
  }
  @keyframes play-sheet-in {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.96);
    }
  }
  @keyframes play-fade-in {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .play-sheet[open],
    .play-sheet[open]::backdrop {
      animation: none;
    }
  }
</style>

<script>
  // ---- How to play: shown on the first visit to each game, then on demand ----
  const howto = document.querySelector<HTMLDialogElement>('[data-howto]')!;
  document.querySelector('[data-howto-open]')!.addEventListener('click', () => howto.showModal());
  // Opened on load, the sheet has no earlier focus to hand back, so focus would
  // stay on its (now hidden) Play button and the games' page-level keys would
  // ignore it. Hand focus back to the page instead.
  howto.addEventListener('close', () => {
    const el = document.activeElement as HTMLElement | null;
    if (el && howto.contains(el)) el.blur();
  });
  const seenKey = `play-seen:${location.pathname.replace(/\/$/, '')}`;
  try {
    if (!localStorage.getItem(seenKey)) {
      howto.showModal();
      localStorage.setItem(seenKey, '1');
    }
  } catch {
    /* storage blocked: skip the auto-open rather than show it every time */
  }

  // ---- Toolbar hairline once the stage scrolls under it ----
  const bar = document.querySelector<HTMLElement>('.play-bar')!;
  const stage = document.querySelector<HTMLElement>('.play-stage')!;
  stage.addEventListener('scroll', () => bar.toggleAttribute('data-scrolled', stage.scrollTop > 2), { passive: true });

  // ---- Full screen, where the browser allows it (not iPhone Safari) ----
  const fsBtn = document.querySelector<HTMLButtonElement>('[data-fullscreen]')!;
  if (document.fullscreenEnabled) {
    fsBtn.hidden = false;
    const sync = () => {
      const on = !!document.fullscreenElement;
      fsBtn.querySelector<HTMLElement>('[data-fs-enter]')!.hidden = on;
      fsBtn.querySelector<HTMLElement>('[data-fs-exit]')!.hidden = !on;
      fsBtn.setAttribute('aria-label', on ? 'Exit full screen' : 'Full screen');
      fsBtn.title = fsBtn.getAttribute('aria-label')!;
    };
    fsBtn.addEventListener('click', () => {
      if (document.fullscreenElement) void document.exitFullscreen();
      else void document.documentElement.requestFullscreen().catch(() => {});
    });
    document.addEventListener('fullscreenchange', sync);
  }

  // ---- Keep game keys from scrolling the stage ----
  // Registered after `load` so it runs after every game's own window listener
  // (the games check `defaultPrevented` and would otherwise ignore the key).
  const SCROLL_KEYS = new Set(['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', ' ', 'PageUp', 'PageDown', 'Home', 'End']);
  const guard = (e: KeyboardEvent) => {
    if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.altKey || !SCROLL_KEYS.has(e.key)) return;
    const t = e.target as HTMLElement | null;
    // Form fields (the k slider, text inputs) and open dialogs keep their keys.
    if (t?.closest('input, textarea, select, [contenteditable], dialog')) return;
    // Space activates a focused button or link; leave that alone.
    if (e.key === ' ' && t?.closest('button, a, summary, [role="button"]')) return;
    e.preventDefault();
  };
  const arm = () => window.addEventListener('keydown', guard);
  if (document.readyState === 'complete') setTimeout(arm);
  else window.addEventListener('load', arm, { once: true });
</script>
